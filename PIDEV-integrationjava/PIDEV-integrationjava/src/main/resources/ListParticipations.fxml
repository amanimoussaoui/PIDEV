<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="tn.esprit.controllers.ListParticipationController"
            stylesheets="ListParticipations.css">
    <!-- Left Sidebar -->
    <VBox fx:id="sidebar" alignment="TOP_LEFT" spacing="20" style="-fx-padding: 20;" prefWidth="200">
        <Label text="AgriWise" styleClass="sidebar-title"/>
        <Button fx:id="btnFormations" text="Liste des Formations" styleClass="sidebar-button" onAction="#redirectToFormations"/>

        <Button text="Liste des Participations" styleClass="sidebar-button"/>

    </VBox>

    <!-- TableView -->
    <TableView fx:id="participationTable" layoutX="10" layoutY="10" AnchorPane.leftAnchor="210" AnchorPane.topAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.bottomAnchor="10">
        <columns>
            <TableColumn fx:id="titreFormationCol" text="Formation" prefWidth="150"/>
            <TableColumn fx:id="nomUtilisateurCol" text="Utilisateur" prefWidth="150"/>
            <TableColumn fx:id="dateCol" text="Date de participation" prefWidth="150"/>
            <TableColumn fx:id="actionCol" text="Action" prefWidth="120"/>
        </columns>
    </TableView>
</AnchorPane>
