<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane fx:id="cardPane" prefHeight="200.0" prefWidth="200.0" styleClass="fruit-item" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.cardProducts">
   <children>
      <VBox alignment="CENTER" prefHeight="200.0" prefWidth="200.0">
         <children>
            <ImageView fx:id="productImage" fitHeight="102.0" fitWidth="130.0" pickOnBounds="true" preserveRatio="true" />
            <Label fx:id="productName" text="Nom Produit">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Label>
            <Label fx:id="productPrice" text="Prix">
               <font>
                  <Font name="System" size="12.0" />
               </font>
            </Label>
         </children>
      </VBox>
   </children>
</AnchorPane>
