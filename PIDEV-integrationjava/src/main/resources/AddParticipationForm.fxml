<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.AddParticipationController"
            stylesheets="AddParticipation.css"
            prefWidth="400" prefHeight="300">

    <VBox alignment="CENTER" spacing="20" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"
          AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0">

        <Label text="Participer à une Formation" style="-fx-font-size: 18; -fx-font-weight: bold;"/>

        <ComboBox fx:id="formationComboBox" promptText="Choisir une formation" prefWidth="250"/>

        <Button text="Ajouter" fx:id="ajouterBtn" onAction="#handleAjouterParticipation" />
    </VBox>
</AnchorPane>

