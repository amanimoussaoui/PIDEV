<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="549.0" prefWidth="825.0" style="-fx-background-color: linear-gradient(to bottom right, #e0f7fa, #ffffff);" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.Dashboard">

    <children>

        <!-- User Table -->
        <TableView fx:id="tbuserlist" layoutX="116.0" layoutY="192.0" prefHeight="335.0" prefWidth="694.0" style="-fx-font-size: 13px; -fx-border-color: #90caf9; -fx-border-radius: 5;">
            <columns>
                <TableColumn fx:id="tbid" prefWidth="25.5999755859375" text="ID" />
                <TableColumn fx:id="tbnom" prefWidth="62.39996337890625" text="Nom" />
                <TableColumn fx:id="tbprenom" prefWidth="108.79997253417969" text="Prénom" />
                <TableColumn fx:id="tbemail" prefWidth="136.79998779296875" text="Email" />
                <TableColumn fx:id="tbrole" prefWidth="236.79998779296875" text="Rôle" />
                <TableColumn fx:id="tbdinscription" prefWidth="118.39990234375" text="Date d'inscription" />
            </columns>
        </TableView>

        <!-- Buttons -->
        <Button layoutX="26.0" layoutY="456.0" mnemonicParsing="false" onAction="#updateuser" style="-fx-background-color: #42a5f5; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Modifier" />

        <Button layoutX="23.0" layoutY="408.0" mnemonicParsing="false" onAction="#adduser" prefHeight="26.0" prefWidth="71.0" style="-fx-background-color: #66bb6a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Ajouter" />

        <Button layoutX="21.0" layoutY="495.0" mnemonicParsing="false" onAction="#deleteuser" style="-fx-background-color: #ef5350; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Supprimer" />
      <Button fx:id="btnmainmenu" layoutX="12.0" layoutY="360.0" mnemonicParsing="false" onAction="#redirecttomenu" prefHeight="26.0" prefWidth="93.0" text="Menu" />
      <Button fx:id="btnrecherche" layoutX="381.0" layoutY="148.0" mnemonicParsing="false" onAction="#rechercheutilisateur" prefHeight="26.0" prefWidth="76.0" text="Rechercher" />
      <TextField fx:id="recherchetextfield" layoutX="463.0" layoutY="149.0" prefHeight="26.0" prefWidth="342.0" promptText="Chercher...." />
      <Button fx:id="btnexcel" layoutX="303.0" layoutY="148.0" mnemonicParsing="false" onAction="#importtoexcel" prefHeight="26.0" prefWidth="66.0" text="Excel" />

    </children>
</AnchorPane>
