<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="549.0" prefWidth="825.0"
            style="-fx-background-color: linear-gradient(to bottom right, #f5f7fa, #e4e8f0);"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.Dashboard">

    <!-- Header Section -->
    <Label layoutX="24.0" layoutY="24.0" text="Admin Dashboard"
           style="-fx-text-fill: #263238; -fx-font-weight: bold; -fx-font-size: 24;">
        <font>
            <Font size="24.0" />
        </font>
    </Label>

    <Line endX="775.0" layoutX="24.0" layoutY="70.0" startX="24.0"
          stroke="#cfd8dc" strokeWidth="1.5" />

    <!-- User Management Section -->
    <Label layoutX="24.0" layoutY="94.0" text="Gestion des Utilisateurs"
           style="-fx-text-fill: #37474f; -fx-font-weight: bold; -fx-font-size: 18;">
        <font>
            <Font size="18.0" />
        </font>
    </Label>

    <!-- Stats Cards -->
    <AnchorPane layoutX="24.0" layoutY="124.0" prefHeight="50.0" prefWidth="775.0"
                style="-fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
        <children>
            <Label fx:id="totalUsersLabel" layoutX="20.0" layoutY="15.0"
                   style="-fx-text-fill: #455a64; -fx-font-weight: bold;" />
            <Label layoutX="180.0" layoutY="15.0" text="Admins: 12"
                   style="-fx-text-fill: #455a64; -fx-font-weight: bold;" />
            <Label  fx:id="adminUsersLabel" layoutX="300.0" layoutY="15.0"
                   style="-fx-text-fill: #455a64; -fx-font-weight: bold;" />
        </children>
    </AnchorPane>

    <!-- Search and Actions -->
    <Label layoutX="24.0" layoutY="192.0" text="Liste des Utilisateurs"
           style="-fx-text-fill: #455a64; -fx-font-weight: bold; -fx-font-size: 14;">
        <font>
            <Font size="14.0" />
        </font>
    </Label>

    <!-- User Table -->
    <TableView fx:id="tbuserlist" layoutX="24.0" layoutY="220.0" prefHeight="260.0" prefWidth="775.0"
               style="-fx-background-color: white;
                      -fx-border-color: #cfd8dc;
                      -fx-border-radius: 5;
                      -fx-background-radius: 5;
                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 5, 0, 0, 1);">
        <columns>
            <TableColumn fx:id="tbid" prefWidth="50" text="ID"
                         style="-fx-alignment: CENTER; -fx-background-color: #37474f; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13;" />
            <TableColumn fx:id="tbnom" prefWidth="100" text="Nom"
                         style="-fx-background-color: #37474f; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13;" />
            <TableColumn fx:id="tbprenom" prefWidth="120" text="Prénom"
                         style="-fx-background-color: #37474f; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13;" />
            <TableColumn fx:id="tbemail" prefWidth="180" text="Email"
                         style="-fx-background-color: #37474f; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13;" />
            <TableColumn fx:id="tbrole" prefWidth="150" text="Rôle"
                         style="-fx-background-color: #37474f; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13;" />
            <TableColumn fx:id="tbdinscription" prefWidth="150" text="Date d'inscription"
                         style="-fx-background-color: #37474f; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13;" />
        </columns>
    </TableView>

    <!-- Search Field -->
    <TextField fx:id="recherchetextfield" layoutX="500.0" layoutY="190.0"
               onAction="#rechercheutilisateur" prefHeight="26.0" prefWidth="250.0"
               promptText="Rechercher utilisateur..."
               style="-fx-background-color: white;
                      -fx-border-color: #b0bec5;
                      -fx-border-radius: 15;
                      -fx-background-radius: 15;
                      -fx-padding: 0 10 0 10;
                      -fx-font-size: 13;
                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 3, 0, 0, 1);"/>

    <!-- Action Buttons -->
    <Button layoutX="24.0" layoutY="490.0" mnemonicParsing="false" onAction="#adduser"
            text="Ajouter"
            style="-fx-background-radius: 20;
                   -fx-border-radius: 20;
                   -fx-font-weight: bold;
                   -fx-font-size: 13;
                   -fx-padding: 8 15 8 15;
                   -fx-cursor: hand;
                   -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 3, 0, 0, 1);
                   -fx-text-fill: white;
                   -fx-min-width: 80;
                   -fx-background-color: #66bb6a;"/>

    <Button layoutX="110.0" layoutY="490.0" mnemonicParsing="false" onAction="#updateuser"
            text="Modifier"
            style="-fx-background-radius: 20;
                   -fx-border-radius: 20;
                   -fx-font-weight: bold;
                   -fx-font-size: 13;
                   -fx-padding: 8 15 8 15;
                   -fx-cursor: hand;
                   -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 3, 0, 0, 1);
                   -fx-text-fill: white;
                   -fx-min-width: 80;
                   -fx-background-color: #42a5f5;"/>

    <Button layoutX="200.0" layoutY="490.0" mnemonicParsing="false" onAction="#deleteuser"
            text="Supprimer"
            style="-fx-background-radius: 20;
                   -fx-border-radius: 20;
                   -fx-font-weight: bold;
                   -fx-font-size: 13;
                   -fx-padding: 8 15 8 15;
                   -fx-cursor: hand;
                   -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 3, 0, 0, 1);
                   -fx-text-fill: white;
                   -fx-min-width: 80;
                   -fx-background-color: #ef5350;"/>

    <Button fx:id="btnexcel" layoutX="300.0" layoutY="490.0" mnemonicParsing="false"
            onAction="#importtoexcel" text="Exporter Excel"
            style="-fx-background-radius: 20;
                   -fx-border-radius: 20;
                   -fx-font-weight: bold;
                   -fx-font-size: 13;
                   -fx-padding: 8 15 8 15;
                   -fx-cursor: hand;
                   -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 3, 0, 0, 1);
                   -fx-text-fill: white;
                   -fx-min-width: 80;
                   -fx-background-color: #4caf50;"/>

    <Button fx:id="btnmainmenu" layoutX="420.0" layoutY="490.0" mnemonicParsing="false"
            onAction="#redirecttomenu" text="Menu Principal"
            style="-fx-background-radius: 20;
                   -fx-border-radius: 20;
                   -fx-font-weight: bold;
                   -fx-font-size: 13;
                   -fx-padding: 8 15 8 15;
                   -fx-cursor: hand;
                   -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 3, 0, 0, 1);
                   -fx-text-fill: white;
                   -fx-min-width: 80;
                   -fx-background-color: #78909c;"/>
</AnchorPane>