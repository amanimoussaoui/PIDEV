<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml" xmlns="http://javafx.com/javafx/21"
            fx:controller="tn.esprit.controllers.FormationDetailsController"
            stylesheets="@formationdetails.css">

    <top>
        <HBox alignment="CENTER_LEFT" style="-fx-padding: 20;">
            <Label text="AgriWise" style="-fx-font-size: 32px; -fx-text-fill: #28a745; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <center>
        <VBox style="-fx-padding: 30;">
            <!-- Carte principale -->
            <StackPane style="-fx-background-color: white; -fx-background-radius: 12px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 20, 0, 0, 0); -fx-max-width: 1200px;">
                <VBox style="-fx-padding: 30px; -fx-spacing: 30px;">
                    <HBox spacing="30">
                        <!-- Image de la formation -->
                        <StackPane style="-fx-alignment: center; -fx-spacing: 10px;">
                            <ImageView fx:id="imageView" style="-fx-fit-width: 350px; -fx-fit-height: 250px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 10, 0, 0, 5);"/>
                            <Label text="Image de formation" style="-fx-font-size: 14px; -fx-text-fill: #666; -fx-font-style: italic;"/>
                        </StackPane>

                        <!-- Informations principales -->
                        <VBox spacing="15">
                            <Label fx:id="titleLabel" style="-fx-font-size: 28px; -fx-text-fill: #2e7d32; -fx-font-weight: bold; -fx-wrap-text: true;"/>

                            <VBox spacing="8" style="-fx-padding: 15px; -fx-background-color: #f9f9f9; -fx-background-radius: 8px; -fx-border-color: #e0e0e0; -fx-border-width: 1px; -fx-border-radius: 8px;">
                                <HBox spacing="10">
                                    <Label text="Description:" style="-fx-font-size: 16px; -fx-text-fill: #2e7d32; -fx-font-weight: bold; -fx-min-width: 100px;"/>
                                    <Label fx:id="descriptionLabel" style="-fx-font-size: 16px; -fx-text-fill: #333; -fx-font-weight: normal;" wrapText="true"/>
                                </HBox>

                                <HBox spacing="10">
                                    <Label text="Date:" style="-fx-font-size: 16px; -fx-text-fill: #2e7d32; -fx-font-weight: bold; -fx-min-width: 100px;"/>
                                    <Label fx:id="dateLabel" style="-fx-font-size: 16px; -fx-text-fill: #333; -fx-font-weight: normal;"/>
                                </HBox>

                                <HBox spacing="10">
                                    <Label text="Prix:" style="-fx-font-size: 16px; -fx-text-fill: #2e7d32; -fx-font-weight: bold; -fx-min-width: 100px;"/>
                                    <Label fx:id="prixLabel" style="-fx-font-size: 16px; -fx-text-fill: #333; -fx-font-weight: normal;"/>
                                </HBox>
                            </VBox>

                            <HBox spacing="15" style="-fx-padding: 20px 0 0 0;">
                                <Button text="Retour à la liste" onAction="#retourALaListe" style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10px 25px; -fx-background-radius: 6px;"/>
                                <Button fx:id="changeCurrencyButton" text="Changer devise" onAction="#onChangeCurrencyClicked" style="-fx-background-color: #388e3c; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10px 25px; -fx-background-radius: 6px;"/>
                            </HBox>
                        </VBox>
                    </HBox>

                    <!-- Section "Pourquoi choisir AgriWise" -->
                    <VBox spacing="15" style="-fx-padding: 20px 0 0 0;">
                        <Label text="Pourquoi choisir les formations AgriWise ?" style="-fx-font-size: 22px; -fx-text-fill: #2e7d32; -fx-font-weight: bold; -fx-padding: 0 0 10px 0;"/>

                        <TextFlow style="-fx-padding: 15px; -fx-background-color: #f9f9f9; -fx-background-radius: 8px; -fx-border-color: #e0e0e0; -fx-border-width: 1px; -fx-border-radius: 8px;">
                            <Text text="Les formations proposées par AgriWise sont conçues pour répondre aux besoins spécifiques des agriculteurs et des professionnels du secteur agricole. Grâce à une approche pratique et des contenus adaptés aux réalités du terrain, chaque formation vous permet de renforcer vos compétences et d'améliorer vos pratiques agricoles.\n\n"
                                  style="-fx-font-size: 15px; -fx-line-spacing: 1.5em; -fx-fill: #444;"/>
                            <Text text="Nos formations couvrent des domaines variés tels que la gestion des cultures, l'agriculture durable, la technologie agricole et bien plus encore. Elles sont animées par des experts du secteur et offrent une combinaison idéale de théorie et d'applications pratiques.\n\n"
                                  style="-fx-font-size: 15px; -fx-line-spacing: 1.5em; -fx-fill: #444;"/>
                            <Text text="En choisissant AgriWise, vous bénéficiez non seulement d'un apprentissage de qualité, mais aussi de la possibilité de recevoir un certificat de participation, attestant de vos nouvelles compétences acquises."
                                  style="-fx-font-size: 15px; -fx-line-spacing: 1.5em; -fx-fill: #444;"/>
                        </TextFlow>
                    </VBox>
                </VBox>
            </StackPane>
        </VBox>
    </center>
</BorderPane>