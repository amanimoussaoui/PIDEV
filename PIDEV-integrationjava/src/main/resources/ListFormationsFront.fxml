<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.ListFormationsFrontController"
            stylesheets="formationsFront.css">

    <!-- Left Sidebar -->
    <left>
        <VBox spacing="15" style="-fx-padding: 20;">
            <Label text="AgriWise" styleClass="sidebar-title" />
            <Button text="Vue Tableau" styleClass="sidebar-button" onAction="#switchToTableView"/>
            <Button text="Liste des Formations" styleClass="sidebar-button"/>
            <Button text="Liste des Participations" styleClass="sidebar-button"/>
        </VBox>
    </left>

    <!-- Center Content -->
    <center>
        <VBox spacing="20" style="-fx-padding: 20;">
            <HBox alignment="CENTER" spacing="10">
                <TextField promptText="Rechercher une formation..." styleClass="search-field"
                           fx:id="searchField"/>

                <Button fx:id="changeCurrencyButton" text="Changer devise" onAction="#onChangeCurrencyClicked"
                        style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold;"/>

            </HBox>

            <Label text="Nos Formations" styleClass="section-title"/>

            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
                <FlowPane fx:id="cardsContainer" hgap="20" vgap="20"
                          alignment="TOP_CENTER" prefWrapLength="1200"/>
            </ScrollPane>
            <HBox alignment="CENTER" spacing="10" styleClass="pagination">
                <Button fx:id="previousPageButton" text="Précédent" />
                <Label fx:id="currentPageLabel" text="1" />
                <Label fx:id="totalPagesLabel" text="1" />
                <Button fx:id="nextPageButton" text="Suivant" />
            </HBox>
        </VBox>
    </center>
</BorderPane>