<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.collections.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="800.0" prefWidth="1100.0" style="-fx-background-color: #F5F5F5;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.ProductDetailsController_client">
    <children>
        <VBox alignment="CENTER" prefHeight="800.0" prefWidth="1100.0" spacing="20.0">
            <!-- Header with back button and language selector -->
            <HBox alignment="CENTER_LEFT" prefHeight="60.0" prefWidth="1100.0" spacing="20.0" style="-fx-padding: 10 20 10 20;">
                <children>
                    <Button fx:id="backButton" onAction="#returnToMarket" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 8 16; -fx-background-radius: 8;">
                        <graphic>
                            <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                                <image>
                                    <Image url="@/images/back_arrow.png" />
                                </image>
                            </ImageView>
                        </graphic>
                        <text>Retour</text>
                        <HBox.margin>
                            <Insets left="20.0" />
                        </HBox.margin>
                    </Button>
                    <ComboBox fx:id="languageSelector" onAction="#translateInterface" prefWidth="150.0" style="-fx-background-color: white; -fx-border-color: #666666; -fx-border-radius: 8; -fx-font-size: 14px;">
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="Français (fr)" />
                                <String fx:value="Anglais (en)" />
                                <String fx:value="Espagnol (es)" />
                                <String fx:value="Allemand (de)" />
                                <String fx:value="Italien (it)" />
                                <String fx:value="Arabe (ar)" />
                            </FXCollections>
                        </items>
                        <value>
                            <String fx:value="Français (fr)" />
                        </value>
                    </ComboBox>
                </children>
            </HBox>

            <!-- Product Name -->
            <Label fx:id="productNameLabel" text="Nom du Produit" style="-fx-font-family: 'Arial'; -fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #333333;">
                <VBox.margin>
                    <Insets bottom="10.0" />
                </VBox.margin>
            </Label>

            <!-- Main Content (Image + Details) -->
            <HBox alignment="CENTER" prefHeight="400.0" prefWidth="1000.0" spacing="30.0" style="-fx-padding: 20; -fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 4);">
                <!-- Product Image -->
                <VBox alignment="CENTER" prefHeight="350.0" prefWidth="450.0">
                    <children>
                        <ImageView fx:id="productImage" fitHeight="300.0" fitWidth="300.0" pickOnBounds="true" preserveRatio="true">
                            <clip>
                                <javafx.scene.shape.Circle centerX="150" centerY="150" radius="150" />
                            </clip>
                        </ImageView>
                    </children>
                </VBox>

                <!-- Product Details -->
                <VBox alignment="TOP_LEFT" prefHeight="350.0" prefWidth="500.0" spacing="20.0">
                    <!-- Description -->
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <ImageView fitHeight="24.0" fitWidth="24.0">
                            <image>
                                <Image url="@images/info_icon.png" />
                            </image>
                        </ImageView>
                        <VBox spacing="8.0">
                            <Label fx:id="descriptionLabel" text="Description:" style="-fx-font-family: 'Arial'; -fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #666666;" />
                            <Label fx:id="descriptionValueLabel" wrapText="true" style="-fx-font-family: 'Arial'; -fx-font-size: 14px; -fx-text-fill: #333333; -fx-max-width: 400;" />
                        </VBox>
                    </HBox>
                    <!-- Price -->
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <ImageView fitHeight="24.0" fitWidth="24.0">
                            <image>
                                <Image url="@images/price_icon.png" />
                            </image>
                        </ImageView>
                        <VBox spacing="8.0">
                            <Label fx:id="priceLabel" text="Prix:" style="-fx-font-family: 'Arial'; -fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #666666;" />
                            <Label fx:id="priceValueLabel" style="-fx-font-family: 'Arial'; -fx-font-size: 14px; -fx-text-fill: #333333;" />
                        </VBox>
                        <ComboBox fx:id="currencySelector" onAction="#updateCurrency" prefWidth="150.0" style="-fx-background-color: white; -fx-border-color: #666666; -fx-border-radius: 8; -fx-font-size: 14px;">
                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <String fx:value="TND (Dinar Tunisien)" />
                                    <String fx:value="USD (Dollar Américain)" />
                                    <String fx:value="EUR (Euro)" />
                                    <String fx:value="GBP (Livre Sterling)" />
                                </FXCollections>
                            </items>
                            <value>
                                <String fx:value="TND (Dinar Tunisien)" />
                            </value>
                            <HBox.margin>
                                <Insets left="20.0" />
                            </HBox.margin>
                        </ComboBox>
                    </HBox>
                    <!-- Stock -->
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <ImageView fitHeight="24.0" fitWidth="24.0">
                            <image>
                                <Image url="@images/stock_icon.png" />
                            </image>
                        </ImageView>
                        <VBox spacing="8.0">
                            <Label fx:id="stockLabel" text="Stock:" style="-fx-font-family: 'Arial'; -fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #666666;" />
                            <Label fx:id="stockValueLabel" style="-fx-font-family: 'Arial'; -fx-font-size: 14px; -fx-text-fill: #333333;" />
                        </VBox>
                    </HBox>
                    <!-- Category -->
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <ImageView fitHeight="24.0" fitWidth="24.0">
                            <image>
                                <Image url="@images/category_icon.png" />
                            </image>
                        </ImageView>
                        <VBox spacing="8.0">
                            <Label fx:id="categoryLabel" text="Catégorie:" style="-fx-font-family: 'Arial'; -fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #666666;" />
                            <Label fx:id="categoryValueLabel" style="-fx-font-family: 'Arial'; -fx-font-size: 14px; -fx-text-fill: #333333;" />
                        </VBox>
                    </HBox>
                    <!-- Updated At -->
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <ImageView fitHeight="24.0" fitWidth="24.0">
                            <image>
                                <Image url="@images/date_icon.png" />
                            </image>
                        </ImageView>
                        <VBox spacing="8.0">
                            <Label fx:id="updatedAtLabel" text="Mis à jour:" style="-fx-font-family: 'Arial'; -fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #666666;" />
                            <Label fx:id="updatedAtValueLabel" style="-fx-font-family: 'Arial'; -fx-font-size: 14px; -fx-text-fill: #333333;" />
                        </VBox>
                    </HBox>
                </VBox>
            </HBox>

            <!-- Why AgriWise Section -->
            <VBox alignment="CENTER" prefWidth="1000.0" spacing="15.0" style="-fx-background-color: #E8F5E9; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 4);">
                <children>
                    <Label fx:id="agriwiseTitleLabel" text="🔎 Pourquoi choisir les produits AgriWise ?" style="-fx-font-family: 'Arial'; -fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #4CAF50;" />
                    <Label fx:id="agriwiseTextLabel" text="✅ AgriWise propose des produits agricoles innovants, durables et de haute qualité, adaptés aux besoins des professionnels, pour une agriculture efficace, écoresponsable et accompagnée par des experts" wrapText="true" style="-fx-font-family: 'Arial'; -fx-font-size: 14px; -fx-text-fill: #333333; -fx-max-width: 900;" />
                </children>
                <VBox.margin>
                    <Insets left="40.0" right="40.0" top="20.0" bottom="20.0" />
                </VBox.margin>
            </VBox>
        </VBox>
    </children>
</AnchorPane>