<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="700.0"
            style="-fx-background-color: linear-gradient(to bottom right, #f5f7fa, #e4e8f0);"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.ProfileScene">

   <!-- Header Section -->
   <Label layoutX="24.0" layoutY="24.0" text="Modification du Profil"
          style="-fx-text-fill: #263238; -fx-font-weight: bold; -fx-font-size: 20;">
      <font>
         <Font size="20.0" />
      </font>
   </Label>

   <Line endX="676.0" layoutX="24.0" layoutY="70.0" startX="24.0"
         stroke="#cfd8dc" strokeWidth="1.5" />

   <!-- Profile Picture Section -->
   <ImageView fx:id="profilepicture" fitHeight="180.0" fitWidth="220.0"
              layoutX="24.0" layoutY="90.0" onMouseClicked="#handleImageClick"
              pickOnBounds="true" preserveRatio="true"
              style="-fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 8, 0, 0, 2);
                      -fx-border-color: #b0bec5;
                      -fx-border-width: 2;
                      -fx-border-radius: 5;
                      -fx-background-radius: 5;"/>

   <!-- Profile Form Section -->
   <BorderPane layoutX="270.0" layoutY="90.0" prefHeight="320.0" prefWidth="400.0"
               style="-fx-background-color: white;
                       -fx-background-radius: 8;
                       -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
      <center>
         <AnchorPane prefHeight="300.0" prefWidth="380.0" style="-fx-padding: 20;">
            <children>
               <!-- Form Fields -->
               <Label layoutX="20.0" layoutY="30.0" text="Prénom"
                      style="-fx-text-fill: #37474f; -fx-font-weight: bold; -fx-font-size: 14;"/>
               <TextField fx:id="profileprenom" layoutX="120.0" layoutY="25.0" prefWidth="240.0"
                          style="-fx-background-color: white;
                                     -fx-border-color: #b0bec5;
                                     -fx-border-radius: 5;
                                     -fx-background-radius: 5;
                                     -fx-padding: 5 10 5 10;
                                     -fx-font-size: 14;"/>

               <Label layoutX="20.0" layoutY="80.0" text="Téléphone"
                      style="-fx-text-fill: #37474f; -fx-font-weight: bold; -fx-font-size: 14;"/>
               <TextField fx:id="telephoneprofile" layoutX="120.0" layoutY="75.0" prefWidth="240.0"
                          style="-fx-background-color: white;
                                     -fx-border-color: #b0bec5;
                                     -fx-border-radius: 5;
                                     -fx-background-radius: 5;
                                     -fx-padding: 5 10 5 10;
                                     -fx-font-size: 14;"/>

               <Label layoutX="20.0" layoutY="130.0" text="Adresse"
                      style="-fx-text-fill: #37474f; -fx-font-weight: bold; -fx-font-size: 14;"/>
               <TextField fx:id="adresseprofile" layoutX="120.0" layoutY="125.0" prefWidth="240.0"
                          style="-fx-background-color: white;
                                     -fx-border-color: #b0bec5;
                                     -fx-border-radius: 5;
                                     -fx-background-radius: 5;
                                     -fx-padding: 5 10 5 10;
                                     -fx-font-size: 14;"
                          onMouseClicked="#handleAdresseClick"/>

               <Label layoutX="20.0" layoutY="180.0" text="Date de naissance"
                      style="-fx-text-fill: #37474f; -fx-font-weight: bold; -fx-font-size: 14;"/>
               <DatePicker fx:id="calanderprofile" layoutX="120.0" layoutY="175.0" prefWidth="240.0"
                           style="-fx-background-color: white;
                                      -fx-border-color: #b0bec5;
                                      -fx-border-radius: 5;
                                      -fx-background-radius: 5;
                                      -fx-padding: 5 10 5 10;
                                      -fx-font-size: 14;"/>

               <Label layoutX="20.0" layoutY="230.0" text="Bio"
                      style="-fx-text-fill: #37474f; -fx-font-weight: bold; -fx-font-size: 14;"/>
               <TextField fx:id="bioprofile" layoutX="120.0" layoutY="225.0" prefWidth="240.0" prefHeight="80.0"
                          style="-fx-background-color: white;
                                     -fx-border-color: #b0bec5;
                                     -fx-border-radius: 5;
                                     -fx-background-radius: 5;
                                     -fx-padding: 5 10 5 10;
                                     -fx-font-size: 14;"/>

               <Label layoutX="20.0" layoutY="315.0" text="Âge"
                      style="-fx-text-fill: #37474f; -fx-font-weight: bold; -fx-font-size: 14;"/>
               <Label fx:id="ageshow" layoutX="120.0" layoutY="315.0"
                      style="-fx-text-fill: #455a64; -fx-font-size: 14;"/>
            </children>
         </AnchorPane>
      </center>
   </BorderPane>

   <!-- Action Buttons -->
   <Button fx:id="btnupdateprofile" layoutX="270.0" layoutY="430.0" mnemonicParsing="false"
           onAction="#updateprofile" text="Enregistrer les modifications"
           style="-fx-background-radius: 20;
                   -fx-border-radius: 20;
                   -fx-font-weight: bold;
                   -fx-font-size: 14;
                   -fx-padding: 8 20 8 20;
                   -fx-cursor: hand;
                   -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 3, 0, 0, 1);
                   -fx-text-fill: white;
                   -fx-background-color: #42a5f5;"/>
</AnchorPane>