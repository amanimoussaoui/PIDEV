<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #F5F5F5;" xmlns="http://javafx.com/javafx/21.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.CommandeDetailsController">
    <children>
        <VBox alignment="CENTER" prefHeight="600.0" prefWidth="900.0" spacing="20.0">
            <!-- Header with back button -->
            <HBox alignment="CENTER_LEFT" prefHeight="50.0" prefWidth="900.0" spacing="20.0" style="-fx-padding: 10 20 10 20;">
                <children>
                    <Button fx:id="backButton" onAction="#closeDetails" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 8 16; -fx-background-radius: 8;">
                        <graphic>
                            <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                                <image>
                                    <Image url="@/images/back_arrow.png" />
                                </image>
                            </ImageView>
                        </graphic>
                        <text>Retour</text>
                        <HBox.margin>
                            <Insets left="20.0" />
                        </HBox.margin>
                    </Button>
                </children>
            </HBox>

            <!-- Commande ID -->
            <Label fx:id="commandeIdLabel" text="Commande ID" style="-fx-font-family: 'Arial'; -fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #333333;">
                <VBox.margin>
                    <Insets bottom="15.0" />
                </VBox.margin>
            </Label>

            <!-- Main Content (Image + Details) -->
            <HBox alignment="CENTER" prefHeight="350.0" prefWidth="800.0" spacing="30.0" style="-fx-padding: 20; -fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 4);">
                <!-- Product Image -->
                <VBox alignment="CENTER" prefHeight="300.0" prefWidth="350.0">
                    <children>
                        <ImageView fx:id="productImage" fitHeight="200.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
                            <clip>
                                <javafx.scene.shape.Circle centerX="100" centerY="100" radius="100" />
                            </clip>
                        </ImageView>
                        <Label fx:id="imageCaptionLabel" text="Image du premier produit" wrapText="true" style="-fx-font-family: 'Arial'; -fx-font-size: 12px; -fx-font-style: italic; -fx-text-fill: #666666;">
                            <VBox.margin>
                                <Insets top="10.0" />
                            </VBox.margin>
                        </Label>
                    </children>
                </VBox>

                <!-- Commande Details -->
                <VBox alignment="TOP_LEFT" prefHeight="300.0" prefWidth="400.0" spacing="20.0">
                    <!-- Utilisateur -->
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <ImageView fitHeight="24.0" fitWidth="24.0">
                            <image>
                                <Image url="@/images/user_icon.png" />
                            </image>
                        </ImageView>
                        <VBox spacing="8.0">
                            <Label text="Utilisateur:" style="-fx-font-family: 'Arial'; -fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #666666;" />
                            <Label fx:id="userValueLabel" wrapText="true" style="-fx-font-family: 'Arial'; -fx-font-size: 14px; -fx-text-fill: #333333; -fx-max-width: 350;" />
                        </VBox>
                    </HBox>
                    <!-- Adresse -->
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <ImageView fitHeight="24.0" fitWidth="24.0">
                            <image>
                                <Image url="@/images/address_icon.png" />
                            </image>
                        </ImageView>
                        <VBox spacing="8.0">
                            <Label text="Adresse:" style="-fx-font-family: 'Arial'; -fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #666666;" />
                            <Label fx:id="adresseValueLabel" wrapText="true" prefWidth="350.0" style="-fx-font-family: 'Arial'; -fx-font-size: 14px; -fx-text-fill: #333333;" />
                        </VBox>
                    </HBox>
                    <!-- Date -->
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <ImageView fitHeight="24.0" fitWidth="24.0">
                            <image>
                                <Image url="@/images/date_icon.png" />
                            </image>
                        </ImageView>
                        <VBox spacing="8.0">
                            <Label text="Date:" style="-fx-font-family: 'Arial'; -fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #666666;" />
                            <Label fx:id="dateValueLabel" style="-fx-font-family: 'Arial'; -fx-font-size: 14px; -fx-text-fill: #333333;" />
                        </VBox>
                    </HBox>
                    <!-- Quantité totale -->
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <ImageView fitHeight="24.0" fitWidth="24.0">
                            <image>
                                <Image url="@/images/quantity_icon.png" />
                            </image>
                        </ImageView>
                        <VBox spacing="8.0">
                            <Label text="Quantité totale:" style="-fx-font-family: 'Arial'; -fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #666666;" />
                            <Label fx:id="quantiteValueLabel" style="-fx-font-family: 'Arial'; -fx-font-size: 14px; -fx-text-fill: #333333;" />
                        </VBox>
                    </HBox>
                    <!-- Total -->
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <ImageView fitHeight="24.0" fitWidth="24.0">
                            <image>
                                <Image url="@/images/total_icon.png" />
                            </image>
                        </ImageView>
                        <VBox spacing="8.0">
                            <Label text="Total:" style="-fx-font-family: 'Arial'; -fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #666666;" />
                            <Label fx:id="totalValueLabel" style="-fx-font-family: 'Arial'; -fx-font-size: 14px; -fx-text-fill: #333333;" />
                        </VBox>
                    </HBox>
                </VBox>
            </HBox>

            <!-- Products List Section -->
            <VBox alignment="CENTER" prefWidth="800.0" spacing="15.0" style="-fx-background-color: #E8F5E9; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 4);">
                <children>
                    <Label text="📦 Produits dans la commande" style="-fx-font-family: 'Arial'; -fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #4CAF50;" />
                    <ScrollPane fitToWidth="true" prefHeight="80.0" prefWidth="750.0" style="-fx-background-color: transparent; -fx-border-color: #666666; -fx-border-radius: 8;">
                        <content>
                            <VBox fx:id="productsList" spacing="5.0" style="-fx-padding: 5;">
                                <!-- Les produits seront ajoutés dynamiquement -->
                            </VBox>
                        </content>
                    </ScrollPane>
                </children>
                <VBox.margin>
                    <Insets left="30.0" right="30.0" top="15.0" bottom="15.0" />
                </VBox.margin>
            </VBox>
        </VBox>
    </children>
</AnchorPane>