<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="tn.esprit.controllers.MachineController"
      spacing="15" style="-fx-background-color: white;">
    
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    
    <!-- En-tête avec navigation -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <Button fx:id="backButton" text="Retour" onAction="#goToHome" 
                style="-fx-background-color: #f0f0f0; -fx-text-fill: #333333; -fx-cursor: hand;">
            <graphic>
                <Label text="←" style="-fx-font-weight: bold;"/>
            </graphic>
            <padding>
                <Insets top="5" right="10" bottom="5" left="10"/>
            </padding>
        </Button>
        
        <Label text="Liste des Machines" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2e8b57;">
            <font>
                <Font name="System Bold" size="20.0"/>
            </font>
        </Label>
        
        <Region HBox.hgrow="ALWAYS" />
        
        <TextField fx:id="searchField" promptText="Rechercher une machine..." prefWidth="250">
            <HBox.margin>
                <Insets right="10"/>
            </HBox.margin>
        </TextField>
        
        <Button text="Rechercher" onAction="#handleSearch" 
                style="-fx-background-color: #2e8b57; -fx-text-fill: white; -fx-cursor: hand;">
            <padding>
                <Insets top="5" right="10" bottom="5" left="10"/>
            </padding>
        </Button>
    </HBox>
    
    <Separator/>
    
    <!-- Table des machines -->
    <TableView fx:id="machineTable" VBox.vgrow="ALWAYS" 
               style="-fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-background-radius: 5;">
        <columns>
            <TableColumn fx:id="idCol" text="ID" prefWidth="50"/>
            <TableColumn fx:id="nomCol" text="Nom" prefWidth="140"/>
            <TableColumn fx:id="descCol" text="Description" prefWidth="200"/>
            <TableColumn fx:id="prixCol" text="Prix" prefWidth="80"/>
            <TableColumn fx:id="etatCol" text="État" prefWidth="80"/>
            <TableColumn fx:id="dispoCol" text="Disponibilité" prefWidth="100"/>
            <TableColumn fx:id="dateCol" text="Date Maintenance" prefWidth="140"/>
        </columns>
        <placeholder>
            <Label text="Aucune machine disponible" style="-fx-text-fill: #777777;"/>
        </placeholder>
    </TableView>
    
    <!-- Barre d'actions -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="addButton" text="Ajouter" onAction="#goToAddMachine" 
                style="-fx-background-color: #2e8b57; -fx-text-fill: white; -fx-cursor: hand;">
            <graphic>
                <Label text="+" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
            </graphic>
            <padding>
                <Insets top="5" right="15" bottom="5" left="15"/>
            </padding>
        </Button>
        
        <Button fx:id="refreshBtn" text="Actualiser" onAction="#handleRefresh" 
                style="-fx-background-color: #4caf50; -fx-text-fill: white; -fx-cursor: hand;">
            <padding>
                <Insets top="5" right="15" bottom="5" left="15"/>
            </padding>
        </Button>
        
        <Button fx:id="editBtn" text="Modifier" onAction="#handleEdit" 
                style="-fx-background-color: #2196f3; -fx-text-fill: white; -fx-cursor: hand;">
            <padding>
                <Insets top="5" right="15" bottom="5" left="15"/>
            </padding>
        </Button>
        
        <Button fx:id="deleteBtn" text="Supprimer" onAction="#handleDelete" 
                style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-cursor: hand;">
            <padding>
                <Insets top="5" right="15" bottom="5" left="15"/>
            </padding>
        </Button>
    </HBox>
</VBox> 