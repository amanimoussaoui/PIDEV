<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="tn.esprit.controllers.MaintenanceCalendarController"
      spacing="20" style="-fx-background-color: white;">
      
    <padding>
        <Insets top="20" right="30" bottom="20" left="30"/>
    </padding>
    
    <!-- En-tête -->
    <HBox alignment="CENTER_LEFT" spacing="20">
        <Button text="Retour" onAction="#goBack"
                style="-fx-background-color: #f0f0f0; -fx-text-fill: #333333; -fx-cursor: hand;">
            <padding>
                <Insets top="8" right="15" bottom="8" left="15"/>
            </padding>
        </Button>
        
        <Label text="Calendrier de Maintenance" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2e8b57;">
            <font>
                <Font name="System Bold" size="24.0"/>
            </font>
        </Label>
    </HBox>
    
    <!-- Sélecteur de mois/année -->
    <HBox spacing="10" alignment="CENTER">
        <Button text="&lt;" onAction="#previousMonth" 
                style="-fx-background-color: #f0f0f0; -fx-text-fill: #333333;"/>
        <Label fx:id="monthYearLabel" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        <Button text="&gt;" onAction="#nextMonth" 
                style="-fx-background-color: #f0f0f0; -fx-text-fill: #333333;"/>
    </HBox>
    
    <!-- Grille du calendrier -->
    <GridPane fx:id="calendarGrid" alignment="CENTER" hgap="5" vgap="5">
        <!-- Les jours de la semaine -->
        <Label text="Dim" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
        <Label text="Lun" GridPane.columnIndex="1" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
        <Label text="Mar" GridPane.columnIndex="2" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
        <Label text="Mer" GridPane.columnIndex="3" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
        <Label text="Jeu" GridPane.columnIndex="4" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
        <Label text="Ven" GridPane.columnIndex="5" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
        <Label text="Sam" GridPane.columnIndex="6" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
    </GridPane>
    
    <!-- Légende -->
    <HBox spacing="20" alignment="CENTER">
        <Label text="Légende:" style="-fx-font-weight: bold;"/>
        <HBox spacing="5" alignment="CENTER">
            <Region style="-fx-background-color: #ff4444; -fx-min-width: 20; -fx-min-height: 20;"/>
            <Label text="Date de maintenance"/>
        </HBox>
    </HBox>
    
    <!-- Détails de la maintenance -->
    <VBox fx:id="maintenanceDetailsBox" spacing="10" style="-fx-padding: 10; -fx-background-color: #f9f9f9;">
        <Label text="Maintenances du jour sélectionné:" style="-fx-font-weight: bold;"/>
        <ListView fx:id="maintenanceListView" VBox.vgrow="ALWAYS" prefHeight="150"/>
    </VBox>
    
</VBox> 