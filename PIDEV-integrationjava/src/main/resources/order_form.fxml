<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="600.0" prefWidth="500.0" style="-fx-background-color: #F5F5F5;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.orderFormController">
    <children>
        <VBox alignment="CENTER" prefHeight="600.0" prefWidth="500.0" spacing="20.0" style="-fx-padding: 20;">
            <!-- Back Button -->
            <HBox alignment="CENTER_LEFT" prefHeight="40.0" prefWidth="500.0">
                <children>
                    <Button fx:id="backButton" onAction="#returnToMarket" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-family: 'Arial'; -fx-font-size: 14px; -fx-padding: 8 16; -fx-background-radius: 8;">
                        <graphic>
                            <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                                <image>
                                    <Image url="@/images/back_arrow.png" />
                                </image>
                            </ImageView>
                        </graphic>
                        <text>Retour</text>
                        <HBox.margin>
                            <Insets left="10.0" />
                        </HBox.margin>
                    </Button>
                </children>
            </HBox>

            <!-- Title -->
            <Label text="Formulaire de Commande" style="-fx-font-family: 'Arial'; -fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #333333;">
                <VBox.margin>
                    <Insets bottom="10.0" />
                </VBox.margin>
            </Label>

            <!-- Form Card -->
            <VBox alignment="CENTER" prefWidth="400.0" spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 4);">
                <!-- Product Information -->
                <VBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label fx:id="productNameLabel" text="Produit: " style="-fx-font-family: 'Arial'; -fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #666666;" />
                    <Label fx:id="productPriceLabel" text="Prix unitaire: " style="-fx-font-family: 'Arial'; -fx-font-size: 14px; -fx-text-fill: #333333;" />
                </VBox>

                <!-- Form Fields -->
                <VBox alignment="CENTER" spacing="20.0">
                    <!-- Quantité -->
                    <HBox alignment="CENTER_LEFT" spacing="15.0">
                        <Label text="Quantité:" style="-fx-font-family: 'Arial'; -fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #666666; -fx-min-width: 120;" />
                        <TextField fx:id="quantityField" prefWidth="200.0" promptText="Entrez la quantité" style="-fx-background-color: white; -fx-border-color: #666666; -fx-border-radius: 8; -fx-font-family: 'Arial'; -fx-font-size: 14px;" />
                    </HBox>

                    <!-- Adresse -->
                    <HBox alignment="CENTER_LEFT" spacing="15.0">
                        <Label text="Adresse de livraison:" style="-fx-font-family: 'Arial'; -fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #666666; -fx-min-width: 120;" />
                        <TextField fx:id="addressField" prefWidth="170.0" promptText="Entrez votre adresse" style="-fx-background-color: white; -fx-border-color: #666666; -fx-border-radius: 8; -fx-font-family: 'Arial'; -fx-font-size: 14px;" />
                        <Button fx:id="mapButton" onAction="#handleAdresseClick" style="-fx-background-color: transparent; -fx-padding: 5;">
                            <graphic>
                                <ImageView fitHeight="24.0" fitWidth="24.0" preserveRatio="true">
                                    <image>
                                        <Image url="@/images/address_icon.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                    </HBox>

                    <!-- Date de livraison -->
                    <HBox alignment="CENTER_LEFT" spacing="15.0">
                        <Label text="Date de livraison:" style="-fx-font-family: 'Arial'; -fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #666666; -fx-min-width: 120;" />
                        <DatePicker fx:id="deliveryDatePicker" prefWidth="200.0" style="-fx-background-color: white; -fx-border-color: #666666; -fx-border-radius: 8; -fx-font-family: 'Arial'; -fx-font-size: 14px;" />
                    </HBox>

                    <!-- Confirm Button -->
                    <Button fx:id="confirmButton" onAction="#confirmOrder" text="Ajouter Au Panier" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-family: 'Arial'; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8;">
                        <VBox.margin>
                            <Insets top="10.0" />
                        </VBox.margin>
                    </Button>
                </VBox>
            </VBox>
        </VBox>
    </children>
</AnchorPane>