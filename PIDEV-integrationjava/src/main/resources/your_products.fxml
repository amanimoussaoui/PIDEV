<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="810.0" prefWidth="1315.0" styleClass="main-container" stylesheets="@mainFormDesign.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.YourProductsController">
    <children>
        <!-- Header Section -->
        <HBox layoutX="0.0" layoutY="0.0" prefHeight="60.0" prefWidth="1315.0" styleClass="header">
            <children>
                <!-- Back Button -->
                <Button fx:id="btn_back" onAction="#goBackToProductList" prefHeight="40.0" prefWidth="40.0" styleClass="btn-icon">
                    <graphic>
                        <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                            <image>
                                <Image url="@/images/back_arrow.png" />
                            </image>
                        </ImageView>
                    </graphic>
                    <HBox.margin>
                        <Insets left="15.0" top="10.0" />
                    </HBox.margin>
                </Button>
                <!-- Header Title -->
                <Label styleClass="header-title" text="Gestion de Vos Produits">
                    <HBox.margin>
                        <Insets left="20.0" top="10.0" />
                    </HBox.margin>
                </Label>
            </children>
        </HBox>

        <!-- Main Content -->
        <HBox layoutX="20.0" layoutY="80.0" prefHeight="710.0" prefWidth="1275.0" spacing="20.0">
            <!-- Left Section: Form to Add/Edit Product -->
            <AnchorPane prefHeight="710.0" prefWidth="400.0" styleClass="form-card">
                <children>
                    <VBox prefHeight="710.0" prefWidth="400.0" spacing="15.0">
                        <padding>
                            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                        </padding>                        <children>
                        <Label prefHeight="30.0" prefWidth="267.0" styleClass="section-title" text="Ajouter un Produit">
                            <opaqueInsets>
                                <Insets />
                            </opaqueInsets>
                            <padding>
                                <Insets left="75.0" />
                            </padding></Label>
                        <!-- Form Fields -->
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label prefWidth="80.0" styleClass="form-label" text="Nom :" />
                                <TextField fx:id="name" prefHeight="35.0" prefWidth="250.0" promptText="Nom du produit ..." styleClass="form-input" />
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label prefWidth="80.0" styleClass="form-label" text="Description :" />
                                <TextArea fx:id="description" prefHeight="100.0" prefWidth="250.0" promptText="Description ..." styleClass="form-input" />
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label prefWidth="80.0" styleClass="form-label" text="Prix (TND) :" />
                                <TextField fx:id="price" prefHeight="35.0" prefWidth="250.0" promptText="0" styleClass="form-input" />
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label prefWidth="80.0" styleClass="form-label" text="Stock :" />
                                <TextField fx:id="stock" prefHeight="35.0" prefWidth="250.0" promptText="0" styleClass="form-input" />
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label prefWidth="80.0" styleClass="form-label" text="Catégorie :" />
                                <ComboBox fx:id="category" prefHeight="35.0" prefWidth="250.0" promptText="Choisissez la catégorie ..." styleClass="form-input" />
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label prefWidth="80.0" styleClass="form-label" text="Image :" />
                                <Button fx:id="btn_import" onAction="#importImage" prefHeight="35.0" prefWidth="35.0" styleClass="btn-import">
                                    <graphic>
                                        <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                                            <image>
                                                <Image url="@/images/import.png" />
                                            </image>
                                        </ImageView>
                                    </graphic>
                                </Button>
                                <ImageView fx:id="product_imageView" fitHeight="100.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true" />
                            </children>
                        </HBox>
                        <!-- Action Buttons -->
                        <HBox alignment="CENTER" spacing="20.0">
                            <children>
                                <Button fx:id="btn_add" onAction="#addProduct" prefHeight="40.0" prefWidth="120.0" styleClass="btn-primary" text="Ajouter" />
                                <Button fx:id="btn_clear" onAction="#clearForm" prefHeight="40.0" prefWidth="120.0" styleClass="btn-secondary" text="Effacer" />
                            </children>
                        </HBox>
                    </children>
                        <padding>
                            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                        </padding>
                    </VBox>
                </children>
            </AnchorPane>

            <!-- Right Section: Product Grid -->
            <AnchorPane prefHeight="599.0" prefWidth="880.0" styleClass="grid-card">
                <children>
                    <VBox prefHeight="613.0" prefWidth="874.0" spacing="10.0">
                        <children>
                            <Label prefHeight="30.0" prefWidth="427.0" styleClass="section-title" text="Vos Produits">
                                <padding>
                                    <Insets left="250.0" />
                                </padding>
                            </Label>
                            <ScrollPane prefHeight="523.0" prefWidth="849.0" styleClass="transparent">
                                <content>
                                    <GridPane fx:id="products_grid" hgap="15.0" prefHeight="622.0" prefWidth="857.0" vgap="15.0" />
                                </content>
                            </ScrollPane>
                            <!-- Pagination manuelle -->
                            <HBox alignment="CENTER" prefHeight="40.0" prefWidth="855.0" spacing="20.0">
                                <children>
                                    <Button fx:id="btn_previous" onAction="#previousPage" prefHeight="30.0" prefWidth="100.0" styleClass="btn-secondary" text="Précédent" />
                                    <Label fx:id="page_label" styleClass="form-label" text="Page 1 sur 1" />
                                    <Button fx:id="btn_next" onAction="#nextPage" prefHeight="30.0" prefWidth="100.0" styleClass="btn-secondary" text="Suivant" />
                                </children>
                                <padding>
                                    <Insets top="10.0" />
                                </padding>
                            </HBox>
                        </children>
                        <padding>
                            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                        </padding>
                    </VBox>
                </children>
            </AnchorPane>
        </HBox>
    </children>
</AnchorPane>
