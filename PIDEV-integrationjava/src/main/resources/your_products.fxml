<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="810.0" prefWidth="1315.0" xmlns="http://javafx.com/javafx/21.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.YourProductsController">
    <children>
        <!-- Bouton de retour -->
        <Button fx:id="btn_back" layoutX="14.0" layoutY="10.0" onAction="#goBackToProductList" prefHeight="35.0" prefWidth="35.0" styleClass="btn-icon" stylesheets="@mainFormDesign.css">
            <graphic>
                <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                    <image>
                        <Image url="@/images/back_arrow.png" />
                    </image>
                </ImageView>
            </graphic>
        </Button>


        <!-- Section gauche : Formulaire pour ajouter un produit -->
        <AnchorPane layoutX="14.0" layoutY="50.0" prefHeight="660.0" prefWidth="405.0" styleClass="white-bg,radius,shadow" stylesheets="@mainFormDesign.css">
            <children>
                <Label layoutX="93.0" layoutY="20.0" prefHeight="27.0" prefWidth="231.0" text="Ajouter un produit" textFill="#333">
                    <font>
                        <Font size="18.0" />
                    </font>
                </Label>
                <Label layoutX="14.0" layoutY="60.0" text="Nom du produit :">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <TextField fx:id="name" layoutX="120.0" layoutY="57.0" prefHeight="25.0" prefWidth="260.0" promptText="Nom du produit ..." />
                <Label layoutX="14.0" layoutY="100.0" text="Description :">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <TextArea fx:id="description" layoutX="120.0" layoutY="97.0" prefHeight="100.0" prefWidth="260.0" promptText="Description ..." />
                <Label layoutX="14.0" layoutY="210.0" text="Prix (DT) :">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <TextField fx:id="price" layoutX="120.0" layoutY="207.0" prefHeight="25.0" prefWidth="260.0" promptText="0 DT" />
                <Label layoutX="14.0" layoutY="250.0" text="Stock :">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <TextField fx:id="stock" layoutX="120.0" layoutY="247.0" prefHeight="25.0" prefWidth="260.0" promptText="0" />
                <Label layoutX="14.0" layoutY="290.0" text="Catégorie :">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <ComboBox fx:id="category" layoutX="120.0" layoutY="287.0" prefHeight="25.0" prefWidth="260.0" promptText="Choisissez la catégorie ..." />
                <Label layoutX="14.0" layoutY="330.0" text="Image :">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <!-- Bouton Importer avec icône -->
                <Button fx:id="btn_import" layoutX="120.0" layoutY="327.0" onAction="#importImage" prefHeight="25.0" prefWidth="25.0" styleClass="btn-icon" stylesheets="@mainFormDesign.css">
                    <graphic>
                        <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                            <image>
                                <Image url="@/images/import.png" />
                            </image>
                        </ImageView>
                    </graphic>
                </Button>
                <ImageView fx:id="product_imageView" fitHeight="100.0" fitWidth="100.0" layoutX="230.0" layoutY="327.0" pickOnBounds="true" preserveRatio="true" />
                <Button fx:id="btn_add" layoutX="70.0" layoutY="450.0" onAction="#addProduct" prefHeight="35.0" prefWidth="100.0" styleClass="btn" stylesheets="@mainFormDesign.css" text="Ajouter" />
                <Button fx:id="btn_clear" layoutX="230.0" layoutY="450.0" onAction="#clearForm" prefHeight="35.0" prefWidth="100.0" styleClass="btn" stylesheets="@mainFormDesign.css" text="Effacer" />
            </children>
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
        </AnchorPane>

        <!-- Section droite : Grille des cartes -->
        <AnchorPane layoutX="438.0" layoutY="50.0" prefHeight="638.0" prefWidth="826.0" styleClass="white-bg,radius,shadow" stylesheets="@mainFormDesign.css">
            <children>
                <Label layoutX="14.0" layoutY="14.0" text="Vos produits" textFill="#333">
                    <font>
                        <Font size="18.0" />
                    </font>
                </Label>
                <ScrollPane layoutX="11.0" layoutY="50.0" prefHeight="590.0" prefWidth="815.0" styleClass="transparent" stylesheets="@mainFormDesign.css">
                    <content>
                        <GridPane fx:id="products_grid" hgap="10.0" prefHeight="632.0" prefWidth="819.0" vgap="10.0" />
                    </content>
                </ScrollPane>
            </children>
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
        </AnchorPane>
    </children>
</AnchorPane>
