<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="500.0" prefWidth="600.0" style="-fx-background-color: #e8f5e9;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.Agriwise3A42.Controllers.Adminadd"> 

    <VBox alignment="CENTER" layoutX="50.0" layoutY="94.0" spacing="15.0" AnchorPane.leftAnchor="50.0" AnchorPane.rightAnchor="50.799999999999955" AnchorPane.topAnchor="94.0">

        <Label style="-fx-font-size: 24px; -fx-text-fill: #2e7d32; -fx-font-weight: bold;" text="Ajouter un Administrateur" />

        <TextField fx:id="nomField" promptText="Nom" style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #81c784; -fx-padding: 10;" />

        <TextField fx:id="prenomField" promptText="Prénom" style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #81c784; -fx-padding: 10;" />

        <TextField fx:id="emailField" promptText="Email" style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #81c784; -fx-padding: 10;" />

        <PasswordField fx:id="passwordField" promptText="Mot de passe" style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #81c784; -fx-padding: 10;" />
        
        <Button fx:id="submitButton" onAction="#Createadmin" style="-fx-background-color: #66bb6a; -fx-text-fill: white; -fx-background-radius: 10; -fx-font-size: 14px; -fx-padding: 10 20;" text="Ajouter" />
    </VBox>

</AnchorPane>
