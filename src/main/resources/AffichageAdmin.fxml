<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.chart.PieChart?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.AffichageAdmin"  stylesheets="@/values/stat.css">

    <!-- Zone de contenu avec scroll -->
    <AnchorPane layoutX="100.0" layoutY="0.0" prefHeight="700.0" prefWidth="800.0">
        <ScrollPane layoutX="10.0" layoutY="50.0"
                    AnchorPane.topAnchor="10.0" AnchorPane.bottomAnchor="10.0"
                    AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0"
                    fitToWidth="true" pannable="true">
            <content>
                <VBox spacing="20.0" prefWidth="680.0">

                    <!-- Statistiques -->
                    <VBox fx:id="statistiquesVBox" visible="true" spacing="20.0">
                        <Label text="Statistiques Avancées des Terrains" styleClass="table-title"/>

                        <!-- Conteneur pour les graphiques -->
                        <HBox spacing="20" alignment="CENTER">
                            <!-- Graphique des terrains les plus demandés -->
                            <VBox spacing="5">
                                <Label text="Terrains les plus demandés" style="-fx-font-weight: bold;"/>
                                <BarChart fx:id="barChart" title="" prefWidth="330.0" prefHeight="300.0" animated="true">
                                    <xAxis>
                                        <CategoryAxis label="Terrains"/>
                                    </xAxis>
                                    <yAxis>
                                        <NumberAxis label="Nombre de Candidatures"/>
                                    </yAxis>
                                </BarChart>
                            </VBox>

                            <!-- Graphique des terrains les plus chers -->
                            <VBox spacing="5">
                                <Label text="Terrains les plus chers" style="-fx-font-weight: bold;"/>
                                <BarChart fx:id="priceChart" title="" prefWidth="330.0" prefHeight="300.0" animated="true">
                                    <xAxis>
                                        <CategoryAxis label="Localisation"/>
                                    </xAxis>
                                    <yAxis>
                                        <NumberAxis label="Prix (DT)"/>
                                    </yAxis>
                                </BarChart>
                            </VBox>
                        </HBox>

                        <!-- Deuxième ligne de graphiques -->
                        <HBox spacing="20" alignment="CENTER">
                            <!-- PieChart pour la répartition des candidatures -->
                            <VBox spacing="5">
                                <Label text="Répartition des Candidatures" style="-fx-font-weight: bold;"/>
                                <PieChart fx:id="pieChart" prefWidth="330.0" prefHeight="300.0" animated="true"/>
                            </VBox>

                            <!-- Statistiques textuelles avec style -->
                            <VBox spacing="10" style="-fx-background-color: #f5f5f5; -fx-padding: 15; -fx-border-radius: 5; -fx-background-radius: 5;">
                                <Label text="Résumé Statistique" style="-fx-font-weight: bold; -fx-font-size: 16;"/>
                                <Label fx:id="totalTerrainsLabel" style="-fx-text-fill: #2e8b57; -fx-font-size: 14;"/>
                                <Label fx:id="activeCandidaturesLabel" style="-fx-text-fill: #4169e1; -fx-font-size: 14;"/>
                                <Label fx:id="revenueLabel" style="-fx-text-fill: #ff6347; -fx-font-size: 14;"/>
                            </VBox>
                        </HBox>

                        <!-- Détails textuels avec animation -->
                        <Label fx:id="statsDetailsLabel" wrapText="true" style="-fx-font-size: 14; -fx-padding: 10; -fx-background-color: #e6e6fa; -fx-background-radius: 5;"/>
                    </VBox>

                    <!-- Le reste de votre code existant... -->
                    <!-- Table Terrains -->
                    <VBox fx:id="terrainVBox" visible="true">
                        <Label text="Liste des Terrains" styleClass="table-title"/>
                        <TableView fx:id="terrainTableView" prefHeight="250.0" prefWidth="680.0">
                            <columns>
                                <TableColumn fx:id="idColumn" text="ID" prefWidth="75.0"/>
                                <TableColumn fx:id="utilisateurIdColumn" text="Utilisateur ID" prefWidth="90.0"/>
                                <TableColumn fx:id="localisationColumn" text="Localisation" prefWidth="100.0"/>
                                <TableColumn fx:id="superficieColumn" text="Superficie (m²)" prefWidth="80.0"/>
                                <TableColumn fx:id="prixColumn" text="Prix (DT)" prefWidth="70.0"/>
                                <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="150.0"/>
                                <TableColumn fx:id="imageColumn" text="Image" prefWidth="100.0"/>
                            </columns>
                        </TableView>
                    </VBox>

                    <!-- Table Candidatures -->
                    <VBox fx:id="candidatureVBox" visible="true">
                        <Label text="Liste des Candidatures" styleClass="table-title"/>
                        <TableView fx:id="candidatureTableView" prefHeight="250.0" prefWidth="680.0">
                            <columns>
                                <TableColumn fx:id="candidatureIdColumn" text="ID" prefWidth="75.0"/>
                                <TableColumn fx:id="terrainIdColumn" text="Terrain ID" prefWidth="90.0"/>
                                <TableColumn fx:id="userIdColumn" text="Utilisateur ID" prefWidth="90.0"/>
                                <TableColumn fx:id="dateDebutColumn" text="Date Début" prefWidth="90.0"/>
                                <TableColumn fx:id="dateFinColumn" text="Date Fin" prefWidth="90.0"/>
                                <TableColumn fx:id="butColumn" text="But" prefWidth="90.0"/>
                                <TableColumn fx:id="montantColumn" text="Montant" prefWidth="80.0"/>
                                <TableColumn fx:id="etatColumn" text="État" prefWidth="70.0"/>
                            </columns>
                        </TableView>
                    </VBox>

                </VBox>
            </content>
        </ScrollPane>
    </AnchorPane>
</AnchorPane>