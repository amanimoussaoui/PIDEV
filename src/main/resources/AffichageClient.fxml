<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.effect.Glow?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.AffichageClient"
            stylesheets="@/values/agriculture.css">

    <top>
        <StackPane style="-fx-background-color: linear-gradient(to right, #2E7D32, #4CAF50);">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Button fx:id="backButton" text="← Retour" onAction="#handleBackButton"
                        styleClass="back-button">
                    <graphic>
                        <ImageView fitWidth="16" fitHeight="16">
                            <Image url="@/images/back-arrow.png"/>
                        </ImageView>
                    </graphic>
                </Button>
                <Label text="🌾 Nos Terrains Agricoles Disponibles 🌾"
                       styleClass="header-title">
                    <effect>
                        <DropShadow color="#00000080" radius="5" spread="0.3"/>
                    </effect>
                </Label>
            </HBox>
        </StackPane>
    </top>

    <center>
        <SplitPane dividerPositions="0.5" style="-fx-background-color: #f5f5f5;">
            <!-- Partie gauche : Liste des terrains -->
            <ScrollPane fitToWidth="true" style="-fx-background: #f9f9f9;">
                <content>
                    <FlowPane fx:id="terrainsContainer" hgap="25" vgap="25"
                              alignment="TOP_CENTER" style="-fx-padding: 20;">
                        <effect>
                            <Glow level="0.02"/>
                        </effect>
                    </FlowPane>
                </content>
            </ScrollPane>

            <!-- Partie droite : Détails + Calendrier -->
            <VBox fx:id="detailsPane" styleClass="details-pane" spacing="15">
                <!-- Section Calendrier en haut -->
                <VBox fx:id="calendarContainer" visible="false" spacing="10" style="-fx-padding: 15; -fx-background-color: white; -fx-border-radius: 5;">
                    <Label text="Périodes de réservation" styleClass="calendar-title"/>
                    <HBox alignment="CENTER" spacing="15">
                        <Button fx:id="prevMonthBtn" styleClass="calendar-nav-button" text="&lt;"/>
                        <Label fx:id="monthYearLabel" styleClass="calendar-month-label"/>
                        <Button fx:id="nextMonthBtn" styleClass="calendar-nav-button" text="&gt;"/>
                    </HBox>
                    <GridPane fx:id="calendarGrid" hgap="2" vgap="2">
                        <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS" minWidth="40" prefWidth="40"/>
                            <ColumnConstraints hgrow="ALWAYS" minWidth="40" prefWidth="40"/>
                            <ColumnConstraints hgrow="ALWAYS" minWidth="40" prefWidth="40"/>
                            <ColumnConstraints hgrow="ALWAYS" minWidth="40" prefWidth="40"/>
                            <ColumnConstraints hgrow="ALWAYS" minWidth="40" prefWidth="40"/>
                            <ColumnConstraints hgrow="ALWAYS" minWidth="40" prefWidth="40"/>
                            <ColumnConstraints hgrow="ALWAYS" minWidth="40" prefWidth="40"/>
                        </columnConstraints>
                    </GridPane>
                </VBox>

                <!-- Section Détails du terrain -->
                <VBox style="-fx-background-color: white; -fx-background-radius: 5; -fx-padding: 15;">
                    <StackPane>
                        <ImageView fx:id="detailImage" fitWidth="300" fitHeight="180" preserveRatio="true" styleClass="terrain-image"/>
                    </StackPane>

                    <GridPane hgap="10" vgap="10" style="-fx-padding: 10 0 0 0;">
                        <columnConstraints>
                            <ColumnConstraints prefWidth="100" halignment="RIGHT"/>
                            <ColumnConstraints prefWidth="200"/>
                        </columnConstraints>

                        <!-- Prix avec devise -->
                        <Label text="Prix:" styleClass="detail-label" GridPane.rowIndex="0"/>
                        <HBox spacing="5" alignment="CENTER_LEFT" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label fx:id="prixLabel" styleClass="detail-value"/>
                            <ComboBox fx:id="deviseComboBox" styleClass="devise-combo" prefWidth="120"/>
                        </HBox>

                        <!-- Autres détails -->
                        <Label text="Localisation:" styleClass="detail-label" GridPane.rowIndex="1"/>
                        <Label fx:id="localisationLabel" styleClass="detail-value" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                        <Label text="Superficie:" styleClass="detail-label" GridPane.rowIndex="2"/>
                        <Label fx:id="superficieLabel" styleClass="detail-value" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                        <Label text="Description:" styleClass="detail-label" GridPane.rowIndex="3"/>
                        <TextArea fx:id="descriptionArea" editable="false" wrapText="true"
                                  styleClass="detail-textarea" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                    </GridPane>
                </VBox>

                <!-- Boutons d'action -->
                <HBox spacing="15" alignment="CENTER">
                    <Button fx:id="candidatureBtn" text="Faire Candidature" styleClass="action-button" onAction="#handleCandidature"/>
                    <Button fx:id="generateContractBtn" text="Générer Contrat" styleClass="action-button" onAction="#handleGenerateContract"/>
                </HBox>

            </VBox>
        </SplitPane>
    </center>
</BorderPane>