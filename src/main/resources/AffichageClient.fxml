<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.effect.Glow?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.AffichageClient"
            stylesheets="@/values/agriculture.css">

    <top>
        <StackPane style="-fx-background-color: linear-gradient(to right, #2E7D32, #4CAF50);">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <!-- Bouton Back -->
                <Button fx:id="backButton" text="← Retour" onAction="#handleBackButton"
                        styleClass="back-button">
                    <graphic>
                        <ImageView fitWidth="16" fitHeight="16">
                            <Image url="@/images/back-arrow.png"/>
                        </ImageView>
                    </graphic>
                    <padding>
                        <Insets left="10" right="10" top="5" bottom="5"/>
                    </padding>
                </Button>

                <Label text="🌾 Nos Terrains Agricoles Disponibles 🌾"
                       styleClass="header-title">
                    <effect>
                        <DropShadow color="#00000080" radius="5" spread="0.3"/>
                    </effect>
                </Label>
            </HBox>
            <padding>
                <Insets top="15" bottom="15" left="15"/>
            </padding>
        </StackPane>
    </top>
    <center>
        <SplitPane dividerPositions="0.6" style="-fx-background-color: #f5f5f5;">
            <effect>
                <DropShadow color="#00000020" radius="10" spread="0.2"/>
            </effect>

            <ScrollPane fitToWidth="true" style="-fx-background: #f9f9f9;">
                <content>
                    <FlowPane fx:id="terrainsContainer" hgap="25" vgap="25"
                              alignment="TOP_CENTER" style="-fx-padding: 20;">
                        <effect>
                            <Glow level="0.02"/>
                        </effect>
                    </FlowPane>
                </content>
            </ScrollPane>

            <VBox fx:id="detailsPane" styleClass="details-pane" spacing="15">
                <effect>
                    <DropShadow color="#00000015" radius="5" spread="0.1"/>
                </effect>

                <StackPane>
                    <ImageView fx:id="detailImage" fitWidth="350" fitHeight="220"
                               preserveRatio="true" styleClass="terrain-image">
                        <effect>
                            <DropShadow color="#00000040" radius="10" spread="0.2"/>
                        </effect>
                    </ImageView>
                    <Pane styleClass="image-overlay" visible="false"
                          fx:id="imageOverlay" StackPane.alignment="CENTER">
                        <Label text="Agrandir" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                    </Pane>
                </StackPane>

                <VBox spacing="10" style="-fx-padding: 0 15 15 15;">
                    <Label text="Détails du Terrain" styleClass="details-title"/>

                    <GridPane hgap="15" vgap="12">
                        <columnConstraints>
                            <ColumnConstraints prefWidth="120" halignment="RIGHT"/>
                            <ColumnConstraints prefWidth="220"/>
                        </columnConstraints>

                        <Label text="Prix:" styleClass="detail-label" GridPane.rowIndex="0"/>
                        <HBox spacing="5" alignment="CENTER_LEFT" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label fx:id="prixLabel" styleClass="detail-value"/>
                            <Label text="DT/mois" styleClass="detail-unit"/>
                        </HBox>

                        <Label text="Localisation:" styleClass="detail-label" GridPane.rowIndex="1"/>
                        <HBox spacing="5" alignment="CENTER_LEFT" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <Label fx:id="localisationLabel" styleClass="detail-value"/>
                            <ImageView fitWidth="16" fitHeight="16" pickOnBounds="true" preserveRatio="true">
                                <Image url="@/images/location-icon.png"/>
                            </ImageView>
                        </HBox>

                        <Label text="Superficie:" styleClass="detail-label" GridPane.rowIndex="2"/>
                        <HBox spacing="5" alignment="CENTER_LEFT" GridPane.columnIndex="1" GridPane.rowIndex="2">
                            <Label fx:id="superficieLabel" styleClass="detail-value"/>
                            <Label text="m²" styleClass="detail-unit"/>
                        </HBox>

                        <Label text="Description:" styleClass="detail-label" GridPane.rowIndex="3"/>
                        <TextArea fx:id="descriptionArea" editable="false" wrapText="true"
                                  GridPane.columnIndex="1" GridPane.rowIndex="3" styleClass="detail-textarea"/>
                    </GridPane>

                    <Button fx:id="candidatureBtn" text="Faire Candidature"
                            styleClass="candidature-button" onAction="#handleCandidature">
                        <graphic>
                            <ImageView fitWidth="20" fitHeight="20" pickOnBounds="true" preserveRatio="true">
                                <Image url="@/images/application-icon.png"/>
                            </ImageView>
                        </graphic>
                    </Button>
                </VBox>
            </VBox>
        </SplitPane>
    </center>
</BorderPane>