<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="650" prefWidth="900" stylesheets="@values/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.AfficherTerrain">

   <top>
      <HBox alignment="CENTER" style="-fx-background-color: #278f57; -fx-padding: 15;">
         <Label style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold;" text="Gestion des Terrains" />
      </HBox>
   </top>

   <center>
      <SplitPane dividerPositions="0.65">
         <items>

            <!-- Partie droite : Détails avec fond gris et cadre -->
            <VBox style="-fx-background-color: #f5f5f5; -fx-padding: 20;">
               <VBox style="-fx-background-color: #d5d4d3 ; -fx-border-color: #e0e0e0; -fx-border-width: 1; -fx-border-radius: 5; -fx-padding: 20;">
                  <Label style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #333; -fx-padding: 0 0 10 0;" text="Détails du Terrain" />

                  <ImageView fx:id="imageViewTerrain" fitHeight="200" fitWidth="300" preserveRatio="true" style="-fx-border-color: #ddd; -fx-border-width: 1; -fx-border-radius: 3;" />

                  <GridPane hgap="10" vgap="10" style="-fx-padding: 10 0 0 0;">
                     <columnConstraints>
                        <ColumnConstraints prefWidth="100" />
                        <ColumnConstraints prefWidth="200" />
                     </columnConstraints>

                     <Label style="-fx-font-weight: bold;" text="Prix:" />
                     <Label fx:id="textPrix" GridPane.columnIndex="1" />

                     <Label style="-fx-font-weight: bold;" text="Localisation:" GridPane.rowIndex="1" />
                     <Label fx:id="textLocalisation" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                     <Label style="-fx-font-weight: bold;" text="Superficie:" GridPane.rowIndex="2" />
                     <Label fx:id="textSuperficie" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                     <Label style="-fx-font-weight: bold;" text="Description:" GridPane.rowIndex="3" />
                     <TextArea fx:id="textDescription" editable="false" prefRowCount="3" wrapText="true"
                               style="-fx-background-color: transparent; -fx-border-color: #eee;"
                               GridPane.columnIndex="1" GridPane.rowIndex="3" />
                     <rowConstraints>
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                     </rowConstraints>
                  </GridPane>

                  <HBox alignment="CENTER" spacing="15" style="-fx-padding: 20 0 0 0;">
                     <Button fx:id="btnAjouter" onAction="#ouvrirAjouterTerrain"
                             text="Ajouter Terrain"
                             style="-fx-background-color: #278f57; -fx-text-fill: white; -fx-font-weight: bold; -fx-min-width: 120;" />

                     <Button fx:id="btnModifier" onAction="#modifierTerrain"
                             text="Modifier"
                             style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold; -fx-min-width: 100;" />

                     <Button fx:id="btnSupprimer" onAction="#supprimerTerrain"
                             text="Supprimer"
                             style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-font-weight: bold; -fx-min-width: 100;" />

                     <Button fx:id="btnVoirCandidatures" onAction="#voirCandidatures"
                             text="Voir Candidatures"
                             style="-fx-background-color: #6A5ACD; -fx-text-fill: white; -fx-font-weight: bold; -fx-min-width: 150;" />
                  </HBox>

                  <!-- TableView cachée au début -->
                  <TableView fx:id="tableCandidatures" visible="false"
                             prefHeight="200" prefWidth="600"
                             style="-fx-background-color: white; -fx-border-color: lightgrey; -fx-border-radius: 5; -fx-padding: 10;">
                     <columns>
                        <TableColumn fx:id="colId" text="ID" />
                        <TableColumn fx:id="colDateDebut" text="Date Début" />
                        <TableColumn fx:id="colDateFin" text="Date Fin" />
                        <TableColumn fx:id="colBut" text="But" />
                        <TableColumn fx:id="colMontant" text="Montant" />
                        <TableColumn fx:id="colEtat" text="État" />
                     </columns>
                  </TableView>

               </VBox>
            </VBox>

            <!-- Partie gauche : Liste des terrains -->
            <ScrollPane fitToWidth="true" prefHeight="588.0" prefWidth="370.0">
               <content>
                  <FlowPane fx:id="terrainList" hgap="15" prefWrapLength="550" vgap="15">
                     <padding>
                        <Insets bottom="15" left="15" right="15" top="15" />
                     </padding>
                  </FlowPane>
               </content>
            </ScrollPane>

         </items>
      </SplitPane>
   </center>

</BorderPane>
