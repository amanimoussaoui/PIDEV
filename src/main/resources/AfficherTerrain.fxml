<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.web.WebView?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="650" prefWidth="900" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.AfficherTerrain">

   <!-- Top: Header avec image agricole -->
   <top>
      <HBox alignment="CENTER" style="-fx-background-color: linear-gradient(to right, #2E8B57, #3CB371); -fx-padding: 15;">
         <ImageView fitHeight="40" fitWidth="40" preserveRatio="true">
            <Image url="@/images/tractor-icon.png" />
         </ImageView>
         <Label style="-fx-text-fill: white; -fx-font-size: 24; -fx-font-weight: bold; -fx-padding: 0 0 0 10;" text="Gestion des Terrains Agricoles" />
      </HBox>
   </top>

   <!-- Center: SplitPane pour la liste et les détails -->
   <center>
      <SplitPane dividerPositions="0.3" style="-fx-background-color: #F5F5F5;">
         <items>
            <!-- Partie gauche : Liste des terrains avec recherche -->
            <VBox spacing="10" style="-fx-padding: 15; -fx-background-color: #F9F9F9;">
               <!-- Champ de recherche avec icône -->
               <HBox spacing="5" alignment="CENTER_LEFT" style="-fx-padding: 5; -fx-background-color: white; -fx-background-radius: 20;">
                  <ImageView fitHeight="20" fitWidth="20">
                     <Image url="@/images/search-icon.png" />
                  </ImageView>
                  <TextField fx:id="txtRecherche" promptText="Rechercher un terrain..." style="-fx-background-color: transparent; -fx-border-width: 0; -fx-padding: 5;" onKeyReleased="#handleRecherche" />
               </HBox>

               <!-- Liste des terrains -->
               <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: #DDD;">
                  <content>
                     <FlowPane fx:id="terrainList" hgap="15" prefWrapLength="550" vgap="15">
                        <padding>
                           <Insets bottom="15" left="15" right="15" top="15" />
                        </padding>
                     </FlowPane>
                  </content>
               </ScrollPane>
            </VBox>

            <!-- Partie droite : Détails du terrain -->
            <VBox spacing="15" style="-fx-padding: 20; -fx-background-color: #F5F5F5;">
               <!-- Carte du terrain avec image -->
               <VBox style="-fx-background-color: white; -fx-border-color: #DDD; -fx-border-radius: 5; -fx-padding: 15;">
                  <Label style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #2E8B57;" text="Détails du Terrain">
                     <font>
                        <Font name="Arial" size="18.0" />
                     </font>
                  </Label>

                  <HBox spacing="20" alignment="TOP_CENTER">
                     <!-- Image du terrain -->
                     <VBox spacing="10">
                        <ImageView fx:id="imageViewTerrain" fitHeight="200" fitWidth="250" preserveRatio="true" style="-fx-border-color: #DDD; -fx-border-width: 1; -fx-border-radius: 3;" />
                        <WebView fx:id="webView" prefHeight="150" prefWidth="250" />
                     </VBox>

                     <!-- Détails textuels -->
                     <GridPane hgap="10" vgap="10" style="-fx-padding: 10;">
                        <columnConstraints>
                           <ColumnConstraints prefWidth="100" />
                           <ColumnConstraints prefWidth="200" />
                        </columnConstraints>

                        <Label style="-fx-font-weight: bold; -fx-text-fill: #555;" text="Prix:" />
                        <Label fx:id="textPrix" GridPane.columnIndex="1" style="-fx-text-fill: #2E8B57;" />

                        <Label style="-fx-font-weight: bold; -fx-text-fill: #555;" text="Localisation:" GridPane.rowIndex="1" />
                        <Label fx:id="textLocalisation" GridPane.columnIndex="1" GridPane.rowIndex="1" style="-fx-text-fill: #2E8B57;" />

                        <Label style="-fx-font-weight: bold; -fx-text-fill: #555;" text="Superficie:" GridPane.rowIndex="2" />
                        <Label fx:id="textSuperficie" GridPane.columnIndex="1" GridPane.rowIndex="2" style="-fx-text-fill: #2E8B57;" />

                        <Label style="-fx-font-weight: bold; -fx-text-fill: #555;" text="Description:" GridPane.rowIndex="3" />
                        <TextArea fx:id="textDescription" editable="false" prefRowCount="3" wrapText="true"
                                  style="-fx-background-color: #FAFAFA; -fx-border-color: #DDD; -fx-text-fill: #555;"
                                  GridPane.columnIndex="1" GridPane.rowIndex="3" />
                     </GridPane>
                  </HBox>
               </VBox>

               <!-- Boutons d'actions -->
               <HBox alignment="CENTER" spacing="15" style="-fx-padding: 10;">
                  <Button fx:id="btnAjouter" onAction="#ouvrirAjouterTerrain" text="Ajouter"
                          style="-fx-background-color: #3CB371; -fx-text-fill: white; -fx-font-weight: bold; -fx-min-width: 100; -fx-background-radius: 5;">
                     <graphic>
                        <ImageView fitHeight="16" fitWidth="16">
                           <Image url="@/images/add-icon.png" />
                        </ImageView>
                     </graphic>
                  </Button>

                  <Button fx:id="btnModifier" onAction="#modifierTerrain" text="Modifier"
                          style="-fx-background-color: #4682B4; -fx-text-fill: white; -fx-font-weight: bold; -fx-min-width: 100; -fx-background-radius: 5;">
                     <graphic>
                        <ImageView fitHeight="16" fitWidth="16">
                           <Image url="@/images/edit-icon.png" />
                        </ImageView>
                     </graphic>
                  </Button>

                  <Button fx:id="btnSupprimer" onAction="#supprimerTerrain" text="Supprimer"
                          style="-fx-background-color: #CD5C5C; -fx-text-fill: white; -fx-font-weight: bold; -fx-min-width: 100; -fx-background-radius: 5;">
                     <graphic>
                        <ImageView fitHeight="16" fitWidth="16">
                           <Image url="@/images/delete-icon.png" />
                        </ImageView>
                     </graphic>
                  </Button>

                  <Button fx:id="btnVoirCandidatures" onAction="#voirCandidatures" text="Candidatures"
                          style="-fx-background-color: #6A5ACD; -fx-text-fill: white; -fx-font-weight: bold; -fx-min-width: 120; -fx-background-radius: 5;">
                     <graphic>
                        <ImageView fitHeight="16" fitWidth="16">
                           <Image url="@/images/candidates-icon.png" />
                        </ImageView>
                     </graphic>
                  </Button>
               </HBox>

               <!-- Tableau des candidatures (caché par défaut) -->
               <VBox spacing="10" fx:id="candidaturesSection" visible="false">
                  <Label text="Candidatures pour ce terrain" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #2E8B57;" />

                  <TableView fx:id="tableCandidatures" prefHeight="200" prefWidth="600"
                             style="-fx-background-color: white; -fx-border-color: #DDD; -fx-border-radius: 5;">
                     <columns>
                        <TableColumn fx:id="colId" text="ID" style="-fx-alignment: CENTER;" />
                        <TableColumn fx:id="colDateDebut" text="Date Début" style="-fx-alignment: CENTER;" />
                        <TableColumn fx:id="colDateFin" text="Date Fin" style="-fx-alignment: CENTER;" />
                        <TableColumn fx:id="colBut" text="But" style="-fx-alignment: CENTER;" />
                        <TableColumn fx:id="colMontant" text="Montant" style="-fx-alignment: CENTER;" />
                        <TableColumn fx:id="colEtat" text="État" style="-fx-alignment: CENTER;" />
                     </columns>
                  </TableView>

                  <HBox alignment="CENTER" spacing="15" style="-fx-padding: 10;">
                     <Button fx:id="btnAccepter" text="Accepter" onAction="#accepterCandidature"
                             style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;">
                        <graphic>
                           <ImageView fitHeight="16" fitWidth="16">
                              <Image url="@/images/accept-icon.png" />
                           </ImageView>
                        </graphic>
                     </Button>
                     <Button fx:id="btnRefuser" text="Refuser" onAction="#refuserCandidature"
                             style="-fx-background-color: #F44336; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;">
                        <graphic>
                           <ImageView fitHeight="16" fitWidth="16">
                              <Image url="@/images/reject-icon.png" />
                           </ImageView>
                        </graphic>
                     </Button>
                  </HBox>
               </VBox>
            </VBox>
         </items>
      </SplitPane>
   </center>

   <!-- Bottom: Footer -->
   <bottom>
      <HBox alignment="CENTER" style="-fx-background-color: #2E8B57; -fx-padding: 10;">
         <Label style="-fx-text-fill: white; -fx-font-size: 12;" text="© 2023 Système de Gestion Agricole - Tous droits réservés" />
      </HBox>
   </bottom>
</BorderPane>