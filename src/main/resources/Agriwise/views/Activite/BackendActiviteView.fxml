<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>
<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>

<StackPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="Agriwise.controllers.Activite.BackendActiviteController">
    <stylesheets>
        <URL value="@../../css/styles.css" />
    </stylesheets>


    <!-- Main Content -->
        <BorderPane styleClass="app-container" HBox.hgrow="ALWAYS">
            <!-- Top Header Bar -->
            <top>
                <HBox styleClass="top-bar">
                    <HBox styleClass="page-header">
                        <Label text="Liste des Activités" styleClass="page-title"/>
                    </HBox>
                    <Region HBox.hgrow="ALWAYS" />
                </HBox>
            </top>

            <!-- Main Content -->
            <center>
                <VBox styleClass="main-content">
                    <!-- Action Bar with Search and Create Button -->
                    <HBox styleClass="action-bar">
                        <!-- Search and Filter Section -->
                        <HBox styleClass="search-filter-bar" HBox.hgrow="ALWAYS">
                            <!-- Search Field -->
                            <HBox alignment="CENTER_LEFT" spacing="8" styleClass="search-box" HBox.hgrow="ALWAYS">
                                <FontAwesomeIconView glyphName="SEARCH" size="14" styleClass="search-icon"/>
                                <TextField fx:id="searchField" promptText="Rechercher une activité..."
                                           onKeyReleased="#handleSearch" styleClass="search-input" HBox.hgrow="ALWAYS"/>
                                <Button fx:id="clearSearchButton" styleClass="icon-button" onAction="#clearSearch">
                                    <graphic>
                                        <FontAwesomeIconView glyphName="TIMES" size="12"/>
                                    </graphic>
                                </Button>
                            </HBox>

                            <!-- Type Filter -->
                            <HBox alignment="CENTER_LEFT" spacing="8" styleClass="filter-box">
                                <FontAwesomeIconView glyphName="FILTER" size="14" styleClass="filter-icon"/>
                                <ComboBox fx:id="typeFilter" promptText="Type d'activité"
                                          onAction="#handleTypeFilter" styleClass="filter-combo"/>
                                <Button fx:id="clearFilterButton" styleClass="icon-button" onAction="#clearFilters">
                                    <graphic>
                                        <FontAwesomeIconView glyphName="TIMES" size="12"/>
                                    </graphic>
                                </Button>
                            </HBox>
                        </HBox>

                        <!-- Create Button -->
                        <HBox styleClass="right-actions">
                            <Button fx:id="createButton" text="Créer une nouvelle Activité" onAction="#handleAddActivite" styleClass="btn-submit">
                                <graphic>
                                    <FontAwesomeIconView glyphName="PLUS_CIRCLE" styleClass="button-icon"/>
                                </graphic>
                            </Button>
                        </HBox>
                    </HBox>

                    <!-- Active Filters Display -->
                    <FlowPane fx:id="activeFiltersContainer" hgap="10" vgap="5" visible="false" managed="false" styleClass="filter-tags"/>

                    <!-- Table Container -->
                    <StackPane styleClass="table-wrapper" VBox.vgrow="ALWAYS">
                        <TableView fx:id="activiteTable" styleClass="modern-table">
                            <columns>
                                <TableColumn fx:id="idColumn" text="ID" prefWidth="80" />
                                <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="250" />
                                <TableColumn fx:id="typeColumn" text="Type" prefWidth="150" />
                                <TableColumn fx:id="dateColumn" text="Date" prefWidth="120" />
                                <TableColumn fx:id="cultureColumn" text="Culture" prefWidth="150" />
                                <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="180" />
                            </columns>
                            <placeholder>
                                <VBox styleClass="empty-state">
                                    <FontAwesomeIconView glyphName="TASKS" styleClass="empty-icon"/>
                                    <Label text="Aucune activité trouvée" styleClass="empty-title"/>
                                    <Label text="Créez votre première activité pour commencer" styleClass="empty-desc"/>
                                    <Button styleClass="empty-action" onAction="#handleAddActivite">
                                        <graphic>
                                            <HBox styleClass="button-content">
                                                <FontAwesomeIconView glyphName="PLUS" styleClass="button-icon"/>
                                                <Label text="Ajouter une activité" styleClass="button-text"/>
                                            </HBox>
                                        </graphic>
                                    </Button>
                                </VBox>
                            </placeholder>
                        </TableView>
                    </StackPane>
                </VBox>
            </center>
        </BorderPane>
</StackPane>