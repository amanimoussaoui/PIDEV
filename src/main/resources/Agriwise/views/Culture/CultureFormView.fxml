<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>
<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>
<?import java.net.URL?>

<VBox xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Agriwise.controllers.Culture.CultureFormController"
      styleClass="form-card" prefWidth="600" prefHeight="650">
    <stylesheets>
        <URL value="@../../css/styles.css" />
    </stylesheets>

    <!-- Header -->
    <HBox styleClass="form-header" spacing="15" alignment="CENTER_LEFT">
        <StackPane styleClass="header-icon-container">
            <FontAwesomeIconView glyphName="LEAF" styleClass="header-icon"/>
        </StackPane>
        <VBox spacing="5">
            <Label fx:id="formTitle" styleClass="header-title" text="Nouvelle Culture"/>
            <Label styleClass="header-subtitle" text="Créez ou modifiez les détails de votre culture agricole"/>
        </VBox>
    </HBox>

    <!-- Content Area -->
    <ScrollPane fitToWidth="true" styleClass="form-scroll" vbarPolicy="AS_NEEDED">
        <VBox styleClass="form-content" spacing="15">
            <!-- General Information Section -->
            <TitledPane text="Informations générales" styleClass="form-section" expanded="true">
                <VBox spacing="15">
                    <!-- Name Field -->
                    <VBox styleClass="field-group">
                        <Label text="Nom de la culture" styleClass="field-label">
                            <graphic>
                                <FontAwesomeIconView glyphName="TAG" styleClass="label-icon"/>
                            </graphic>
                        </Label>
                        <TextField fx:id="nomCultureField" promptText="Ex: Blé dur" styleClass="modern-input"/>
                    </VBox>

                    <!-- Planting Date -->
                    <VBox styleClass="field-group">
                        <Label text="Date de semis" styleClass="field-label">
                            <graphic>
                                <FontAwesomeIconView glyphName="CALENDAR" styleClass="label-icon"/>
                            </graphic>
                        </Label>
                        <DatePicker fx:id="dateSemisPicker" styleClass="modern-datepicker"/>
                    </VBox>

                    <!-- Duration -->
                    <VBox styleClass="field-group">
                        <Label text="Durée (jours)" styleClass="field-label">
                            <graphic>
                                <FontAwesomeIconView glyphName="CLOCK_ALT" styleClass="label-icon"/>
                            </graphic>
                        </Label>
                        <TextField fx:id="dureeField" promptText="Ex: 120" styleClass="modern-input"/>
                    </VBox>
                </VBox>
            </TitledPane>

            <!-- Culture Details Section -->
            <TitledPane text="Détails de la culture" styleClass="form-section" expanded="true">
                <VBox spacing="15">
                    <!-- Status and Parcel in same row -->
                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <!-- Status -->
                        <VBox styleClass="field-group" HBox.hgrow="ALWAYS">
                            <Label text="Statut" styleClass="field-label">
                                <graphic>
                                    <FontAwesomeIconView glyphName="INFO_CIRCLE" styleClass="label-icon"/>
                                </graphic>
                            </Label>
                            <ComboBox fx:id="statutCombo" promptText="Sélectionnez le statut" styleClass="modern-combo"/>
                        </VBox>

                        <!-- Parcel -->
                        <VBox styleClass="field-group" HBox.hgrow="ALWAYS">
                            <Label text="Parcelle" styleClass="field-label">
                                <graphic>
                                    <FontAwesomeIconView glyphName="MAP_MARKER" styleClass="label-icon"/>
                                </graphic>
                            </Label>
                            <ComboBox fx:id="parcelleCombo" promptText="Sélectionnez une parcelle" styleClass="modern-combo"/>
                        </VBox>
                    </HBox>
                </VBox>
            </TitledPane>

            <!-- Improved Prediction Results Section -->
            <VBox fx:id="predictionResultContainer" styleClass="prediction-container" visible="false" managed="false">
                <VBox styleClass="prediction-card">
                    <HBox styleClass="prediction-header" alignment="CENTER_LEFT" spacing="15">
                        <FontAwesomeIconView glyphName="LINE_CHART" styleClass="prediction-icon"/>
                        <Label text="Prédiction de Récolte" styleClass="prediction-title"/>
                    </HBox>

                    <HBox styleClass="prediction-content" alignment="CENTER" spacing="20">
                        <VBox alignment="CENTER" HBox.hgrow="ALWAYS">
                            <StackPane styleClass="prediction-value-container">
                                <FontAwesomeIconView glyphName="BALANCE_SCALE" styleClass="prediction-value-icon"/>
                                <VBox alignment="CENTER">
                                    <Label fx:id="predictionResultLabel" styleClass="prediction-value" text="0.00"/>
                                    <Label styleClass="prediction-unit" text="kg"/>
                                </VBox>
                            </StackPane>
                        </VBox>

                        <VBox alignment="CENTER_LEFT" styleClass="prediction-details" HBox.hgrow="ALWAYS">
                            <Label styleClass="prediction-detail-title" text="Basé sur:"/>
                            <HBox alignment="CENTER_LEFT" styleClass="prediction-detail-item" spacing="10">
                                <FontAwesomeIconView glyphName="CHECK_CIRCLE" styleClass="prediction-detail-icon"/>
                                <Label text="Données historiques de cultures similaires"/>
                            </HBox>
                            <HBox alignment="CENTER_LEFT" styleClass="prediction-detail-item" spacing="10">
                                <FontAwesomeIconView glyphName="CHECK_CIRCLE" styleClass="prediction-detail-icon"/>
                                <Label text="Caractéristiques de la parcelle"/>
                            </HBox>
                            <HBox alignment="CENTER_LEFT" styleClass="prediction-detail-item" spacing="10">
                                <FontAwesomeIconView glyphName="CHECK_CIRCLE" styleClass="prediction-detail-icon"/>
                                <Label text="Durée de croissance prévue"/>
                            </HBox>
                        </VBox>
                    </HBox>

                    <HBox styleClass="prediction-footer" alignment="CENTER_LEFT">
                        <FontAwesomeIconView glyphName="INFO_CIRCLE" styleClass="prediction-info-icon"/>
                        <Label styleClass="prediction-note" text="Cette estimation est basée sur un modèle de prédiction utilisant les paramètres fournis."/>
                    </HBox>
                </VBox>
            </VBox>
        </VBox>
    </ScrollPane>

    <!-- Footer -->
    <HBox styleClass="form-footer" spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="cancelButton" onAction="#handleCancel" styleClass="btn-cancel" text="Annuler">
            <graphic>
                <FontAwesomeIconView glyphName="TIMES" styleClass="button-icon"/>
            </graphic>
        </Button>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="predictButton" onAction="#handlePredict" styleClass="btn-warning" text="Prédire la récolte">
            <graphic>
                <FontAwesomeIconView glyphName="LIGHTBULB_ALT" styleClass="button-icon"/>
            </graphic>
        </Button>
        <Button fx:id="submitButton" onAction="#handleSubmit" styleClass="btn-submit">
            <graphic>
                <FontAwesomeIconView glyphName="CHECK" styleClass="button-icon"/>
            </graphic>
            Enregistrer
        </Button>
    </HBox>
</VBox>