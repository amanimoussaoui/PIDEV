<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            stylesheets="@../../css/formationsFront.css">



    <!-- Center Content -->
    <!-- Replace the existing FlowPane with this ScrollPane -->
    <center>
        <VBox spacing="20" style="-fx-padding: 20;">
            <!-- Search Bar and Title remain the same -->
            <HBox alignment="CENTER" spacing="10">
                <TextField promptText="Rechercher une formation..." styleClass="search-field"
                           fx:id="searchField"/>
                <Button styleClass="search-button">
                    <ImageView fitHeight="20" fitWidth="20">
                    </ImageView>
                </Button>
            </HBox>

            <Label text="Nos Formations" styleClass="section-title"/>

            <!-- ScrollPane wrapping the FlowPane -->
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
                <FlowPane fx:id="cardsContainer" hgap="20" vgap="20"
                          alignment="TOP_CENTER" prefWrapLength="1200"/>
            </ScrollPane>

            <Button text="Participer" styleClass="participer-btn"
                    fx:id="participerBtn" />

        </VBox>
    </center>
</BorderPane>