<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<?import java.net.URL?>
<VBox xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Agriwise.controllers.Parcelle.ParcelleController">

    <stylesheets>
        <URL value="@../../css/styles.css" />
    </stylesheets>

    <!-- Main Content -->
    <VBox spacing="20" style="-fx-padding: 20; -fx-background-color: #f8f9fa;" HBox.hgrow="ALWAYS">
        <HBox alignment="CENTER_RIGHT" spacing="10">
            <Label text="Vos Parcelles" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1F4E3D;" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="addButton" text="Créer une Parcelle" onAction="#handleAddParcelle" />
        </HBox>

        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    style="-fx-background: transparent; -fx-background-color: transparent;">
            <StackPane>
                <FlowPane fx:id="parcelleContainer"
                          hgap="20" vgap="20" alignment="TOP_CENTER"
                          style="-fx-padding: 20 0 0 0;" />
            </StackPane>
        </ScrollPane>
    </VBox>
</VBox>