<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Agriwise.controllers.Parcelle.RendementController"
            stylesheets="@../../css/rendement.css"
            styleClass="main-container">

    <top>
        <!-- Modern Header with gradient background -->
        <VBox spacing="15">
            <HBox styleClass="modern-header">
                <HBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                    <Label text="Rendement" styleClass="header-title"/>
                    <Label text="Tableau de Bord" styleClass="header-subtitle"/>
                </HBox>
                <HBox alignment="CENTER_RIGHT">
                    <Label text="AgriWise" styleClass="brand-label"/>
                </HBox>
                <padding>
                    <Insets top="20" right="25" bottom="20" left="25"/>
                </padding>
            </HBox>

            <!-- Redesigned Summary Cards -->
            <HBox styleClass="summary-cards-container">
                <!-- Parcelles Card -->
                <VBox styleClass="modern-card, primary-card">
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <StackPane styleClass="modern-icon-container, primary-icon">
                            <SVGPath content="M3,5v14c0,1.1,0.9,2,2,2h14c1.1,0,2-0.9,2-2V5c0-1.1-0.9-2-2-2H5C3.9,3,3,3.9,3,5z M15,9c0,1.66-1.34,3-3,3 s-3-1.34-3-3s1.34-3,3-3S15,7.34,15,9z M6,17c0-2,4-3.1,6-3.1s6,1.1,6,3.1v1H6V17z"
                                     styleClass="modern-icon"/>
                        </StackPane>
                        <VBox spacing="5">
                            <Label text="Parcelles" styleClass="modern-card-label"/>
                            <Label fx:id="totalParcellesLabel" text="0" styleClass="modern-card-value"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Cultures Card -->
                <VBox styleClass="modern-card, secondary-card">
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <StackPane styleClass="modern-icon-container, secondary-icon">
                            <SVGPath content="M12,22c4.97,0,9-4.03,9-9c-4.97,0-9,4.03-9,9c0,4.97,4.03,9,9,9C21,26.97,16.97,22,12,22z M5.6,10.25c0,1.38,1.12,2.5,2.5,2.5 s2.5-1.12,2.5-2.5c0-1.38-1.12-2.5-2.5-2.5S5.6,8.87,5.6,10.25z M17.5,10.25c1.38,0,2.5-1.12,2.5-2.5c0-1.38-1.12-2.5-2.5-2.5 s-2.5,1.12-2.5,2.5C15,9.13,16.12,10.25,17.5,10.25z"
                                     styleClass="modern-icon"/>
                        </StackPane>
                        <VBox spacing="5">
                            <Label text="Cultures" styleClass="modern-card-label"/>
                            <Label fx:id="totalCulturesLabel" text="0" styleClass="modern-card-value"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Récoltes Card -->
                <VBox styleClass="modern-card, accent-card">
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <StackPane styleClass="modern-icon-container, accent-icon">
                            <SVGPath content="M17.66,8L12,2.35L6.34,8C4.78,9.56,4,11.64,4,13.64s0.78,4.11,2.34,5.67s3.61,2.35,5.66,2.35s4.1-0.79,5.66-2.35 S20,15.64,20,13.64S19.22,9.56,17.66,8z M6,14c0.01-2,0.62-3.27,1.76-4.4L12,5.27l4.24,4.38C17.38,10.77,17.99,12,18,14 H6z"
                                     styleClass="modern-icon"/>
                        </StackPane>
                        <VBox spacing="5">
                            <Label text="Récoltes" styleClass="modern-card-label"/>
                            <Label fx:id="totalRecoltesLabel" text="0" styleClass="modern-card-value"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Activités Card -->
                <VBox styleClass="modern-card, warning-card">
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <StackPane styleClass="modern-icon-container, warning-icon">
                            <SVGPath content="M19,3h-4.18C14.4,1.84,13.3,1,12,1c-1.3,0-2.4,0.84-2.82,2H5C3.9,3,3,3.9,3,5v14c0,1.1,0.9,2,2,2h14c1.1,0,2-0.9,2-2 V5C21,3.9,20.1,3,19,3z M12,3c0.55,0,1,0.45,1,1s-0.45,1-1,1s-1-0.45-1-1S11.45,3,12,3z M14,17H7v-2h7V17z M17,13H7v-2h10V13z M17,9H7V7h10V9z"
                                     styleClass="modern-icon"/>
                        </StackPane>
                        <VBox spacing="5">
                            <Label text="Activités" styleClass="modern-card-label"/>
                            <Label fx:id="totalActivitesLabel" text="0" styleClass="modern-card-value"/>
                        </VBox>
                    </HBox>
                </VBox>

            </HBox>
        </VBox>
    </top>

    <center>
        <!-- Redesigned Tab Panel with Scrolling for Extra Content -->
        <TabPane fx:id="tabPane" styleClass="modern-tabs" tabClosingPolicy="UNAVAILABLE">
            <Tab text="Parcelles">
                <ScrollPane fitToWidth="true" styleClass="content-scroll-pane">
                    <VBox spacing="20" styleClass="tab-content">
                        <!-- Charts will be added here programmatically -->
                    </VBox>
                </ScrollPane>
            </Tab>
            <Tab text="Cultures">
                <ScrollPane fitToWidth="true" styleClass="content-scroll-pane">
                    <VBox spacing="20" styleClass="tab-content">
                        <!-- Charts will be added here programmatically -->
                    </VBox>
                </ScrollPane>
            </Tab>
            <Tab text="Récoltes">
                <ScrollPane fitToWidth="true" styleClass="content-scroll-pane">
                    <VBox spacing="20" styleClass="tab-content">
                        <!-- Charts will be added here programmatically -->
                    </VBox>
                </ScrollPane>
            </Tab>
            <Tab text="Activités">
                <ScrollPane fitToWidth="true" styleClass="content-scroll-pane">
                    <VBox spacing="20" styleClass="tab-content">
                        <!-- Charts will be added here programmatically -->
                    </VBox>
                </ScrollPane>
            </Tab>
        </TabPane>
    </center>

    <padding>
        <Insets bottom="20" left="20" right="20" top="20"/>
    </padding>
</BorderPane>