<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #f0f8ff;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Agriwise.controllers.Utilisateur.Updateuser">

    <children>

        <!-- Input Fields -->
        <TextField fx:id="upnom" layoutX="300.0" layoutY="98.0" style="-fx-font-size: 14px;" />
        <TextField fx:id="upprenom" layoutX="301.0" layoutY="147.0" style="-fx-font-size: 14px;" />
        <TextField fx:id="upemail" layoutX="301.0" layoutY="200.0" style="-fx-font-size: 14px;" />

        <!-- Labels -->
        <Label layoutX="131.0" layoutY="102.0" style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Nom" />
        <Label layoutX="131.0" layoutY="151.0" style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Prénom" />
        <Label layoutX="131.0" layoutY="204.0" style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Email" />
        <Label layoutX="131.0" layoutY="252.0" style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Rôle(s)" />
        <Label fx:id="upuser" layoutX="200.0" layoutY="37.0" style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Modification de l'utilisateur" />

        <!-- Checkboxes -->
        <CheckBox fx:id="uproleadmin" layoutX="253.0" layoutY="252.0" mnemonicParsing="false" style="-fx-font-size: 13px;" text="Admin" />
        <CheckBox fx:id="uproleagri" layoutX="337.0" layoutY="252.0" mnemonicParsing="false" style="-fx-font-size: 13px;" text="Agriculteur" />
        <CheckBox fx:id="uproleclient" layoutX="439.0" layoutY="252.0" mnemonicParsing="false" style="-fx-font-size: 13px;" text="Client" />

        <!-- Modifier Button -->
        <Button fx:id="btnmodifier" layoutX="260.0" layoutY="319.0" mnemonicParsing="false" onAction="#update" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 5;" text="Modifier" />

    </children>
</AnchorPane>
