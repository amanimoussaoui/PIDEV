<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.web.WebView?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.AjouterTerrain"
            stylesheets="@/values/style.css">

   <center>
      <VBox alignment="CENTER" spacing="20" style="-fx-background-color: rgba(255, 255, 255, 0.9); -fx-background-radius: 10; -fx-padding: 30;">
         <!-- Titre -->
         <Label text="Ajouter Nouveau Terrain" styleClass="form-title"/>

         <!-- Formulaire avec ScrollPane -->
         <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
            <content>
               <GridPane hgap="15" vgap="20" prefWidth="700">
                  <columnConstraints>
                     <ColumnConstraints prefWidth="150" halignment="RIGHT"/>
                     <ColumnConstraints prefWidth="550"/>
                  </columnConstraints>

                  <!-- Ligne 0 - Carte -->
                  <!-- Ligne 0 - Localisation -->
                  <Label text="Localisation*:" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                  <TextField fx:id="txtLocalisation" promptText="Cliquez sur la carte pour sélectionner"
                             styleClass="form-field" GridPane.rowIndex="0" GridPane.columnIndex="1" editable="false">
                     <tooltip>
                        <Tooltip text="Sélectionnez un emplacement sur la carte"/>
                     </tooltip>
                  </TextField>
                  <VBox GridPane.rowIndex="0" GridPane.columnIndex="1" spacing="10">
                     <WebView fx:id="mapView" prefHeight="400" prefWidth="550"
                              style="-fx-border-color: #4CAF50; -fx-border-width: 2px; -fx-border-radius: 5px;"/>
                     <HBox spacing="10" alignment="CENTER">
                        <TextField fx:id="txtLatitude" promptText="Latitude" editable="false"
                                   styleClass="coord-field" prefWidth="250"/>
                        <TextField fx:id="txtLongitude" promptText="Longitude" editable="false"
                                   styleClass="coord-field" prefWidth="250"/>
                     </HBox>
                  </VBox>

                  <!-- Ligne 1 - Longueur -->
                  <Label text="Longueur (m)*:" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                  <TextField fx:id="txtLongueur" promptText="ex: 20" styleClass="form-field"
                             onKeyReleased="#calculerSuperficie" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                  <!-- Ligne 2 - Largeur -->
                  <Label text="Largeur (m)*:" styleClass="form-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                  <TextField fx:id="txtLargeur" promptText="ex: 15" styleClass="form-field"
                             onKeyReleased="#calculerSuperficie" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                  <!-- Ligne 3 - Superficie -->
                  <Label text="Superficie (m²):" styleClass="form-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                  <TextField fx:id="txtSuperficie" editable="false" styleClass="form-field"
                             GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                  <!-- Ligne 4 - Prix -->
                  <Label text="Prix (DT)*:" styleClass="form-label" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                  <TextField fx:id="txtPrix" promptText="Nombre décimal" styleClass="form-field"
                             GridPane.rowIndex="4" GridPane.columnIndex="1">
                     <tooltip>
                        <Tooltip text="Doit être un nombre valide (ex: 250000.99)"/>
                     </tooltip>
                  </TextField>

                  <!-- Ligne 5 - Description -->
                  <Label text="Description*:" styleClass="form-label" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                  <TextArea fx:id="txtDescription" promptText="Minimum 10 caractères"
                            GridPane.rowIndex="5" GridPane.columnIndex="1"
                            wrapText="true" prefRowCount="3" styleClass="form-field">
                     <tooltip>
                        <Tooltip text="Description détaillée (10 caractères minimum)"/>
                     </tooltip>
                  </TextArea>

                  <!-- Ligne 6 - Image -->
                  <Label text="Image:" styleClass="form-label" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                  <VBox spacing="10" GridPane.rowIndex="6" GridPane.columnIndex="1">
                     <HBox spacing="10" alignment="CENTER_LEFT">
                        <Button fx:id="btnChoisirImage" text="Parcourir..." onAction="#choisirImage"
                                styleClass="browse-button"/>
                        <Label fx:id="lblFileName" text="Aucune image sélectionnée" styleClass="file-label"/>
                     </HBox>
                     <ImageView fx:id="imageView" fitHeight="150" fitWidth="200" preserveRatio="true"
                                styleClass="image-preview"/>
                  </VBox>
               </GridPane>
            </content>
         </ScrollPane>

         <!-- Bouton Valider -->
         <Button fx:id="btnAjouter" text="Enregistrer le Terrain" onAction="#ajouterTerrain"
                 styleClass="submit-button"/>

         <Label text="* Champs obligatoires" styleClass="required-fields-label"/>
      </VBox>
   </center>
</BorderPane>