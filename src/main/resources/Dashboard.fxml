<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="549.0" prefWidth="825.0" style="-fx-background-color: linear-gradient(to bottom right, #e0f7fa, #ffffff);" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.Dashboard">

    <children>

        <!-- User Table -->
        <TableView fx:id="tbuserlist" layoutX="89.0" layoutY="75.0" prefHeight="335.0" prefWidth="645.0" style="-fx-font-size: 13px; -fx-border-color: #90caf9; -fx-border-radius: 5;">
            <columns>
                <TableColumn fx:id="tbid" prefWidth="25.5999755859375" text="ID" />
                <TableColumn fx:id="tbnom" prefWidth="62.39996337890625" text="Nom" />
                <TableColumn fx:id="tbprenom" prefWidth="108.79997253417969" text="Prénom" />
                <TableColumn fx:id="tbemail" prefWidth="123.20001220703125" text="Email" />
                <TableColumn fx:id="tbrole" prefWidth="199.20001220703125" text="Rôle" />
                <TableColumn fx:id="tbdinscription" prefWidth="120.00006103515625" text="Date d'inscription" />
            </columns>
        </TableView>

        <!-- Buttons -->
        <Button layoutX="98.0" layoutY="429.0" mnemonicParsing="false" onAction="#updateuser" style="-fx-background-color: #42a5f5; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Modifier" />

        <Button layoutX="385.0" layoutY="429.0" mnemonicParsing="false" onAction="#adduser" prefHeight="26.0" prefWidth="71.0" style="-fx-background-color: #66bb6a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Ajouter" />

        <Button layoutX="670.0" layoutY="430.0" mnemonicParsing="false" onAction="#deleteuser" style="-fx-background-color: #ef5350; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Supprimer" />
      <Button fx:id="btnmainmenu" layoutX="301.0" layoutY="503.0" mnemonicParsing="false" onAction="#redirecttomenu" prefHeight="26.0" prefWidth="235.0" text="Menu" />

    </children>
</AnchorPane>
