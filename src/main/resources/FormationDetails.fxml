<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml" xmlns="http://javafx.com/javafx/21"
            fx:controller="tn.esprit.controllers.FormationDetailsController"
            stylesheets="formationdetails.css">

    <!-- Sidebar à gauche (copiée depuis ListFormationsFront.fxml) -->
    <top>
        <HBox alignment="TOP_LEFT" style="-fx-padding: 20;">
            <Label text="AgriWise" style="-fx-font-size: 32px; -fx-text-fill: #28a745; -fx-font-weight: bold;"/>
        </HBox>
    </top>
    <!-- Sidebar (vide ou à compléter plus tard) -->
    <left>
        <VBox spacing="15" style="-fx-padding: 20;">
            <!-- Sidebar items ici si besoin -->
        </VBox>
    </left>

    <!-- Centre (détails de la formation) -->
    <center>
        <VBox spacing="20" style="-fx-padding: 30;">
            <HBox spacing="30">
                <!-- Image de la formation -->
                <VBox>
                    <Label text="Image de formation" style="-fx-font-size: 18px; -fx-text-fill: #000000; -fx-font-weight: bold;"/>
                    <ImageView fx:id="imageView" fitWidth="300" fitHeight="200" preserveRatio="true"/>
                </VBox>

                <!-- Informations -->
                <VBox spacing="10">
                    <Label fx:id="titleLabel" style="-fx-font-size: 24px; -fx-text-fill: green; -fx-font-weight: bold;"/>

                    <HBox spacing="10">
                        <Label text="Description :" style="-fx-font-weight: bold; -fx-text-fill: #28a745;"/>
                        <Label fx:id="descriptionLabel" wrapText="true" styleClass="description-label"/>
                    </HBox>

                    <HBox spacing="10">
                        <Label text="Date :" style="-fx-font-weight: bold; -fx-text-fill: #28a745;"/>
                        <Label fx:id="dateLabel" styleClass="date-label"/>
                    </HBox>

                    <HBox spacing="10">
                        <Label text="Prix :" style="-fx-font-weight: bold; -fx-text-fill: #28a745;"/>
                        <Label fx:id="prixLabel" styleClass="prix-label"/>
                    </HBox>
                    <Button text="Retour à la liste" onAction="#retourALaListe"
                            style="-fx-background-color: green; -fx-text-fill: white;"/>
                </VBox>
            </HBox>

            <VBox spacing="10">
                <!-- Sous-titre -->
                <Label text="Pourquoi choisir les formations AgriWise ?"
                       styleClass="section-title" />

                <!-- Paragraphe 1 -->
                <Label wrapText="true"
                       text="Les formations proposées par AgriWise sont conçues pour répondre aux besoins spécifiques des agriculteurs et des professionnels du secteur agricole. Grâce à une approche pratique et des contenus adaptés aux réalités du terrain, chaque formation vous permet de renforcer vos compétences et d'améliorer vos pratiques agricoles."
                       styleClass="extra-info" />

                <!-- Paragraphe 2 -->
                <Label wrapText="true"
                       text="Nos formations couvrent des domaines variés tels que la gestion des cultures, l’agriculture durable, la technologie agricole et bien plus encore. Elles sont animées par des experts du secteur et offrent une combinaison idéale de théorie et d’applications pratiques."
                       styleClass="extra-info" />

                <!-- Paragraphe 3 -->
                <Label wrapText="true"
                       text="En choisissant AgriWise, vous bénéficiez non seulement d’un apprentissage de qualité, mais aussi de la possibilité de recevoir un certificat de participation, attestant de vos nouvelles compétences acquises. De plus, chaque formation est accessible à tous, des débutants aux professionnels expérimentés."
                       styleClass="extra-info" />

                <!-- Paragraphe 4 -->
                <Label wrapText="true"
                       text="Rejoignez-nous et faites avancer vos compétences agricoles avec AgriWise !"
                       styleClass="extra-info" />
            </VBox>

        </VBox>
    </center>
</BorderPane>

