<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.paint.*?>
<?import javafx.scene.shape.*?>

<AnchorPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.FaireCandidature"
            stylesheets="@/values/candidature.css"
            style="-fx-background-color: #f8f9fa;">


    <!-- Conteneur principal avec ombre portée -->
    <VBox alignment="TOP_CENTER" spacing="25" style="-fx-background-color: transparent;"
          AnchorPane.topAnchor="30" AnchorPane.bottomAnchor="30"
          AnchorPane.leftAnchor="30" AnchorPane.rightAnchor="30">

        <!-- En-tête avec icône et titre -->
        <HBox alignment="CENTER" spacing="15">
            <ImageView fitHeight="40" fitWidth="40" preserveRatio="true">
                <Image url="@/images/contract-icon.png"/>
            </ImageView>
            <Label text="Formulaire de Candidature" styleClass="header-title">
                <effect>
                    <DropShadow color="#2e7d32" radius="0" spread="0.3" blurType="ONE_PASS_BOX"/>
                </effect>
            </Label>
        </HBox>

        <!-- Conteneur pour formulaire + tableau -->
        <HBox spacing="40" alignment="TOP_CENTER">
            <!-- Formulaire avec carte élégante -->
            <VBox spacing="20" styleClass="form-card">
                <Label text="Détails de la Candidature" styleClass="section-title"/>

                <GridPane hgap="15" vgap="15" style="-fx-padding: 0 10 10 10;">
                    <columnConstraints>
                        <ColumnConstraints minWidth="120" halignment="RIGHT"/>
                        <ColumnConstraints minWidth="250"/>
                    </columnConstraints>

                    <!-- Champs du formulaire -->
                    <Label text="Date de début:" styleClass="form-label" GridPane.rowIndex="0"/>
                    <DatePicker fx:id="dateDebutPicker" styleClass="form-date-picker" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Date de fin:" styleClass="form-label" GridPane.rowIndex="1"/>
                    <DatePicker fx:id="dateFinPicker" styleClass="form-date-picker" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="But:" styleClass="form-label" GridPane.rowIndex="2"/>
                    <TextArea fx:id="butArea" prefRowCount="3" wrapText="true" styleClass="form-textarea" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="Montant (DT):" styleClass="form-label" GridPane.rowIndex="3"/>
                    <HBox spacing="5" alignment="CENTER_LEFT" GridPane.rowIndex="3" GridPane.columnIndex="1">
                        <TextField fx:id="montantField" styleClass="form-field disabled" editable="false"/>
                        <Label text="DT" styleClass="currency-label"/>
                    </HBox>

                    <Label text="État:" styleClass="form-label" GridPane.rowIndex="4"/>
                    <TextField fx:id="etatField" styleClass="form-field disabled" text="En attente" editable="false" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                </GridPane>

                <!-- Section recommandation -->
                <VBox spacing="5">
                    <Label text="Recommandation:" styleClass="form-label"/>
                    <TextArea fx:id="recommandationArea" prefRowCount="3" wrapText="true"
                              styleClass="form-textarea disabled" editable="false"/>
                </VBox>

                <!-- Boutons d'actions avec espacement amélioré -->
                <FlowPane alignment="CENTER" hgap="15" vgap="10" style="-fx-padding: 10 0 0 0;">
                    <Button onAction="#modifierCandidature" styleClass="action-button edit">
                        <graphic>
                            <ImageView fitHeight="20" fitWidth="20" pickOnBounds="true" preserveRatio="true">
                                <Image url="@/images/edit-icon.png"/>
                            </ImageView>
                        </graphic>
                        <text>Modifier</text>
                    </Button>

                    <Button onAction="#supprimerCandidature" styleClass="action-button delete">
                        <graphic>
                            <ImageView fitHeight="20" fitWidth="20" pickOnBounds="true" preserveRatio="true">
                                <Image url="@/images/delete-icon.png"/>
                            </ImageView>
                        </graphic>
                        <text>Supprimer</text>
                    </Button>

                    <Button onAction="#genererRecommandation" styleClass="action-button recommend">
                        <graphic>
                            <ImageView fitHeight="20" fitWidth="20" pickOnBounds="true" preserveRatio="true">
                                <Image url="@/images/recommend-icon.png"/>
                            </ImageView>
                        </graphic>
                        <text>Recommandation</text>
                    </Button>

                    <Button onAction="#validerCandidature" styleClass="action-button submit">
                        <graphic>
                            <ImageView fitHeight="20" fitWidth="20" pickOnBounds="true" preserveRatio="true">
                                <Image url="@/images/save-icon.png"/>
                            </ImageView>
                        </graphic>
                        <text>Soumettre</text>
                    </Button>
                </FlowPane>
            </VBox>

            <!-- Tableau des candidatures avec style amélioré -->
            <VBox spacing="15" styleClass="table-card">
                <Label text="Historique des Candidatures" styleClass="section-title"/>

                <TableView fx:id="tableCandidatures" styleClass="data-table">
                    <columns>
                        <TableColumn fx:id="colDateDebut" text="Date Début" styleClass="table-column" prefWidth="110"/>
                        <TableColumn fx:id="colDateFin" text="Date Fin" styleClass="table-column" prefWidth="110"/>
                        <TableColumn fx:id="colBut" text="But" styleClass="table-column" prefWidth="180"/>
                        <TableColumn fx:id="colPrixTerrain" text="Prix (DT)" styleClass="table-column numeric" prefWidth="90"/>
                        <TableColumn fx:id="colEtat" text="État" styleClass="table-column status" prefWidth="100"/>
                    </columns>
                </TableView>
            </VBox>
        </HBox>
    </VBox>
</AnchorPane>