<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #f5f5f5; -fx-font-family: 'Segoe UI';" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.Agriwise3A42.Controllers.ProfileScene">
   <children>
      <BorderPane layoutX="238.0" layoutY="6.0" prefHeight="385.0" prefWidth="347.0">
         <center>
            <AnchorPane prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
               <children>
                  <Label layoutX="49.0" layoutY="27.0" style="-fx-font-weight: bold; -fx-text-fill: #333;" text="Prenom" />
                  <Label layoutX="42.0" layoutY="67.0" style="-fx-font-weight: bold; -fx-text-fill: #333;" text="Téléphone" />
                  <Label layoutX="49.0" layoutY="104.0" style="-fx-font-weight: bold; -fx-text-fill: #333;" text="Adresse" />
                  <Label layoutX="21.0" layoutY="148.0" style="-fx-font-weight: bold; -fx-text-fill: #333;" text="Date de naissance" />
                  <Label layoutX="62.0" layoutY="251.0" style="-fx-font-weight: bold; -fx-text-fill: #333;" text="Bio" />

                  <TextField fx:id="profileprenom" layoutX="144.0" layoutY="23.0" style="-fx-background-radius: 5; -fx-padding: 5;" />
                  <TextField fx:id="telephoneprofile" layoutX="144.0" layoutY="63.0" style="-fx-background-radius: 5; -fx-padding: 5;" />
                  <TextField fx:id="adresseprofile" layoutX="144.0" layoutY="100.0" style="-fx-background-radius: 5; -fx-padding: 5;" />
                  <TextField fx:id="bioprofile" alignment="TOP_LEFT" layoutX="141.0" layoutY="241.0" prefHeight="106.0" prefWidth="150.0" style="-fx-background-radius: 5; -fx-padding: 5;" />
                  <DatePicker fx:id="calanderprofile" layoutX="137.0" layoutY="140.0" style="-fx-background-radius: 5; -fx-padding: 5;" />
                  <Label layoutX="60.0" layoutY="201.0" style="-fx-font-weight: bold; -fx-text-fill: #333;" text="Age" />
                  <Label fx:id="ageshow" layoutX="205.0" layoutY="201.0" style="-fx-font-weight: bold; -fx-text-fill: #333;" />
               </children>
            </AnchorPane>
         </center>
      </BorderPane>

      <Button fx:id="btnupdateprofile" layoutX="70.0" layoutY="297.0" mnemonicParsing="false" onAction="#updateprofile" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold;" text="Modifier" />

      <ImageView fx:id="profilepicture" fitHeight="150.0" fitWidth="200.0" layoutX="21.0" layoutY="39.0" onMouseClicked="#handleImageClick" pickOnBounds="true" preserveRatio="true" style="-fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 10, 0, 0, 5);                   -fx-border-color: #cccccc;                   -fx-border-width: 2;                   -fx-border-radius: 10;                   -fx-background-radius: 10;" />
   </children>
</AnchorPane>
