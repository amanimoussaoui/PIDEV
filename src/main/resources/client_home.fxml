<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="tn.esprit.controllers.ClientHomeController"
      alignment="CENTER" spacing="20" 
      style="-fx-background-color: white;">
      
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    
    <Label text="Espace Client Agriwise" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2e8b57;">
        <font>
            <Font name="System Bold" size="28.0"/>
        </font>
    </Label>
    
    <Label text="Gérez vos matériels et réservations" style="-fx-font-size: 16px; -fx-text-fill: #555555;"/>
    
    <HBox spacing="30" alignment="CENTER" style="-fx-padding: 30 0 0 0;">
        <VBox alignment="CENTER" style="-fx-padding: 15; -fx-background-color: #f9f9f9; -fx-background-radius: 5; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>
            <Label text="Ajouter Matériel" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2e8b57;"/>
            <Label text="Enregistrez votre nouveau matériel" style="-fx-text-fill: #555555; -fx-wrap-text: true;" textAlignment="CENTER"/>
            <Button fx:id="addMaterialBtn" text="Ajouter" onAction="#goToAddMaterial" 
                    style="-fx-background-color: #2e8b57; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 3;">
                <padding>
                    <Insets top="8" right="15" bottom="8" left="15"/>
                </padding>
                <VBox.margin>
                    <Insets top="10"/>
                </VBox.margin>
            </Button>
        </VBox>
        
        <VBox alignment="CENTER" style="-fx-padding: 15; -fx-background-color: #f9f9f9; -fx-background-radius: 5; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>
            <Label text="Liste des Matériels" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2e8b57;"/>
            <Label text="Consultez vos matériels enregistrés" style="-fx-text-fill: #555555; -fx-wrap-text: true;" textAlignment="CENTER"/>
            <Button fx:id="listMaterialBtn" text="Voir la liste" onAction="#goToMaterialList" 
                    style="-fx-background-color: #2e8b57; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 3;">
                <padding>
                    <Insets top="8" right="15" bottom="8" left="15"/>
                </padding>
                <VBox.margin>
                    <Insets top="10"/>
                </VBox.margin>
            </Button>
        </VBox>
        
        <VBox alignment="CENTER" style="-fx-padding: 15; -fx-background-color: #f9f9f9; -fx-background-radius: 5; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>
            <Label text="Réserver une Machine" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2e8b57;"/>
            <Label text="Réservez une machine agricole" style="-fx-text-fill: #555555; -fx-wrap-text: true;" textAlignment="CENTER"/>
            <Button fx:id="reserveMachineBtn" text="Réserver" onAction="#goToReserveMachine" 
                    style="-fx-background-color: #2e8b57; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 3;">
                <padding>
                    <Insets top="8" right="15" bottom="8" left="15"/>
                </padding>
                <VBox.margin>
                    <Insets top="10"/>
                </VBox.margin>
            </Button>
        </VBox>
        
        <VBox alignment="CENTER" style="-fx-padding: 15; -fx-background-color: #f9f9f9; -fx-background-radius: 5; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>
            <Label text="Mes Réservations" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2e8b57;"/>
            <Label text="Consultez vos réservations" style="-fx-text-fill: #555555; -fx-wrap-text: true;" textAlignment="CENTER"/>
            <Button fx:id="listReservationsBtn" text="Voir les réservations" onAction="#goToReservationList" 
                    style="-fx-background-color: #2e8b57; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 3;">
                <padding>
                    <Insets top="8" right="15" bottom="8" left="15"/>
                </padding>
                <VBox.margin>
                    <Insets top="10"/>
                </VBox.margin>
            </Button>
        </VBox>
    </HBox>
    
</VBox> 