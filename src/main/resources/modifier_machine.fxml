<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="tn.esprit.controllers.EditMachineController"
      spacing="15" style="-fx-background-color: white;">
    
    <padding>
        <Insets top="30" right="50" bottom="30" left="50"/>
    </padding>
    
    <Label text="Modifier la Machine" 
           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2196f3;">
        <VBox.margin>
            <Insets bottom="20"/>
        </VBox.margin>
    </Label>
    
    <GridPane hgap="20" vgap="15" style="-fx-background-color: #f5f5f5; -fx-background-radius: 5; -fx-padding: 20;">
        <columnConstraints>
            <ColumnConstraints minWidth="120" />
            <ColumnConstraints minWidth="300" />
        </columnConstraints>
        
        <!-- ID -->
        <Label text="ID:" GridPane.rowIndex="0" GridPane.columnIndex="0" 
               style="-fx-font-weight: bold;"/>
        <TextField fx:id="idField" promptText="ID de la machine" 
                  GridPane.rowIndex="0" GridPane.columnIndex="1" editable="false" 
                  style="-fx-background-color: #f5f5f5;"/>
        
        <!-- Nom -->
        <Label text="Nom:" GridPane.rowIndex="1" GridPane.columnIndex="0" 
               style="-fx-font-weight: bold;"/>
        <TextField fx:id="nomField" promptText="Saisir le nom de la machine" 
                  GridPane.rowIndex="1" GridPane.columnIndex="1" />
        
        <!-- Description -->
        <Label text="Description:" GridPane.rowIndex="2" GridPane.columnIndex="0" 
               style="-fx-font-weight: bold;"/>
        <TextArea fx:id="descriptionField" promptText="Saisir la description de la machine" 
                 GridPane.rowIndex="2" GridPane.columnIndex="1" prefHeight="80"/>
        
        <!-- Prix -->
        <Label text="Prix:" GridPane.rowIndex="3" GridPane.columnIndex="0" 
               style="-fx-font-weight: bold;"/>
        <TextField fx:id="prixField" promptText="Saisir le prix de la machine" 
                  GridPane.rowIndex="3" GridPane.columnIndex="1" />
        
        <!-- État -->
        <Label text="État:" GridPane.rowIndex="4" GridPane.columnIndex="0" 
               style="-fx-font-weight: bold;"/>
        <ComboBox fx:id="etatComboBox" promptText="Sélectionner l'état" 
                 GridPane.rowIndex="4" GridPane.columnIndex="1" prefWidth="300"/>
        
        <!-- Disponibilité -->
        <Label text="Disponibilité:" GridPane.rowIndex="5" GridPane.columnIndex="0" 
               style="-fx-font-weight: bold;"/>
        <ComboBox fx:id="dispoComboBox" promptText="Sélectionner la disponibilité" 
                 GridPane.rowIndex="5" GridPane.columnIndex="1" prefWidth="300"/>
        
        <!-- Date Maintenance -->
        <Label text="Date Maintenance:" GridPane.rowIndex="6" GridPane.columnIndex="0" 
               style="-fx-font-weight: bold;"/>
        <DatePicker fx:id="dateMaintenancePicker" promptText="Sélectionner la date" 
                   GridPane.rowIndex="6" GridPane.columnIndex="1" prefWidth="300"/>
        
        <!-- ID Utilisateur -->
        <Label text="ID Utilisateur:" GridPane.rowIndex="7" GridPane.columnIndex="0" 
               style="-fx-font-weight: bold;"/>
        <HBox GridPane.rowIndex="7" GridPane.columnIndex="1" alignment="CENTER_LEFT" spacing="10">
            <TextField fx:id="idUserField" promptText="Saisir l'ID de l'utilisateur" prefWidth="300"/>
            <Label fx:id="userHelpLabel" text="(Utilisez ID 1 pour tester)" 
                   style="-fx-text-fill: #888888; -fx-font-style: italic;"/>
        </HBox>
    </GridPane>
    
    <HBox spacing="15" alignment="CENTER_RIGHT">
        <VBox.margin>
            <Insets top="20"/>
        </VBox.margin>
        
        <Button fx:id="cancelBtn" text="Annuler" onAction="#handleCancel" 
                style="-fx-background-color: #f0f0f0; -fx-text-fill: #333333; -fx-cursor: hand;">
            <padding>
                <Insets top="8" right="25" bottom="8" left="25"/>
            </padding>
        </Button>
        
        <Button fx:id="updateBtn" text="Mettre à jour" onAction="#handleUpdate" 
                style="-fx-background-color: #2196f3; -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold;">
            <padding>
                <Insets top="8" right="25" bottom="8" left="25"/>
            </padding>
        </Button>
    </HBox>
    
</VBox> 