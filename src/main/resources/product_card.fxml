<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane fx:id="cardPane" prefHeight="200.0" prefWidth="200.0" styleClass="card,shadow" stylesheets="@mainFormDesign.css" xmlns="http://javafx.com/javafx/21.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.ProductCardController">
    <children>
        <VBox alignment="CENTER" prefHeight="200.0" prefWidth="200.0" spacing="5.0">
            <children>
                <!-- Image du produit -->
                <ImageView fx:id="productImage" fitHeight="102.0" fitWidth="130.0" pickOnBounds="true" preserveRatio="true" />

                <!-- Nom du produit -->
                <Label fx:id="productName" text="Nom du produit">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>

                <!-- Prix du produit -->
                <Label fx:id="productPrice" text="0 DT">
                    <font>
                        <Font name="System" size="12.0" />
                    </font>
                </Label>

                <!-- Stock du produit -->
                <Label fx:id="productStock" text="Stock: 0">
                    <font>
                        <Font name="System" size="12.0" />
                    </font>
                </Label>

                <!-- Boutons d'action avec icônes -->
                <HBox alignment="CENTER" spacing="10.0">
                    <children>
                        <!-- Bouton Modifier -->
                        <Button fx:id="editButton" onAction="#editProduct" prefHeight="30.0" prefWidth="30.0" styleClass="btn-icon">
                            <graphic>
                                <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                                    <image>
                                        <Image url="@/images/update_icon.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>

                        <!-- Bouton Supprimer -->
                        <Button fx:id="deleteButton" onAction="#deleteProduct" prefHeight="30.0" prefWidth="30.0" styleClass="btn-icon">
                            <graphic>
                                <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                                    <image>
                                        <Image url="@/images/delete_icon.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>

                        <!-- Bouton Détails -->
                        <Button fx:id="detailsButton" onAction="#showDetails" prefHeight="30.0" prefWidth="30.0" styleClass="btn-icon">
                            <graphic>
                                <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                                    <image>
                                        <Image url="@/images/details_icon.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                    </children>
                </HBox>
            </children>
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
        </VBox>
    </children>
</AnchorPane>