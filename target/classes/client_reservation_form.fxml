<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="tn.esprit.controllers.ClientReservationFormController"
      alignment="CENTER" spacing="15" 
      style="-fx-background-color: white;" prefWidth="450" prefHeight="450">
      
    <padding>
        <Insets top="20" right="30" bottom="20" left="30"/>
    </padding>
    
    <Label fx:id="titleLabel" text="Réserver une machine" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2e8b57;">
        <font>
            <Font name="System Bold" size="20.0"/>
        </font>
        <VBox.margin>
            <Insets bottom="10"/>
        </VBox.margin>
    </Label>
    
    <Separator/>
    
    <!-- Informations machine -->
    <GridPane hgap="15" vgap="10">
        <columnConstraints>
            <ColumnConstraints minWidth="100" prefWidth="120" />
            <ColumnConstraints prefWidth="250" hgrow="ALWAYS" />
        </columnConstraints>
        
        <!-- Détails de la machine -->
        <Label text="Machine:" style="-fx-font-weight: bold;" GridPane.rowIndex="0" GridPane.columnIndex="0" />
        <Label fx:id="machineNameLabel" text="Nom de la machine" style="-fx-font-size: 14px;" 
               GridPane.rowIndex="0" GridPane.columnIndex="1" />
        
        <Label text="Marque:" style="-fx-font-weight: bold;" GridPane.rowIndex="1" GridPane.columnIndex="0" />
        <Label fx:id="machineMarqueLabel" text="Marque de la machine" style="-fx-font-size: 14px;" 
               GridPane.rowIndex="1" GridPane.columnIndex="1" />
        
        <Label text="Prix:" style="-fx-font-weight: bold;" GridPane.rowIndex="2" GridPane.columnIndex="0" />
        <Label fx:id="machinePriceLabel" text="Prix par jour" style="-fx-font-size: 14px; -fx-font-weight: bold;" 
               GridPane.rowIndex="2" GridPane.columnIndex="1" />
    </GridPane>
    
    <Separator>
        <VBox.margin>
            <Insets top="5" bottom="5"/>
        </VBox.margin>
    </Separator>
    
    <!-- Formulaire de réservation -->
    <GridPane hgap="15" vgap="15">
        <columnConstraints>
            <ColumnConstraints minWidth="100" prefWidth="120" />
            <ColumnConstraints prefWidth="250" hgrow="ALWAYS" />
        </columnConstraints>
        
        <!-- Date Début -->
        <Label text="Date Début:" style="-fx-font-weight: bold;" GridPane.rowIndex="0" GridPane.columnIndex="0" />
        <DatePicker fx:id="dateDebutPicker" promptText="Sélectionnez la date de début" 
                    GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="250" />
        
        <!-- Date Fin -->
        <Label text="Date Fin:" style="-fx-font-weight: bold;" GridPane.rowIndex="1" GridPane.columnIndex="0" />
        <DatePicker fx:id="dateFinPicker" promptText="Sélectionnez la date de fin" 
                    GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="250" />
        
        <!-- Prix Total (calculé automatiquement) -->
        <Label text="Prix Total:" style="-fx-font-weight: bold;" GridPane.rowIndex="2" GridPane.columnIndex="0" />
        <Label fx:id="totalPriceLabel" text="0 DT" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2e8b57;" 
               GridPane.rowIndex="2" GridPane.columnIndex="1" />
        
        <!-- Message d'information -->
        <Label fx:id="infoLabel" text="Sélectionnez les dates pour calculer le prix total." 
               style="-fx-font-style: italic; -fx-text-fill: #888888;" 
               GridPane.rowIndex="3" GridPane.columnIndex="0" GridPane.columnSpan="2" />
        
        <!-- Erreurs et validations -->
        <Label fx:id="errorLabel" text="" 
               style="-fx-text-fill: #ff4444;" 
               GridPane.rowIndex="4" GridPane.columnIndex="0" GridPane.columnSpan="2" />
    </GridPane>
    
    <Separator>
        <VBox.margin>
            <Insets top="10"/>
        </VBox.margin>
    </Separator>
    
    <HBox spacing="15" alignment="CENTER_RIGHT">
        <Button fx:id="cancelBtn" text="Annuler" onAction="#handleCancel"
                style="-fx-background-color: #e0e0e0; -fx-text-fill: #333333; -fx-cursor: hand;">
            <padding>
                <Insets top="10" right="20" bottom="10" left="20"/>
            </padding>
        </Button>
        
        <Button fx:id="reserveBtn" text="Confirmer la Réservation" onAction="#handleReserve"
                style="-fx-background-color: #2e8b57; -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold;">
            <padding>
                <Insets top="10" right="20" bottom="10" left="20"/>
            </padding>
        </Button>
    </HBox>
</VBox> 