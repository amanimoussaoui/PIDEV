<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="600.0" prefWidth="1100.0" styleClass="panier-background" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.panierController">
    <children>
        <VBox alignment="CENTER" prefHeight="600.0" prefWidth="1100.0" spacing="30.0">
            <!-- Bouton de retour -->
            <HBox alignment="CENTER_LEFT" prefHeight="40.0" prefWidth="1100.0">
                <children>
                    <Button fx:id="backButton" onAction="#returnToMarket" styleClass="back-button" stylesheets="@style.css">
                        <graphic>
                            <ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true">
                                <image>
                                    <Image url="@/images/back_arrow.png" />
                                </image>
                            </ImageView>
                        </graphic>
                        <HBox.margin>
                            <Insets left="30.0" top="20.0" />
                        </HBox.margin>
                    </Button>
                </children>
            </HBox>

            <!-- Titre -->
            <Label styleClass="panier-title" text="Votre Panier">
                <font>
                    <Font name="System Bold" size="32.0" />
                </font>
            </Label>

            <!-- Conteneur principal -->
            <HBox alignment="CENTER" prefHeight="450.0" prefWidth="1100.0" spacing="30.0">
                <!-- Liste des produits (VBox à gauche) -->
                <ScrollPane fitToWidth="true" prefHeight="450.0" prefWidth="750.0" styleClass="cart-scroll">
                    <content>
                        <VBox fx:id="cartItemsVBox" alignment="CENTER" spacing="15.0" styleClass="cart-items-container" />
                    </content>
                </ScrollPane>

                <!-- Total et boutons (à droite) -->
                <VBox alignment="CENTER" prefHeight="450.0" prefWidth="300.0" spacing="25.0" styleClass="total-container">
                    <!-- Image au-dessus du total -->
                    <ImageView fitHeight="120.0" fitWidth="120.0" preserveRatio="true" styleClass="cart-icon">
                        <image>
                            <Image url="@/images/cart_icon.png" />
                        </image>
                    </ImageView>
                    <Label fx:id="totalLabel" styleClass="total-label" text="Total: 0.00 DT" />
                    <Button fx:id="payButton" onAction="#proceedToPayment" prefHeight="50.0" prefWidth="200.0" styleClass="pay-button" text="Payer">
                        <font>
                            <Font name="System Bold" size="16.0" />
                        </font>
                    </Button>
                    <Button fx:id="modifyButton" onAction="#modifyItem" prefHeight="50.0" prefWidth="200.0" styleClass="modify-button" text="Modifier">
                        <font>
                            <Font name="System Bold" size="16.0" />
                        </font>
                    </Button>
                    <Button fx:id="deleteButton" onAction="#deleteItem" prefHeight="50.0" prefWidth="200.0" styleClass="delete-button" text="Supprimer">
                        <font>
                            <Font name="System Bold" size="16.0" />
                        </font>
                    </Button>
                </VBox>
            </HBox>
        </VBox>
    </children>
</AnchorPane>