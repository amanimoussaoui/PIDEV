{% extends 'FrontEnd/front.html.twig' %}

{% block title %}AgriWise | Accueil{% endblock %}
{% block content %}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

<style>
    body {
        background-color: #f4f7fc;
    }
    .container {
        max-width: 1200px;
    }
    h1 {
        color: #B1D182;
        font-size: 2.5rem;
        margin-bottom: 20px;
        animation: fadeIn 1s ease-out;
    }
    table {
        border-radius: 8px;
        overflow: hidden;
        animation: fadeIn 1.5s ease-out;
    }
    table th {
        background-color: #B1D182;
        color: white;
        font-size: 1.1rem;
    }
    table td {
        font-size: 1rem;
    }
    .btn {
        font-size: 1rem;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        padding: 8px 12px;
        border-radius: 4px;
        text-decoration: none;
    }
    .btn:hover {
        opacity: 0.9;
        transform: scale(1.05);
    }
    .update-icon, .delete-icon, .recommend-icon {
        padding: 8px 12px;
        border-radius: 4px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        transition: all 0.3s ease;
        color: white;
    }
    .update-icon {
        background-color: #28a745;
    }
    .delete-icon {
        background-color: #dc3545;
    }
    .recommend-icon {
        background-color: #007bff;
    }
    .update-icon:hover, .delete-icon:hover, .recommend-icon:hover {
        transform: scale(1.1);
    }
    .update-icon i, .delete-icon i, .recommend-icon i {
        margin-right: 5px;
    }
</style>

<div class="container my-5">
    <h1>Liste des Candidatures</h1>
    <div class="table-responsive">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>id</th>
                    <th>idTerrain</th>
                    <th>dateDebut</th>
                    <th>dateFin</th>
                    <th>but</th>
                    <th>montant</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for a in tab_candidature %}
                <tr>
                    <td>{{ a.id }}</td>
                    <td>{{ a.idTerrain.id }}</td>
                    <td>{{ a.dateDebut|date('Y-m-d') }}</td>
                    <td>{{ a.dateFin|date('Y-m-d') }}</td>
                    <td>{{ a.but }}</td>
                    <td>{{ a.montant }}</td>
                    <td class="action-icons">
                        <a href="{{ path('app_updateformcandidature', {'id': a.id}) }}" class="update-icon" title="Modifier">
                            <i class="fa-solid fa-pencil-alt"></i> Modifier
                        </a>
                        <a href="{{ path('app_deletecandidature', {'id': a.id}) }}" class="delete-icon" title="Supprimer"
                           onclick="return confirm('Êtes-vous sûr de vouloir supprimer cette candidature ?')">
                            <i class="fa-solid fa-trash"></i> Supprimer
                        </a>
                        <a href="{{ path('app_recommendation', {'id': a.id}) }}" class="recommend-icon" title="Recommandation">
                            <i class="fa-solid fa-lightbulb"></i> Recommandation
                        </a>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.2/dist/js/bootstrap.bundle.min.js"></script>

{% endblock %}
