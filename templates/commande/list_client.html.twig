{% extends 'FrontEnd/front.html.twig' %}

{% block title %}Liste des Commandes{% endblock %}

{% block content %}

<style>
    /* CONTAINER PRINCIPAL */
    .container {
        max-width: 1000px;
        margin: 30px auto;
        padding: 20px;
        background: #fff;
        border-radius: 10px;
        box-shadow: 0px 4px 15px rgba(0, 0, 0, 0.1);
    }

    /* TITRE */
    h2 {
        text-align: center;
        color: #2c7b2c;
        margin-bottom: 20px;
        font-size: 28px;
        font-weight: bold;
    }

    /* STYLE DES CARDS */
    .card-container {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: 20px;
        margin-top: 20px;
    }

    .card {
        background: #fff;
        border-radius: 10px;
        box-shadow: 0px 4px 15px rgba(0, 0, 0, 0.1);
        padding: 20px;
        transition: transform 0.3s ease;
    }

    .card:hover {
        transform: translateY(-10px);
    }

    .card-header {
        font-size: 18px;
        font-weight: bold;
        color: #2c7b2c;
    }

    .card-body {
        margin-top: 10px;
    }

    .card-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    /* BOUTONS D'ACTIONS */
    .btn-container {
        display: flex;
        gap: 12px;
    }

    .btn-delete, .btn-edit {
        padding: 10px 16px;
        border-radius: 30px; /* Boutons plus arrondis */
        font-size: 14px;
        width: auto;
        height: auto;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.3s ease, background-color 0.3s ease;
        font-weight: 600;
        border: none;
    }

    /* Bouton Supprimer */
    .btn-delete {
        background: #e74c3c;
        color: white;
        box-shadow: 0px 4px 8px rgba(231, 76, 60, 0.4);
    }

    .btn-delete:hover {
        background: #c0392b;
        transform: scale(1.05);
        box-shadow: 0px 8px 12px rgba(231, 76, 60, 0.6);
    }

    /* Bouton Modifier */
    .btn-edit {
        background: #f39c12;
        color: white;
        box-shadow: 0px 4px 8px rgba(243, 156, 18, 0.4);
    }

    .btn-edit:hover {
        background: #e67e22;
        transform: scale(1.05);
        box-shadow: 0px 8px 12px rgba(243, 156, 18, 0.6);
    }

    /* ICÔNES */
    .btn-delete i, .btn-edit i {
        font-size: 16px;
    }

    /* MESSAGE QUAND AUCUNE COMMANDE N'EST TROUVÉE */
    .text-center {
        text-align: center;
        font-style: italic;
        color: #888;
        padding: 15px;
    }
</style>

<!-- CONTENU PRINCIPAL -->
<div class="container">
   <h2 class="mb-3">Bienvenue, {{ utilisateur.nom }} {{ utilisateur.prenom }}! Voici vos commandes</h2>

    

    <div class="card-container">
        {% for commande in commandes %}
            <div class="card">
                <div class="card-header">
                    Commande #{{ commande.id }}
                </div>
                <div class="card-body">
                    <p><strong>Date :</strong> {{ commande.date|date('d/m/Y') }}</p>
                    <p><strong>Adresse :</strong> {{ commande.adresse }}</p>
                    </div>
                <div class="card-footer">
                    <div class="btn-container">
                        <a href="{{ path('commande_edit', {'id': commande.id}) }}" class="btn-edit">
                            <i class="fas fa-edit"></i>
                        </a>
                        <a href="{{ path('commande_delete_client', {'id': commande.id}) }}" class="btn-delete">
                            <i class="fas fa-trash-alt"></i>
                        </a>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="text-center">Aucune commande trouvée.</div>
        {% endfor %}
    </div>
</div>

{% endblock %}
