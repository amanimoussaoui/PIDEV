{% extends 'FrontEnd/front.html.twig' %}

{% block title %}Cultures
{% endblock %}

{% block content %}
	<div class="container mt-4">
		<div class="custom-card shadow-lg border-0 rounded-4 overflow-hidden">
			<div class="custom-card-header p-4 d-flex justify-content-between align-items-center py-4" style="background: linear-gradient(90deg, #1a9738, #1F4E3D);">
				<h5 class="card-title mb-0 text-white fw-semibold">Vos Cultures</h5>
				<a href="{{ path('app_culture_new') }}" class="btn btn-light btn-sm rounded-pill px-3 shadow-sm">
					<i class="bi bi-plus-circle me-1"></i>
					Créer une Culture
				</a>
			</div>

			<div class="custom-card-body p-4">
				{{ form_start(form, {'attr': {'class': 'mb-5'}, 'action': path('app_culture_index')}) }}
				<div class="container">
					<div class="row justify-content-center">
						<div class="col-md-8">
							<div class="input-group input-group shadow-sm">
								{{ form_widget(form.statut, {
                                        'attr': {
                                            'class': 'form-select custom-select',
                                            'style': 'max-width: 150px;'
                                        }
                                    }) }}
								{{ form_widget(form.search, {
                                        'attr': {
                                            'class': 'form-control',
                                            'placeholder': 'Rechercher par nom culture ou parcelle...'
                                        }
                                    }) }}
								<button type="submit" class="btn btn-primary px-4">
									<i class="bi bi-search"></i>
								</button>
								<a href="{{ path('app_culture_index') }}" class="btn btn-light">
									<i class="bi bi-arrow-counterclockwise"></i>
								</a>
							</div>
						</div>
					</div>
				</div>
				{{ form_end(form) }}

				<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
					{% for culture in cultures %}
						<div class="col">
							<div class="parcelle-card h-100 shadow-lg border-2 rounded-4 overflow-hidden hover-scale">
								<div class="parcelle-card-header p-4 bg-light py-3">
									<h6 class="card-title mb-0 fw-semibold">{{ culture.nomCulture }}</h6>
								</div>
								<div class="parcelle-card-body p-4">
									<div class="d-flex flex-column gap-2">
										<div class="d-flex align-items-center">
											<i class="bi bi-calendar me-2 text-primary"></i>
											<span class="text-muted">Date Semis :</span>
											<span class="ms-auto fw-medium">{{ culture.dateSemis ? culture.dateSemis|date('Y-m-d') : '' }}</span>
										</div>
										<div class="d-flex align-items-center">
											<i class="bi bi-clock me-2 text-primary"></i>
											<span class="text-muted">Durée :</span>
											<span class="ms-auto fw-medium">{{ culture.duree }}
												Jours</span>
										</div>
										<div class="d-flex align-items-center">
											<i class="bi bi-info-circle me-2 text-primary"></i>
											<span class="text-muted">Statut :</span>
											{% set badgeColors = {
                                                'en_culture': 'primary',
                                                'terminé': 'success'
                                            } %}
											<span class="ms-auto badge rounded-pill bg-{{ badgeColors[culture.statut] ?? 'secondary' }}">
												{{ culture.statut | capitalize }}
											</span>
										</div>
										<div class="d-flex align-items-center">
											<i class="bi bi-map me-2 text-primary"></i>
											<span class="text-muted">Parcelle :</span>
											<span class="ms-auto fw-medium">{{ culture.parcelle.nom }}</span>
										</div>
									</div>
								</div>
								<div class="parcelle-card-footer p-4 bg-light py-3">
									<div class="d-flex gap-2 justify-content-end">
										<a href="{{ path('app_culture_show', {'id': culture.id}) }}" class="btn btn-info btn-sm rounded-pill" data-bs-toggle="tooltip" title="Voir les détails">
											<i class="bi bi-eye"></i>
										</a>
										<a href="{{ path('app_culture_edit', {'id': culture.id}) }}" class="btn btn-warning btn-sm rounded-pill" data-bs-toggle="tooltip" title="Modifier">
											<i class="bi bi-pencil"></i>
										</a>
										<form action="{{ path('app_culture_delete', {'id': culture.id}) }}" method="post" class="d-inline" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette culture ?');">
											<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ culture.id) }}">
											<button type="submit" class="btn btn-danger btn-sm rounded-pill" data-bs-toggle="tooltip" title="Supprimer">
												<i class="bi bi-trash"></i>
											</button>
										</form>
									</div>
								</div>
							</div>
						</div>
					{% else %}
						<div class="col">
							<div class="alert alert-info border-0 shadow-sm rounded-4 mt-3">
								<i class="bi bi-info-circle me-2"></i>
								Aucune culture trouvée. Essayez de modifier vos critères de recherche ou
								<a href="{{ path('app_culture_new') }}" class="alert-link">créez une nouvelle culture</a>.
							</div>
						</div>
					{% endfor %}
				</div>
                              <div class="d-flex justify-content-center mt-4">
    {{ knp_pagination_render(cultures) }}
</div>
			</div>
		</div>
	</div>
{% endblock %}
