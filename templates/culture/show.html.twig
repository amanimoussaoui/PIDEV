{% extends 'FrontEnd/front.html.twig' %}

{% block title %}Culture
{% endblock %}

{% block content %}
	<div class="container mt-4">
		<div class="glass-card shadow-sm border-0">
			<div class="card-header py-3 px-4" style="background: linear-gradient(90deg, #1a9738, #1F4E3D); border-radius: 12px 12px 0 0;">
				<h5 class="mb-0 text-white"></i>
				Détails de la Culture</h5>
		</div>
		<div class="card-body">
			<div class="row">
				<div class="col-md-3">
					<div class="info-card mb-4">
						<div class="detail-item">
							<i class="bi bi-tag detail-icon"></i>
							<div class="detail-content">
								<h6 class="text-muted">Nom de la Culture</h6>
								<p class="fw-bold mb-0">{{ culture.nomCulture }}</p>
							</div>
						</div>
					</div>
				</div>
				<div class="col-md-3">
					<div class="info-card mb-4">
						<div class="detail-item">
							<i class="lni lni-mapbi bi-calendar-date detail-icon"></i>
							<div class="detail-content">
								<h6 class="text-muted">Date de Semis</h6>
								<p class="fw-bold mb-0">{{ culture.dateSemis ? culture.dateSemis|date('Y-m-d') : '' }}</p>
							</div>
						</div>
					</div>
				</div>

				<div class="col-md-3">
					<div class="info-card mb-4">
						<div class="detail-item">
							<i class="bi bi-clock-history detail-icon"></i>
							<div class="detail-content">
								<h6 class="text-muted">Durée</h6>
								<p class="fw-bold mb-0">{{ culture.duree }}
									Jours</p>
							</div>
						</div>
					</div>
				</div>
				<div class="col-md-3">
					<div class="info-card mb-4">
						<div class="detail-item">
							<i class="bi bi-clipboard2-check detail-icon"></i>
							<div class="detail-content">
								<h6 class="text-muted">Statut</h6>
								<p class="fw-bold mb-0">{{ culture.statut | capitalize }}</p>
							</div>
						</div>
					</div>
				</div>
			</div>

			<div class="row">
				<div class="col-md-12">
					<div class="info-card mb-4">
						<div class="detail-item">
							<i class="bi bi-bar-chart detail-icon"></i>
							<div class="detail-content">
								<div class="row">
									<div class="col-md-9">
										<h6 class="text-muted">Progression de la Culture</h6>
										{% set today = "now"|date('Y-m-d') %}
										{% set dateSemis = culture.dateSemis ? culture.dateSemis|date('Y-m-d') : today %}
										{% set duree = culture.duree %}
										{% set daysElapsed = (today|date('U') - dateSemis|date('U')) / (60 * 60 * 24) %}
										{% set progress = (daysElapsed / duree) * 100 %}

										{% if progress < 0 %}
											{% set progress = 0 %}
											<p class="text-muted mb-2">La culture n'a pas encore commencé.</p>
										{% elseif progress >= 100 %}
											{% set progress = 100 %}
											<p class="text-muted mb-2">La culture est terminée.</p>
										{% else %}
											<p class="text-muted mb-2">Progression:
												{{ progress|round(2) }}%</p>
										{% endif %}
									</div>
								</div>

								<div class="progress">
									<div class="progress-bar" role="progressbar" style="width: {{ progress }}%;" aria-valuenow="{{ progress }}" aria-valuemin="0" aria-valuemax="100"></div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>


			{% if recolte %}
				<div class="row">
					<div class="col-md-12">
						<div class="info-card mb-4">
							<div class="detail-item">
								<i class="bi bi-basket detail-icon"></i>
								<div class="detail-content row align-items-center">
									<div class="col-md-6 d-flex flex-column justify-content-center">
										<h6 class="text-muted">Détails de la Récolte</h6>
										<p class="fw-bold mb-0">Date :
											{{ recolte.dateRecolte|date('d/m/Y') }}</p>
									</div>
									<div class="col-md-5 parcelle-details">
										<p class="text-muted mb-1">
											<i class="bi bi-box"></i>
											Quantité :
											<span class="fw-bold">{{ recolte.quantite }}</span>
											kg
										</p>
										<p class="text-muted mb-1">
											<i class="bi bi-star"></i>
											Qualité :
											{% set badgeColors = {
                                            'Excellente': 'success',
                                            'Bonne': 'info',
                                            'Moyenne': 'warning',
                                            'Médiocre': 'danger',
                                            'Mauvaise': 'secondary'
                                        } %}
											<span class="badge rounded-pill bg-{{ badgeColors[recolte.qualite] ?? 'secondary' }}">
												{{ recolte.qualite | capitalize }}
											</span>
										</p>
										<p class="text-muted mb-1">
											<i class="bi bi-cash-coin"></i>
											Prix Unitaire :
											<span class="fw-bold">{{ recolte.prixUnitaire }}</span>
											TND
										</p>
										<p class="text-muted mb-1">
											<i class="bi bi-calculator"></i>
											Valeur Totale :
											<span class="fw-bold">{{ (recolte.quantite * recolte.prixUnitaire)|number_format(2, ',', ' ') }}</span>
											TND
										</p>
									</div>

									<div class="col-md-1 text-end">
										<a href="{{ path('app_recolte_show', {'id': recolte.id}) }}" class="btn btn-info btn-sm rounded-pill mb-2" data-bs-toggle="tooltip" title="Voir les détails">
											<i class="bi bi-eye"></i>
										</a>
										<a href="{{ path('app_recolte_edit', {'id': recolte.id}) }}" class="btn btn-warning btn-sm rounded-pill mb-2" data-bs-toggle="tooltip" title="Modifier">
											<i class="bi bi-pencil"></i>
										</a>
										<form action="{{ path('app_recolte_delete', {'id': recolte.id}) }}" method="post" class="d-inline" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette récolte ?');">
											<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ recolte.id) }}">
											<button type="submit" class="btn btn-danger btn-sm rounded-pill" data-bs-toggle="tooltip" title="Supprimer">
												<i class="bi bi-trash"></i>
											</button>
										</form>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>

			{% else %}
				<div class="row">
					<div class="col-md-12">
						<div class="info-card mb-4">
							<div class="detail-item">
								<div class="col-md-9">
									<p class="text-muted">Aucune récolte enregistrée pour cette culture.</p>
								</div>
								<div class="col-md-3">
									{% if progress == 100 %}

										<form action="{{ path('app_culture_update_status', {'id': culture.id}) }}" method="post" class="d-inline">
											<input type="hidden" name="_token" value="{{ csrf_token('update_status_' ~ culture.id) }}">
											<button type="submit" class="btn btn-success">
												<i class="bi bi-save"></i>
												Enregistrer une Récolte
											</button>
										</form>
									{% endif %}

								</div>
							</div>
						</div>
					</div>
				</div>
			{% endif %}


			<div class="row">
				<div class="col-md-12">
					<div class="info-card mb-4">
						<div class="detail-item">
							<i class="lni lni-map detail-icon"></i>
							<div class="detail-content row align-items-center">
								<div class="col-md-6 d-flex flex-column justify-content-center">
									<h6 class="text-muted">Parcelle</h6>
									<a href="{{ path('app_parcelle_show', {'id': culture.parcelle.id}) }}" class="fw-bold mb-0">{{ culture.parcelle.nom }}</a>
								</div>

								<div class="col-md-6 parcelle-details">
									<p class="text-muted mb-1">
										<i class="bi bi-rulers"></i>
										Superficie:
										{{ culture.parcelle.superficie | number_format(2, ',', ' ') }}
										m²</p>
									<p class="text-muted mb-1">
										<i class="bi bi-pin-map"></i>
										Localisation:
										{{ culture.parcelle.localisation }}</p>
									<p class="text-muted mb-0">
										<i class="bi bi-sunrise"></i>
										Type de Sol:
										{{ culture.parcelle.typeSol | capitalize }}</p>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>


			<div class="container py-5">
				<h2 class="text-center mb-5">Activités de la Culture</h2>
				<div class="main-timeline">
					{% for activite in activities %}
						<div class="timeline {{ loop.index is odd ? 'left' : 'right' }}">
							<div class="card">
								<a href="{{ path('app_activite_show', {'id': activite.id}) }}" class="text-decoration-none">
									<div class="card-body p-4">
										<h3>{{ activite.date|date('d/m/Y') }}</h3>
										<p class="mb-2">
											<strong>Type d'activité:</strong>
											{% set activityColors = { 
                                                'Semis': 'success', 
                                                'Plantation': 'primary', 
                                                'Arrosage': 'info', 
                                                'Fertilisation': 'warning', 
                                                'Traitement phytosanitaire': 'secondary',
                                                'Récolte': 'danger',
                                                'Élagage / Taille': 'dark',
                                                'Greffage': 'light text-dark'
                                            } %}
											<span class="badge rounded-pill bg-{{ activityColors[activite.type] ?? 'secondary' }}">
												{{ activite.type }}
											</span>
										</p>
										<p class="mb-0">
											<strong>Description:</strong>
											{{ activite.description }}
										</p>
									</div>
								</a>
							</div>
						</div>
					{% else %}
						<p class="text-muted text-center">Aucune activité assignée à cette culture.</p>
					{% endfor %}
				</div>
			</div>


			<div class="d-flex justify-content-between mt-4">
				<a href="{{ path('app_culture_index') }}" class="btn btn-light">
					<i class="bi bi-arrow-left"></i>
					Retour
				</a>
				<div class="d-flex">
					<a href="{{ path('app_culture_edit', {'id': culture.id}) }}" class="btn btn-primary me-2">
						<i class="bi bi-pencil"></i>
						Modifier
					</a>
					{{ include('culture/_delete_form.html.twig') }}
				</div>
			</div>
		</div>
	</div>
</div>{% endblock %}
