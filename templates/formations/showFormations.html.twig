{% extends 'BackEnd/back.html.twig' %}  
{% block title %}AgriWise | Qui sommes nous {% endblock %}    
{% block content %}
				<style>
					/* Amélioration de la table */
	table {
		width: 100%;
		border-collapse: separate;
		border-spacing: 0 10px;
		background: white; /* Fond blanc pour le tableau */
		border-radius: 10px;
		overflow: hidden;
		box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
		border: 1px solid #ddd; /* Encadrement */
	}
	
	/* En-tête de la table */
	th {
		background: #4CAF50 !important; /* Vert */
		color: white !important;
		font-weight: bold;
		text-align: center;
		padding: 15px;
		width: auto;
		white-space: nowrap;
	}
	
	/* Contenu de la table */
	td {
		padding: 12px 15px;
		text-align: center;
		vertical-align: middle;
	}
	
	/* Lignes du tableau */
	tr {
		background: white; /* Fond blanc pour les lignes */
	}
	
	tr:hover {
		background: #f1f1f1; /* Gris clair au survol */
	}
	
	/* Boutons Update et Delete */
	td a {
		display: inline-block;
		padding: 8px 12px;
		margin: 5px;
		text-decoration: none;
		border-radius: 5px;
		font-weight: bold;
		text-align: center;
	}
	
	td a[href*="updateFormation"] {
		background: #007bff;
		color: white;
	}
	
	td a[href*="deleteFormation"] {
		background: #dc3545;
		color: white;
	}
	
	td a:hover {
		opacity: 0.8;
	}
	
	/* Image des formations */
	td img {
		border-radius: 5px;
		box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
	}
	
	/* Titre "Liste des formations" */
	h1 {
		text-align: center;
		margin-bottom: 20px;
		background: #4CAF50; /* Fond vert */
		color: white;
		padding: 15px;
		border-radius: 5px;
	}
	
	/* Bouton "Ajouter une nouvelle formation" */
	.btn-primary {
		background-color: #4CAF50 !important; /* Vert */
		border-color: #4CAF50 !important;
		color: white !important;
		padding: 10px 20px;
		font-size: 16px;
		font-weight: bold;
		text-align: center;
		display: block;
		margin: 20px auto;
		border-radius: 5px;
		text-decoration: none;
	}
	
	.btn-primary:hover {
		background-color: #45a049 !important; /* Vert légèrement plus foncé au survol */
		border-color: #45a049 !important;
	}
	
					</style>
				<h1>Liste des formations</h1>
		   
					   <table>
						   <thead>
							   <tr>
								   <th>Titre</th>
								   <th>Description</th>
								   <th>Prix</th>
								   <th>Date</th>
								   <th>Image</th>
								   <th>Action1</th>
								   <th>Action2</th>
							   </tr>
						   </thead>
						   <tbody>
							   {% for formation in formations %}
								   <tr>
									   <td>{{ formation.titre }}</td>
									   <td>{{ formation.description }}</td>
									   <td>{{ formation.prix }}</td>
									   <td>{{ formation.date|date('Y-m-d') }}</td>
									   <td><img src="{{ asset('uploads/images/' ~ formation.image) }}" alt="Image de formation"></td>
									   <td><a href="{{path('updateFormation', {'id': formation.id})}}">Update</a></td>
									   <td><a href="{{path('deleteFormation', {'id': formation.id})}}">Delete</a></td>
									  
								   </tr>
							   {% endfor %}
						   </tbody>
					   </table>
				   
					   <a href="{{ path('addFormation') }}" class="btn btn-primary">Ajouter une nouvelle formation</a>
				{% endblock %}