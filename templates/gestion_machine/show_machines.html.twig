{% extends 'BackEnd/back.html.twig' %}

{% block title %}Gestion des Machines{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <!-- FullCalendar CSS -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/fullcalendar/3.2.0/fullcalendar.min.css" rel="stylesheet" />
    <style>
        .row {
            display: flex;
            flex-direction: column;
        }

        .col-md-12 {
            margin-bottom: 10px;
        }

        #calendar {
            width: 80%;
            margin: 20px auto;
            min-height: 500px;
        }

        .maintenance-event {
            background-color: red !important;
            color: white !important;
        }

        .chart-container {
            width: 100%;
            max-width: 600px;
            margin: 0 auto;
        }
    </style>
{% endblock %}

{% block content %}
<div class="container-fluid">
    <div class="row">
        <!-- Bouton de tri -->
        <div class="col-md-12">
            <a href="{{ path('gestion_machines12', { sort: 'name' }) }}" class="btn btn-info">Trier par nom (A-Z)</a>
        </div>

        <!-- Champ de recherche -->
        <div class="col-md-12">
            <input type="text" id="searchInput" class="form-control" placeholder="Rechercher par nom...">
        </div>

        <!-- Table des machines -->
        <div class="col-md-12">
            <h2>Gestion des Machines</h2>
            <div class="mb-4">
                <a href="{{ path('gestion_machine_addform') }}" class="btn btn-success">Ajouter une machine</a>
                <a href="{{ path('reservation_index2') }}" class="btn btn-success">Consulter la liste des réservations</a>
                <a href="{{ path('verifier_maintenance') }}" class="btn btn-primary">Ajouter maintenances passées à l'historique</a>
                <a href="{{ path('gestion_machines_pdf') }}" class="btn btn-danger">Télécharger PDF</a>
            </div>

            <table class="table table-striped">
                <thead>
                    <tr>
                        <th scope="col">Nom</th>
                        <th scope="col">Description</th>
                        <th scope="col">Prix</th>
                        <th scope="col">État</th>
                        <th scope="col">Disponibilité</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for machine in tabmachines %}
                        <tr>
                            <td>{{ machine.nom }}</td>
                            <td>{{ machine.description }}</td>
                            <td>{{ machine.prix }}</td>
                            <td>{{ machine.etat }}</td>
                            <td>{{ machine.disponibilite }}</td>
                            <td>
                                <a href="{{ path('gestion_machine_update', {id: machine.id}) }}" class="btn btn-warning">Modifier</a>
                                <a href="{{ path('gestion_machine_delete', {id: machine.id}) }}" class="btn btn-danger" 
                                   onclick="return confirm('Êtes-vous sûr de vouloir supprimer cette machine ?');">Supprimer</a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6">Aucune machine disponible</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <!-- Graphique des statistiques des machines -->
        <div class="col-md-12">
            <h3>Statistiques des Machines</h3>
            <div class="chart-container">
                <canvas id="machineStatsChart"></canvas>
            </div>
        </div>

        <!-- Calendrier -->
        <div class="col-md-12">
            <div id="calendar"></div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.1/moment.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/fullcalendar/3.2.0/fullcalendar.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        $(document).ready(function() {
            // Initialisation du calendrier
            $('#calendar').fullCalendar({
                events: [
                    {% for machine in tabmachines %}
                        {% if machine.dateMaintenance %}
                            {
                                title: 'Maintenance de {{ machine.nom }}',
                                start: '{{ machine.dateMaintenance|date("Y-m-d") }}',
                                color: 'red',
                            },
                        {% endif %}
                    {% endfor %}
                ],
                header: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'month,agendaWeek,agendaDay'
                },
                locale: 'fr',
                defaultView: 'month',
                eventRender: function(event, element) {
                    element.addClass('maintenance-event');
                }
            });

            // Filtrage du tableau par nom
            $("#searchInput").on("keyup", function() {
                var value = $(this).val().toLowerCase();
                $("table tbody tr").filter(function() {
                    $(this).toggle($(this).find("td:first").text().toLowerCase().indexOf(value) > -1);
                });
            });

            // Calcul des statistiques
            var availableCount = 0;
            var maintenanceCount = 0;
            {% for machine in tabmachines %}
                {% if machine.etat == 'disponible' %}
                    availableCount = availableCount + 1;
                {% elseif machine.etat == 'en maintenance' %}
                    maintenanceCount = maintenanceCount + 1;
                {% endif %}
            {% endfor %}

            // Graphique à barres des statistiques
            var ctx = document.getElementById('machineStatsChart').getContext('2d');
            var machineStatsChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: ['Machines Disponibles', 'Machines en Maintenance'],
                    datasets: [{
                        data: [availableCount, maintenanceCount],
                        backgroundColor: ['#4CAF50', '#FF5733'],
                        borderColor: ['#388E3C', '#D32F2F'],
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    scales: {
                        y: {
                            beginAtZero: true
                        }
                    }
                }
            });
        });
    </script>
{% endblock %}