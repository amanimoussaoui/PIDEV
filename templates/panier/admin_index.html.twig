{% extends 'BackEnd/back.html.twig' %}

{% block title %}Gestion des Paniers{% endblock %}

{% block content %}
<style>
    /* CONTAINER PRINCIPAL */
    .container {
        max-width: 1000px;
        margin: 30px auto;
        padding: 20px;
        background: #fff;
        border-radius: 10px;
        box-shadow: 0px 4px 15px rgba(0, 0, 0, 0.1);
    }

    /* TITRE */
    h2 {
        text-align: center;
        color: #2c7b2c;
        margin-bottom: 20px;
        font-size: 28px;
        font-weight: bold;
    }

    /* TABLEAU */
    .table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
    }

    .table th, .table td {
        padding: 15px;
        text-align: center;
        border-bottom: 1px solid #ddd;
    }

    .table th {
        background: #2c7b2c;
        color: white;
        text-transform: uppercase;
        font-size: 14px;
    }

    .table tr:hover {
        background: rgba(44, 123, 44, 0.1);
        transition: background 0.3s ease;
    }

    /* BOUTONS */
    .btn-container {
        display: flex;
        gap: 10px;
        justify-content: center;
    }

    .btn-delete {
        padding: 10px 16px;
        border-radius: 20px;
        text-decoration: none;
        font-size: 14px;
        transition: all 0.3s ease-in-out;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        border: none;
        background: #d9534f;
        color: white;
    }

    .btn-delete:hover {
        background: #c9302c;
        transform: scale(1.05);
    }

    /* ICÔNES */
    .btn-delete i {
        margin-right: 5px;
    }

    /* CENTRER LE TEXTE LORSQU'IL N'Y A PAS DE PRODUIT */
    .text-center {
        text-align: center;
        font-style: italic;
        color: #888;
        padding: 15px;
    }

    /* IMAGES */
    .table img {
        width: 70px;
        height: 70px;
        object-fit: cover;
        border-radius: 8px;
        transition: transform 0.3s;
    }

    .table img:hover {
        transform: scale(1.1);
    }
</style>

<div class="container">
    <h2>Gestion des Paniers</h2>

    <a href="{{ path('panier_pdf') }}" title="Télécharger en PDF">
        <i class="fas fa-file-pdf"></i> Télécharger en PDF
    </a>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger">{{ message }}</div>
    {% endfor %}

    <table class="table">
        <thead>
            <tr>
                <th>Image</th>
                <th>Produit</th>
                <th>Quantité</th>
                <th>Prix Total</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for panier in paniers %}
            <tr>
                <td>
                    {% if panier.product is not null and panier.product.image is not null %}
                    <img src="{{ panier.product.image }}" alt="Image du produit">
                    {% else %}
                        <span>Aucune image</span>
                    {% endif %}
                </td>
                <td>
                    {% if panier.product is not null %}
                        {{ panier.product.nom }}
                    {% else %}
                        Produit non trouvé
                    {% endif %}
                </td>
                <td>{{ panier.quantite }}</td>
                <td>{{ panier.totale }} DT</td>
                <td class="btn-container">
                    <form method="post" action="{{ path('panier_admin_supprimer', {'id': panier.id}) }}">
                        <button type="submit" class="btn-delete">
                            <i class="fas fa-trash"></i> Supprimer
                        </button>
                    </form>
                </td>
            </tr>
            {% else %}
                <tr>
                    <td colspan="5" class="text-center">Aucun panier disponible.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
