
{% block content %}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Résumé du Panier</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 20px;
            padding: 20px;
            text-align: center;
        }
        
        .logo {
            width: 150px;
            margin-bottom: 20px;
        }

        h2 {
            color: #2c7b2c;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        table, th, td {
            border: 1px solid #ddd;
            padding: 10px;
        }

        th {
            background: #2c7b2c;
            color: white;
        }

        .total {
            font-size: 18px;
            font-weight: bold;
            margin-top: 20px;
        }
    </style>
</head>
<body>


    <h2>Résumé du Panier</h2>

    <table>
        <thead>
            <tr>
                <th>Client</th>
                <th>Produit</th>
                <th>Quantité</th>
                <th>Prix Total</th>
            </tr>
        </thead>
        <tbody>
            {% for panier in paniers %}
            <tr>
                <td>{{ panier.product.utilisateurs.nom }}</td>
                <td>{{ panier.product.nom }}</td>
                <td>{{ panier.quantite }}</td>
                <td>{{ panier.totale }} DT</td>
            </tr>
            {% else %}
            <tr>
                <td colspan="4">Aucun produit dans le panier.</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    <p class="total">Total Général : {{ totalGeneral }} DT</p>

</body>
</html>

{% endblock %}
