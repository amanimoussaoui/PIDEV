{% extends 'FrontEnd/front.html.twig' %}

{% block title %}Liste des produits{% endblock %}

{% block content %}
<style>
    /* 🎨 Amélioration générale du contenu */
    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px;
    }

    /* 📌 Style du titre */
    h2.mb-4 {
        color: #4Cae4c; /* Couleur verte */
        font-family: 'Arial', sans-serif; /* Police moderne */
        font-weight: 700; /* Texte en gras */
        font-size: 36px; /* Taille du texte plus grande */
        text-transform: uppercase; /* Met en majuscule */
        letter-spacing: 2px; /* Espacement des lettres */
        text-shadow: 1px 1px 5px rgba(0, 0, 0, 0.2); /* Ombre du texte */
        text-align: center; /* Centrer le texte */
        margin-top: 100px; /* Ajout d'une marge pour espacer du haut de la page */
        margin-bottom: 30px; /* Espacement sous le titre */
    }

    /* 🧩 Style de la carte des produits */
    .card-container {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); /* Cartes responsives */
        gap: 20px;
        margin-top: 20px;
    }

    .card {
        background-color: #fff;
        border-radius: 20px; /* Coins plus arrondis */
        box-shadow: 0px 8px 20px rgba(0, 0, 0, 0.1); /* Ombre subtile */
        padding: 20px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        border: 1px solid #e0e0e0; /* Bordure discrète */
    }

    .card:hover {
        transform: translateY(-12px);
        box-shadow: 0px 12px 30px rgba(0, 0, 0, 0.2); /* Ombre plus marquée au survol */
    }

    .card-header {
        font-size: 20px;
        font-weight: bold;
        color: #218838;
        margin-bottom: 15px;
        text-align: center;
    }

    .card-body {
        margin-top: 10px;
        font-size: 14px;
        color: #555;
    }

    .card-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 20px;
    }

    /* 🎨 Style des boutons d'action */
    .btn-container {
        display: flex;
        gap: 10px;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 10px 15px;
        border-radius: 30px;
        font-size: 14px;
        width: auto;
        height: auto;
        transition: transform 0.3s ease, background-color 0.3s ease;
        font-weight: 600;
        border: none;
    }

    /* 📝 Bouton Modifier */
    .btn-warning {
        background-color: #ffc107;
        color: black;
        box-shadow: 0px 4px 8px rgba(243, 156, 18, 0.4);
    }

    .btn-warning:hover {
        background-color: #e0a800;
        transform: scale(1.05);
        box-shadow: 0px 8px 12px rgba(243, 156, 18, 0.6);
    }

    /* 🗑️ Bouton Supprimer */
    .btn-danger {
        background-color: #dc3545;
        color: white;
        box-shadow: 0px 4px 8px rgba(231, 76, 60, 0.4);
    }

    .btn-danger:hover {
        background-color: #c82333;
        transform: scale(1.05);
        box-shadow: 0px 8px 12px rgba(231, 76, 60, 0.6);
    }

    /* 📌 Bouton Ajouter */
    .btn-primary {
        background-color: #28a745;
        border: none;
        color: white;
        font-size: 16px;
        font-weight: bold;
    }

    .btn-primary:hover {
        background-color: #218838;
    }

    /* 📌 Icônes dans les boutons */
    .btn i {
        font-size: 16px;
        margin-right: 8px;
    }

    /* 🎨 Image dans la carte */
    .card-img {
        width: 100%;
        height: 180px;
        border-radius: 12px; /* Coins arrondis de l'image */
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .card-img:hover {
        transform: scale(1.1);
    }

    /* 🖥️ Responsive */
    @media (max-width: 768px) {
        .table-container {
            display: none;
        }

        .card-container {
            display: grid;
            grid-template-columns: 1fr; /* Une colonne sur mobile */
            gap: 20px;
        }
    }
</style>

<div class="container mt-4">
    <h2 class="mb-4">Bienvenue Voici vos Produits</h2>

    <div class="card-container">
        {% for product in products %}
            <div class="card">
                <!-- Image du produit -->
                <img src="{{ asset('uploads/images/' ~ product.image) }}" alt="Image de {{ product.nom }}" class="card-img">

                <div class="card-header">
                    {{ product.nom }}
                </div>
                <div class="card-body">
                    <p><strong>Description:</strong> {{ product.description }}</p>
                    <p><strong>Prix:</strong> {{ product.prix }} DT</p>
                    <p><strong>Stock:</strong> {{ product.stock }}</p>
                    <p><strong>Catégorie:</strong> {{ product.category }}</p>
                    
                </div>
                <div class="card-footer">
                    <div class="btn-container">
                        <a href="{{ path('product_update', {'id': product.id}) }}" class="btn btn-warning btn-sm"><i class="fas fa-edit"></i> </a>
                        <a href="{{ path('product_delete', {'id': product.id}) }}" class="btn btn-danger btn-sm  " ><i class="fas fa-trash-alt"></i> </a>
                        <a href="{{ path('product_details', {'id': product.id}) }}" class="details-link">
    <i class="fas fa-eye"></i>  <!-- Icône de l'œil -->
</a>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="text-center">Aucun produit disponible.</div>
        {% endfor %}
    </div>

   <a href="{{ path('product_new') }}" class="btn btn-primary mt-4">
    <i class="fas fa-plus"></i> <!-- Icône d'ajout -->
</a>
</div>

{% endblock %}
