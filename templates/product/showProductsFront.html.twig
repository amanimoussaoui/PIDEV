{% extends 'FrontEnd/front.html.twig' %}

{% block title %}Nos Produits{% endblock %}

{% block content %}
    <style>
        /* 🎨 Style global du formulaire */
        .search-form {
            display: flex;
            justify-content: space-between; /* Aligner le formulaire et l'icône de tri */
            margin: 30px auto;
            width: 100%;
            max-width: 800px;
            border-radius: 30px; /* Arrondi les coins du formulaire */
            padding: 15px;
            background-color: #f9f9f9; /* Couleur de fond claire */
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        }

        .search-box {
            display: flex;
            width: 100%;
            background: white;
            padding: 5px;
            border-radius: 30px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            border: 2px solid #ddd;
            transition: all 0.3s ease;
        }

        .search-box:focus-within {
            border-color: #218838;
            box-shadow: 0 4px 12px rgba(33, 136, 56, 0.3);
        }

        /* 🎨 Style de la sélection des catégories */
        .search-select {
            border: none;
            background: transparent;
            padding: 12px 15px;
            border-radius: 30px;
            font-size: 16px;
            outline: none;
            cursor: pointer;
            flex: 1;
        }

        .search-select:hover {
            background-color: #f2f2f2;
        }

        /* 🎨 Style du champ de recherche */
        .search-input {
            border: none;
            padding: 12px;
            font-size: 16px;
            outline: none;
            flex: 2;
            background: transparent;
            width: 100%;
        }

        /* 🎨 Style du bouton de recherche */
        .search-button {
            background-color: transparent; /* Supprime le fond */
            border: none; /* Supprime la bordure */
            width: 50px;
            height: 50px;
            border-radius: 50%; /* Bouton rond */
            color: #218838; /* Couleur de l'icône */
            cursor: pointer;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 8px;
            transition: all 0.3s ease;
            box-shadow: none; /* Enlève l'ombre */
        }

        .search-button:hover {
            color: #1a682c; /* Change la couleur de l'icône au survol */
          
        }

        .search-button i {
            font-size: 20px;
            transition: transform 0.3s ease, color 0.3s ease;
        }

      

        /* 🎨 Style pour le bouton de tri */
        .sort-icon {
            display: flex;
            justify-content: center;
            align-items: center;
            cursor: pointer;
            background-color: transparent;
            border: none;
            padding: 5px;
            font-size: 10px;
            color: #218838;
            transition: transform 0.3s ease, color 0.3s ease;
        }

        .sort-icon:hover {
            color: #1a682c;
          
        }

        /* 🎨 Amélioration du titre */
        h1 {
            text-align: center;
            margin-top: 50px;
            margin-bottom: 30px;
            font-size: 3rem;
            font-weight: bold;
            color: #218838;
            text-transform: uppercase;
            letter-spacing: 2px;
            text-shadow: 2px 2px 10px rgba(0, 0, 0, 0.1);
            padding: 15px 30px;
            border-radius: 12px;
            background-color: #eaf4e4;
        }

        h1:hover {
            color: #1a682c;
            transform: scale(1.05);
            transition: 0.3s ease;
            border: 3px solid #218838;
            padding: 12px 28px;
            background-color: #ffffff;
            text-shadow: 3px 3px 12px rgba(0, 0, 0, 0.2);
        }

        /* 🎨 Style des cartes */
        .cards-container {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            justify-content: space-around;
        }

        .card {
            width: 300px;
            border: 1px solid #ddd;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            transition: transform 0.3s ease;
            background: white;
        }

        
        .card-img-top {
            width: 100%;
            height: 200px;
            object-fit: cover;
        }

        .card-body {
            padding: 15px;
            text-align: center;
        }

        .card-title {
            font-size: 1.25rem;
            font-weight: bold;
        }

        .card-price {
            color: #218838;
            font-size: 1.1rem;
        }

        .card-description {
            margin-top: 10px;
            font-size: 0.9rem;
            color: #555;
        }

        .card-category, .card-stock {
            font-size: 0.9rem;
            color: #444;
            margin-top: 5px;
        }

        .btn-primary {
            display: inline-block;
            margin-top: 10px;
            padding: 8px 12px;
            border-radius: 5px;
            background-color: #218838;
            color: white;
            text-decoration: none;
        }

        .btn-primary:hover {
            background-color: #1a682c;
        }
    </style>

    <h1>Nos Produits</h1>

    <!-- Formulaire de recherche -->
    <form method="GET" action="{{ path('product_search') }}" class="search-form">
        <div class="search-box">
            <select name="category" class="search-select">
                <option value="">Toutes les catégories</option>
                <option value="fruits">Fruits</option>
                <option value="Légumes">Légumes</option>
                <option value="Graines">Graines</option>
                <option value="Épices">Épices</option>
            </select>
            <input type="text" name="query" class="search-input" placeholder="Rechercher un produit...">
            <button type="submit" class="search-button">
                <i class="fas fa-search"></i>
            </button>
        </div>

        <!-- Icône de tri -->
        <button type="submit" class="sort-icon" name="sort" value="price_asc">
            <i class="fas fa-sort-amount-up"></i> <!-- Icône de tri par prix croissant -->
        </button>
    </form>

    <div class="cards-container">
        {% if products is not empty %}
            {% for product in products %}
                <div class="card">
                    <img src="{{ asset('uploads/images/' ~ product.image) }}" alt="Image du produit"
 class="card-img-top">
                    <div class="card-body">
                    
                        <h5 class="card-title">{{ product.nom }}</h5>
                        <p class="card-price"><strong>{{ product.prix }}DT</strong></p>
                        <p class="card-description"><strong>Description:</strong> {{ product.description }}</p>
                        <p class="card-category"><strong>Catégorie:</strong> {{ product.category }}</p>
                        <p class="card-stock"><strong>Stock:</strong> {{ product.stock }}</p>
                        <p class="card-agriculteur"><strong>Agriculteur</strong>{{ product.utilisateurs.nom  }}</p>
                        
                      <a href="{{ path('commande_create', {'productId': product.id}) }}" class="btn-primary" style="width: 100%; text-align: center;">🛒 Commander</a>
<a href="{{ path('product_details_client', {'id': product.id}) }}" class="btn-primary" style="width: 100%; text-align: center; border-radius: 5px; padding: 10px;">
    <i class="fas fa-eye" style="font-size: 18px;"></i> Détails
</a>



                        
                    </div>
                </div>
            {% endfor %}
        {% else %}
            <p style="text-align: center; font-size: 1.2rem; color: #777;">Aucun produit trouvé.</p>
        {% endif %}
    </div>
    
{% endblock %}
