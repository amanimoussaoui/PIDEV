{% extends 'FrontEnd/front.html.twig' %}

{% block title %}Nos Produits{% endblock %}

{% block content %}
    <style>
        /* 🎨 Style global du formulaire */
        .search-form {
    display: flex;
    justify-content: space-between;
    margin: 30px auto;
    width: 100%;
    max-width: 800px;
    border-radius: 30px; /* Assure que le formulaire est arrondi */
    padding: 15px;
    background-color: #f9f9f9;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
}

.search-box {
    display: flex;
    width: 100%;
    background: white;
    padding: 5px;
    border-radius: 30px; /* Bordure arrondie de la boîte de recherche */
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    border: 2px solid #ddd;
    transition: all 0.3s ease;
}

.search-select, .search-input {
    border: none;
    outline: none;
    font-size: 16px;
    padding: 12px;
    background: transparent;
    flex: 1;
    border-radius: 30px; /* Arrondi des champs de recherche */
    transition: background 0.3s ease;
}

.search-button {
    background-color: transparent;
    border: none;
    width: 50px;
    height: 50px;
    border-radius: 50%; /* Arrondi circulaire pour le bouton de recherche */
    color: #218838;
    cursor: pointer;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 8px;
    transition: all 0.3s ease;
}

.search-button i {
    font-size: 20px;
    transition: transform 0.3s ease, color 0.3s ease;
}

        /* 🎨 Style des icônes de tri */
        .sort-icon {
            display: flex;
            align-items: center;
            cursor: pointer;
            background-color: transparent;
            border: 1px solid #ddd;
            padding: 5px 10px;
            font-size: 12px;
            color: #218838;
            border-radius: 25px;
            transition: background-color 0.3s ease;
            margin-right: 10px;
        }

        .sort-icon:hover {
            background-color: #eaf4e4;
        }

        .sort-icon.active {
            background-color: #218838;
            color: white;
        }

        /* 🎨 Style du titre */
        h1 {
            text-align: center;
            margin-top: 50px;
            margin-bottom: 30px;
            font-size: 3rem;
            font-weight: bold;
            color: #218838;
            text-transform: uppercase;
            letter-spacing: 2px;
            text-shadow: 2px 2px 10px rgba(0, 0, 0, 0.1);
            padding: 15px 30px;
            border-radius: 12px;
            background-color: #eaf4e4;
        }

        h1:hover {
            color: #1a682c;
            transform: scale(1.05);
            transition: 0.3s ease;
            border: 3px solid #218838;
            padding: 12px 28px;
            background-color: #ffffff;
            text-shadow: 3px 3px 12px rgba(0, 0, 0, 0.2);
        }

        /* 🎨 Style des cartes de produits */
        .cards-container {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            justify-content: space-around;
            margin-bottom: 30px;
        }

        .card {
            width: 300px;
            border: 1px solid #ddd;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            transition: transform 0.3s ease;
            background: white;
        }

        .card:hover {
            transform: translateY(-5px);
        }

        .card-img-top {
            width: 100%;
            height: 200px;
            object-fit: cover;
        }

        .card-body {
            padding: 15px;
            text-align: center;
        }

        .card-title {
            font-size: 1.25rem;
            font-weight: bold;
        }

        .card-price {
            color: #218838;
            font-size: 1.1rem;
        }

        .card-description {
            margin-top: 10px;
            font-size: 0.9rem;
            color: #555;
        }

        .card-category, .card-stock {
            font-size: 0.9rem;
            color: #444;
            margin-top: 5px;
        }

        .btn-primary {
            display: inline-block;
            margin-top: 10px;
            padding: 8px 12px;
            border-radius: 5px;
            background-color: #218838;
            color: white;
            text-decoration: none;
        }

        .btn-primary:hover {
            background-color: #1a682c;
        }

        /* 🎨 Responsive */
        @media (max-width: 768px) {
            .search-form {
                flex-direction: column;
                align-items: center;
            }

            .search-box {
                width: 100%;
            }

            .card {
                width: 100%;
                margin-bottom: 20px;
            }

            h1 {
                font-size: 2.5rem;
                margin-top: 20px;
            }}







    </style>

    <h1>Nos Produits</h1>

    <!-- Formulaire de recherche -->
    <form method="GET" action="{{ path('product_search') }}" class="search-form">
        <div class="search-box">
            <select name="category" class="search-select">
                <option value="">Toutes les catégories</option>
                <option value="fruits">Fruits</option>
                <option value="Légumes">Légumes</option>
                <option value="Graines">Graines</option>
                <option value="Épices">Épices</option>
            </select>
            <input type="text" name="query" class="search-input" placeholder="Rechercher un produit...">
            <button type="submit" class="search-button">
                <i class="fas fa-search"></i>
            </button>
        </div>

 
           
       
    </form>

    <div class="cards-container">
        {% if products is not empty %}
            {% for product in products %}
                <div class="card">
                    <img src="{{ asset('uploads/images/' ~ product.image) }}" alt="Image du produit" class="card-img-top">
                    <div class="card-body">
                        <h5 class="card-title">{{ product.nom }}</h5>
                        <p class="card-price"><strong>{{ product.prix }}DT</strong></p>
                        <p class="card-description"><strong>Description:</strong> {{ product.description }}</p>
                        <p class="card-category"><strong>Catégorie:</strong> {{ product.category }}</p>
                        <p class="card-stock"><strong>Stock:</strong> {{ product.stock }}</p>
                        <p class="card-agriculteur"><strong>Agriculteur:</strong> {{ product.utilisateurs.nom }}</p>
                        
                        <a href="{{ path('commande_create', {'productId': product.id}) }}" class="btn-primary" style="width: 100%; text-align: center;">🛒 Commander</a>
                        <a href="{{ path('product_details_client', {'id': product.id}) }}" class="btn-primary" style="width: 100%; text-align: center; border-radius: 5px; padding: 10px;">
                            <i class="fas fa-eye" style="font-size: 18px;"></i> Détails
                        </a>
                    </div>
                </div>
            {% endfor %}
        {% else %}
            <p style="text-align: center; font-size: 1.2rem; color: #777;">Aucun produit trouvé.</p>
        {% endif %}
    </div>
  <!-- Pagination -->
<div class="pagination">
    {{ knp_pagination_render(products) }}
</div>
<script>
function sortProducts(order) {
    fetch(`/product/sort?order=${order}`) // Appel AJAX
        .then(response => response.json())
        .then(data => {
            const productList = document.getElementById('product-list');
            productList.innerHTML = ''; // Vider la liste des produits

            data.products.forEach(product => {
                // Créer une carte produit
                const card = document.createElement('div');
                card.classList.add('card');
                card.innerHTML = `
                    <img src="/uploads/images/${product.image}" alt="Image du produit" class="card-img-top">
                    <div class="card-body">
                        <h5 class="card-title">${product.nom}</h5>
                        <p class="card-price"><strong>${product.prix} DT</strong></p>
                        <p class="card-category"><strong>Catégorie:</strong> ${product.category}</p>
                        <p class="card-description"><strong>Description:</strong> ${product.description}</p>
                    </div>
                `;
                productList.appendChild(card); // Ajouter la carte au DOM
            });
        })
        .catch(error => console.error('Erreur lors du tri:', error));
}
</script>


{% endblock %}
