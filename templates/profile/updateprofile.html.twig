{% extends 'FrontEnd/front.html.twig' %}

{% block title %}Update Profile{% endblock %}

{% block styles%}
<style>
    /* Conteneur principal */
    .update-profile-container {
        max-width: 600px;
        margin: 0 auto;
        padding: 20px;
        background: #ffffff;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    }

    /* Titre */
    .update-profile-container h1 {
        text-align: center;
        font-size: 28px;
        color: #333;
        margin-bottom: 20px;
    }

    /* Champs du formulaire */
    .update-profile-container .form-group {
        margin-bottom: 20px;
    }

    .update-profile-container label {
        display: block;
        font-weight: bold;
        margin-bottom: 8px;
        color: #555;
    }

    .update-profile-container input[type="text"],
    .update-profile-container input[type="number"],
    .update-profile-container input[type="date"],
    .update-profile-container textarea,
    .update-profile-container input[type="file"] {
        width: 100%;
        padding: 10px;
        border: 2px solid #e0e0e0;
        border-radius: 8px;
        font-size: 16px;
        outline: none;
        transition: border-color 0.3s ease;
    }

    .update-profile-container input[type="text"]:focus,
    .update-profile-container input[type="number"]:focus,
    .update-profile-container input[type="date"]:focus,
    .update-profile-container textarea:focus,
    .update-profile-container input[type="file"]:focus {
        border-color: #28a745;
    }

    .update-profile-container textarea {
        resize: vertical;
        min-height: 100px;
    }

    /* Bouton de soumission */
    .update-profile-container button[type="submit"] {
        width: 100%;
        padding: 12px;
        background-color: #28a745;
        color: white;
        font-size: 18px;
        font-weight: bold;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        transition: background-color 0.3s ease;
    }

    .update-profile-container button[type="submit"]:hover {
        background-color: #218838;
    }

    /* Style pour le champ de fichier (image) */
    .update-profile-container input[type="file"] {
        padding: 8px;
        background-color: #f8f9fa;
        border: 2px dashed #e0e0e0;
    }

    .update-profile-container input[type="file"]:focus {
        border-color: #28a745;
    }

    /* Animation au survol des champs */
    .update-profile-container input:hover,
    .update-profile-container textarea:hover,
    .update-profile-container input[type="file"]:hover {
        border-color: #28a745;
    }
</style>

{% endblock%}

{% block content %}
<div class="update-profile-container">
    <h1>Update Your Profile</h1>

    {{ form_start(formupdateprofile) }}
        <div class="form-group">
            {{ form_row(formupdateprofile.adresse, { 'attr': {'class': 'form-control'} }) }}
        </div>
        <div class="form-group">
            {{ form_row(formupdateprofile.num_tel, { 'attr': {'class': 'form-control'} }) }}
        </div>
        <div class="form-group">
            {{ form_row(formupdateprofile.image, { 'attr': {'class': 'form-control'} }) }}
        </div>
        <div class="form-group">
            {{ form_row(formupdateprofile.bio, { 'attr': {'class': 'form-control'} }) }}
        </div>
        <div class="form-group">
            {{ form_row(formupdateprofile.date_de_naissance, { 'attr': {'class': 'form-control'} }) }}
        </div>
        <div class="form-group">
            {{ form_row(formupdateprofile.prenomf, { 'attr': {'class': 'form-control'} }) }}
        </div>
<br>
        <button type="submit" class="btn btn-primary">Update Profile</button>
    {{ form_end(formupdateprofile) }}
</div>
{% endblock %}
