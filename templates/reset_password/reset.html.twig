

{% block body %}
    <div class="reset-container">
        <div class="reset-box">
            <h1>Reset your password</h1>

            {{ form_start(resetForm) }}
                {{ form_row(resetForm.plainPassword) }}
                <button type="submit">Reset password</button>
            {{ form_end(resetForm) }}
        </div>
    </div>
{% endblock %}
{% block styles %}
    <style>
        /* Center the reset form */
        .reset-container {
            width: 100%;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #007bff, #0056b3);
            font-family: 'Poppins', sans-serif;
        }

        /* Reset password card */
        .reset-box {
            background: white;
            padding: 40px;
            border-radius: 12px;
            box-shadow: 0px 10px 30px rgba(0, 0, 0, 0.2);
            text-align: center;
            width: 90%;
            max-width: 400px;
        }

        /* Title */
        .reset-box h1 {
            font-size: 28px;
            font-weight: bold;
            color: #0056b3;
            margin-bottom: 20px;
        }

        /* Form inputs */
        .reset-box input {
            width: 100%;
            padding: 12px;
            margin: 10px 0;
            border: 2px solid #0056b3;
            border-radius: 8px;
            font-size: 16px;
            outline: none;
            transition: 0.3s ease-in-out;
            background: #F8FAFC;
        }

        /* Focus effect on input */
        .reset-box input:focus {
            border-color: #007bff;
            background: #ffffff;
            box-shadow: 0px 0px 10px rgba(0, 123, 255, 0.2);
        }

        /* Reset button */
        .reset-box button {
            width: 100%;
            background: linear-gradient(135deg, #007bff, #0056b3);
            color: white;
            font-size: 18px;
            font-weight: bold;
            padding: 12px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s ease-in-out;
        }

        /* Button hover effect */
        .reset-box button:hover {
            transform: scale(1.05);
            background: linear-gradient(135deg, #0056b3, #007bff);
        }
    </style>
{% endblock %}
