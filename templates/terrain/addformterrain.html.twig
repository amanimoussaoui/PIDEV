{% extends 'FrontEnd/front.html.twig' %}

{% block title %}AgriWise | Ajouter un Terrain{% endblock %}

{% block content %}
<style>
    .form-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 60vh;
        background-color: #f0f8f0;
        padding: 20px;
    }

    .form-container {
        display: flex;
        background: white;
        border-radius: 15px;
        box-shadow: 0px 4px 15px rgba(0, 128, 0, 0.2);
        overflow: hidden;
        max-width: 1600px;
        width: 100%;
        flex-wrap: wrap;
    }

    .form-section {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 30px;
        width: 60%; /* Section principale du formulaire */
    }

    .form-section h1 {
        text-align: center;
        color: #2d6a4f;
        margin-bottom: 20px;
    }

    .form-group {
        display: flex;
        align-items: center;
        margin-bottom: 15px;
    }

    .form-group label {
        font-weight: bold;
        color: #2d6a4f;
        width: 200px; /* Taille fixe pour les labels */
    }

    .form-group .form-control {
        border: 2px solid #2d6a4f;
        border-radius: 8px;
        padding: 10px;
        flex-grow: 1; /* Remplir l'espace restant */
    }

    .form-control:focus {
        border-color: #1b4332;
        box-shadow: 0 0 5px #1b4332;
    }

    .btn-submit {
        background: linear-gradient(135deg, #2d6a4f, #1b4332);
        border: none;
        color: white;
        font-size: 18px;
        padding: 10px;
        border-radius: 8px;
        width: 100%;
        text-transform: uppercase;
        transition: 0.3s;
        cursor: pointer;
        margin-top: 20px;
        display: block;
    }

    .btn-submit:hover {
        background: #1b4332;
    }

    .image-section {
        flex: 1;
        background: url('/uploads/agri1.jpg') no-repeat center center/cover;
        min-height: 400px;
    }

    #map {
        width: 100%;
        height: 400px;
        margin-bottom: 15px;
    }
</style>


<div class="form-wrapper">
    <div class="form-container">
        <div class="form-section">
            <h1><i class="fas fa-seedling"></i> Ajouter un Terrain</h1>

            {{ form_start(formadd, {'attr': {'novalidate': 'novalidate', 'enctype': 'multipart/form-data'}}) }}
            {{ form_errors(formadd) }}

            <div class="form-group">
                <label for="{{ formadd.localisation.vars.id }}">
                    <i class="fas fa-map-marker-alt icon"></i> Localisation
                </label>
                {{ form_widget(formadd.localisation, {'attr': {'class': 'form-control', 'readonly': 'true'}}) }}
                {{ form_errors(formadd.localisation) }}
            </div>

            <div id="map"></div>

            <div class="form-group">
                <label for="{{ formadd.superficie.vars.id }}">
                    <i class="fas fa-ruler-combined icon"></i> Superficie (m²)
                </label>
                {{ form_widget(formadd.superficie, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(formadd.superficie) }}
            </div>

            <div class="form-group">
                <label for="{{ formadd.prix.vars.id }}">
                    <i class="fas fa-dollar-sign icon"></i> Prix (TND)
                </label>
                {{ form_widget(formadd.prix, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(formadd.prix) }}
            </div>

            <div class="form-group">
                <label for="{{ formadd.description.vars.id }}">
                    <i class="fas fa-align-left icon"></i> Description
                </label>
                {{ form_widget(formadd.description, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(formadd.description) }}
            </div>

            <div class="form-group">
                {{ form_row(formadd.image, { 'attr': {'class': 'form-control'} }) }}
            </div>

            <div style="margin-top: 20px;">
                <button type="submit" class="btn-submit">
                    <i class="fas fa-plus-circle"></i> Ajouter
                </button>
            </div>

            {{ form_end(formadd) }}
        </div>
        <div class="image-section"></div>
    </div>
</div>

<script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyDCagvTBruDUHVjdmTVhWpVMdWmwiyZevg&callback=initMap" async defer></script>
<script>
    function initMap() {
        const defaultLat = 36.80278;
        const defaultLng = 10.18158;

        const map = new google.maps.Map(document.getElementById("map"), {
            center: { lat: defaultLat, lng: defaultLng },
            zoom: 13,
        });

        const marker = new google.maps.Marker({
            position: { lat: defaultLat, lng: defaultLng },
            map: map,
            draggable: true,
        });

        google.maps.event.addListener(map, 'click', function (event) {
            const lat = event.latLng.lat();
            const lng = event.latLng.lng();
            marker.setPosition({ lat, lng });
            document.getElementById("{{ formadd.localisation.vars.id }}").value = `Latitude: ${lat}, Longitude: ${lng}`;
        });
    }

    google.maps.event.addDomListener(window, 'load', initMap);
</script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/js/all.min.js"></script>

{% endblock %}
