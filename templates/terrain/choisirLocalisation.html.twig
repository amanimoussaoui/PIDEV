<html>
<head>
    <title>Choisir la Localisation</title>
    <script src="https://maps.googleapis.com/maps/api/js?key={{ google_maps_api_key }}&callback=initMap" async defer></script>
    <style>
        #map {
            height: 400px;
            width: 100%;
        }
    </style>
    <script>
        let map;
        let marker;

        function initMap() {
            map = new google.maps.Map(document.getElementById("map"), {
                center: { lat: 48.8566, lng: 2.3522 }, // Coordonnée par défaut (Paris)
                zoom: 13
            });

            google.maps.event.addListener(map, 'click', function(event) {
                placeMarker(event.latLng);
            });

            marker = new google.maps.Marker({
                map: map
            });
        }

        function placeMarker(location) {
            marker.setPosition(location);
            // Récupérer la latitude et la longitude
            document.getElementById('latitude').value = location.lat();
            document.getElementById('longitude').value = location.lng();
        }
    </script>
</head>
<body>
    <h1>Choisir la localisation du terrain</h1>
    <div id="map"></div>
    <form method="post" action="{{ path('app_terrain_new') }}">
        <input type="hidden" id="latitude" name="latitude">
        <input type="hidden" id="longitude" name="longitude">
        <button type="submit">Enregistrer la localisation</button>
    </form>
</body>
</html>
