{% extends 'FrontEnd/front.html.twig' %}

{% block title %}Mes Terrains Favoris{% endblock %}

{% block content %}
    <style>
        /* Style pour l'arrière-plan de la page */
        body {
            background-image: url('/uploads/agriagri.jpg'); /* Chemin de l'image */
            background-size: cover; /* Couvre toute la page */
            background-position: center; /* Centre l'image */
            background-repeat: no-repeat; /* Empêche la répétition de l'image */
            background-attachment: fixed; /* Fixe l'image pendant le défilement */
            min-height: 100vh; /* Assure que le fond couvre toute la hauteur de la page */
        }

        /* Style général pour la page des favoris */
        .favoris-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
            background-color: rgba(255, 255, 255, 0.9); /* Fond semi-transparent pour améliorer la lisibilité */
            border-radius: 12px;
            box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
        }

        .favoris-container h1 {
            color: #2D6A4F;
            font-size: 2.5rem;
            text-align: center;
            margin-bottom: 30px;
        }

        /* Style pour la liste des terrains favoris */
        .favoris-list {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            justify-content: center;
        }

        /* Style pour chaque cadre de terrain */
        .terrain-card {
            background-color: #fff;
            border-radius: 12px;
            box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
            padding: 20px;
            width: 300px;
            transition: transform 0.3s ease-in-out, box-shadow 0.3s ease-in-out;
        }

        .terrain-card:hover {
            transform: translateY(-5px);
            box-shadow: 0px 6px 15px rgba(0, 0, 0, 0.2);
        }

        .terrain-card p {
            margin: 10px 0;
            font-size: 1.1rem;
            color: #555;
        }

        .terrain-card p strong {
            color: #2D6A4F;
            font-size: 1.2rem;
        }

        .terrain-card a {
            display: inline-block;
            margin-top: 15px;
            padding: 10px 20px;
            background-color: #2D6A4F;
            color: white;
            text-decoration: none;
            border-radius: 8px;
            transition: background-color 0.3s ease;
        }

        .terrain-card a:hover {
            background-color: #1B4D3E;
        }

        /* Style pour le message "Aucun terrain favori" */
        .no-favoris {
            text-align: center;
            font-size: 1.2rem;
            color: #777;
            margin-top: 40px;
        }
    </style>

    <div class="favoris-container">
        <h1>Mes Terrains Favoris</h1>

        {% if terrainsFavoris is empty %}
            <p class="no-favoris">Vous n'avez aucun terrain favori.</p>
        {% else %}
            <div class="favoris-list">
                {% for terrain in terrainsFavoris %}
                    <div class="terrain-card">
                        <p><strong>Terrain #{{ terrain.id }}</strong></p>
                        <p>Superficie: {{ terrain.superficie }} m²</p>
                        <p>Prix: {{ terrain.prix }} TND</p>
                        <a href="{{ path('list_terrains', {'id': terrain.id}) }}">Voir le détail</a>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
{% endblock %}