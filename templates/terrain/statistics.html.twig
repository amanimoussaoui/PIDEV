{% extends 'BackEnd/back.html.twig' %}

{% block title %}Statistiques des Terrains{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('app') }}
    <style>
        /* Ajouter un style pour réduire la taille du canvas */
        #terrainChart {
            max-width: 300px; /* Ajustez cette valeur selon la taille souhaitée */
            max-height: 300px; /* Ajustez cette valeur selon la taille souhaitée */
            margin: auto; /* Pour centrer le graphique */
        }
    </style>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('app') }}
{% endblock %}

{% block content %}
<div class="container my-5">
    <h1>Statistiques des Terrains les plus demandés</h1>

    <!-- Conteneur pour le graphique -->
    <div data-controller="chartjs">
        <canvas id="terrainChart"></canvas>
    </div>

    <!-- Script JS pour charger les données -->
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const ctx = document.getElementById('terrainChart').getContext('2d');
    
            // Les variables Twig doivent être insérées comme des chaînes JSON valides
            const labels = JSON.parse('{{ labels|json_encode|escape("js") }}');
            const data = JSON.parse('{{ data|json_encode|escape("js") }}');
    
            new Chart(ctx, {
                type: 'pie', // Changer le type de graphique en 'pie' pour un graphique circulaire
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Nombre de candidatures',
                        backgroundColor: [
                            'rgba(255, 99, 132, 0.2)',
                            'rgba(54, 162, 235, 0.2)',
                            'rgba(75, 192, 192, 0.2)',
                            'rgba(153, 102, 255, 0.2)',
                            'rgba(255, 159, 64, 0.2)',
                            'rgba(199, 199, 199, 0.2)',
                            'rgba(83, 102, 255, 0.2)',
                            'rgba(255, 99, 132, 0.2)'
                        ],
                        borderColor: [
                            'rgba(255, 99, 132, 1)',
                            'rgba(54, 162, 235, 1)',
                            'rgba(75, 192, 192, 1)',
                            'rgba(153, 102, 255, 1)',
                            'rgba(255, 159, 64, 1)',
                            'rgba(199, 199, 199, 1)',
                            'rgba(83, 102, 255, 1)',
                            'rgba(255, 99, 132, 1)'
                        ],
                        borderWidth: 1,
                        data: data,
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false, // Désactiver le maintien de l'aspect ratio pour permettre un redimensionnement personnalisé
                    plugins: {
                        legend: {
                            position: 'top',
                        },
                        tooltip: {
                            enabled: true
                        }
                    }
                }
            });
        });
    </script>
    

    <!-- Bouton de retour -->
    <a href="{{ path('app_showterrainback') }}" class="btn btn-primary mt-3">
        <i class="fas fa-arrow-left"></i> Retour à la liste
    </a>
</div>
{% endblock %}